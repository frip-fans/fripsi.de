{
  "name": "@frip-fan/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "XDG_CONFIG_HOME=../../.cache/xdg wrangler dev --persist-to ../web/.wrangler/state",
    "build": "XDG_CONFIG_HOME=../../.cache/xdg wrangler deploy --dry-run --env '' --outdir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy:staging": "XDG_CONFIG_HOME=../../.cache/xdg wrangler deploy --env staging",
    "deploy": "XDG_CONFIG_HOME=../../.cache/xdg wrangler deploy --env production"
  },
  "dependencies": {
    "@frip-fan/core": "*",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "^0.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260718.1",
    "@modelcontextprotocol/client": "2.4.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  }
}
