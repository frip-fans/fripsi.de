{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "frip-fan-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frip-fan-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  "vars": {
    "MCP_RESOURCE_URL": "https://mcp.example.com",
    "AUTOMATION_AUDIENCE": "https://mcp.example.com/mcp",
    "SITE_URL": "https://fripsi.de"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "name": "frip-fan-mcp",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "frip-fan-prod",
          "database_id": "f35ee3c1-3f65-44ed-988b-e6cbf2c187f6",
          "migrations_dir": "../../migrations"
        }
      ],
      "vars": {
        "MCP_RESOURCE_URL": "https://mcp.example.com",
        "AUTOMATION_AUDIENCE": "https://mcp.example.com/mcp",
        "SITE_URL": "https://fripsi.de",
        "MCP_AUTHORIZATION_SERVER": "https://rklee.cloudflareaccess.com"
      }
    },
    "staging": {
      "name": "frip-fan-mcp-staging",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [{
        "binding": "DB", "database_name": "frip-fan-staging",
        "database_id": "32c5a88c-bbd1-4bda-9814-b8cce16fc7c4",
        "migrations_dir": "../../migrations"
      }],
      "vars": {
        "MCP_RESOURCE_URL": "https://frip-fan-mcp-staging.rklee.workers.dev",
        "AUTOMATION_AUDIENCE": "https://frip-fan-mcp-staging.rklee.workers.dev/mcp",
        "SITE_URL": "https://frip-fan-web-staging.rklee.workers.dev",
        "DEV_AUTH_BYPASS": "false"
      }
    }
  }
}
