# Copy to apps/web/.env.local for `npm run dev:web`. Values here are for local development only.
DEV_AUTH_BYPASS=true
DEV_ACTOR=local-editor@example.com
ADMIN_PUBLISHERS=local-editor@example.com
SITE_URL=http://localhost:4321
# Local SQLite database and cover directory (defaults shown; created by `npm run db:migrate:local`).
# FRIP_DB_PATH=.cache/self-hosted/site.sqlite
# FRIP_MEDIA_DIR=.cache/self-hosted/media
# Only needed to exercise MCP OAuth locally:
# MCP_RESOURCE_URL=http://localhost:4321
# MCP_AUTHORIZATION_SERVER=https://your-team.cloudflareaccess.com
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# MCP_AUDIENCE=replace-with-mcp-access-aud
# AUTOMATION_AUDIENCE=http://localhost:4321/mcp
# AUTOMATION_SIGNING_SECRET=
# Only needed to exercise the admin chat assistant locally (real OpenAI calls, real cost):
# CHAT_ENABLED=true
# MCP_ENDPOINT_URL=https://your-public-staging-host/mcp
# OPENAI_API_KEY=
