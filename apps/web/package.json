{
  "name": "@frip-fan/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 APP_ENV=${APP_ENV:-development} node --env-file-if-exists=.env.local ../../node_modules/astro/bin/astro.mjs dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "node --env-file-if-exists=.env.local ../../node_modules/astro/bin/astro.mjs preview",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "@astrojs/node": "11.1.11",
    "@frip-fan/core": "*",
    "@frip-fan/mcp": "*",
    "@frip-fan/node-runtime": "*",
    "astro": "^7.4.7",
    "bootstrap-icons": "^1.13.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.16.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@types/leaflet": "^1.9.22"
  },
  "imports": {
    "#runtime-env": "./src/lib/env-node.ts",
    "#runtime-mcp": "./src/lib/mcp-node.ts",
    "#public-cache": "./src/lib/public-cache-node.ts"
  }
}
