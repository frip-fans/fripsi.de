---
import Icon from "./Icon.astro";
interface Props { href: string; label: string; hidden?: boolean; eventReturn?: boolean; agendaReturn?: boolean }
const { href, label, hidden = false, eventReturn = false, agendaReturn = false } = Astro.props;
---
<a class="back-link" href={href} hidden={hidden} data-event-return={eventReturn || undefined} data-agenda-return={agendaReturn || undefined}>
  <Icon name="chevron-left" /><span>{label}</span>
</a>
<style>
  .back-link { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; margin: -.5rem 0 .5rem; color: var(--muted); text-decoration: none; font-size: .875rem; border-radius: 4px; touch-action: manipulation; }
  .back-link[hidden] { display: none !important; }
  .back-link:hover { color: var(--accent); }
  .back-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
</style>
