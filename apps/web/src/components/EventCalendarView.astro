---
import { dateInTimeZone, searchEvents, type EventRecord } from "@frip-fan/core";
import CalendarMonthGrid from "./CalendarMonthGrid.astro";
import EventCard from "./EventCard.astro";
import Icon from "./Icon.astro";
import { categoryLabels, monthBounds, parseMonth, shiftMonth } from "../lib/format";
import { getEnv } from "../lib/env";
import { calendarAgendaHref } from "../lib/calendar-navigation";
import { formatMonthLabel, formatMonthOption, formatYearLabel, getLocale, t } from "../lib/i18n";

const env = getEnv();
const locale = getLocale(Astro.request);
const today = dateInTimeZone();
const month = parseMonth(Astro.url.searchParams.get("month"), today);
const selectedCategories = [...new Set(Astro.url.searchParams.getAll("category"))]
  .filter((value): value is EventRecord["category"] => ["LIVE", "EVENT", "RELEASE", "MEDIA", "OTHER"].includes(value));
const { from, to, days, offset } = monthBounds(month);
const categories = selectedCategories.length ? selectedCategories : undefined;
const events = await searchEvents(env.DB, { date_from: from, date_to: to, categories, limit: 100 }, true);
const eventRange = await env.DB.prepare(`
  SELECT substr(MIN(start_date), 1, 7) AS first_month,
         substr(MAX(start_date), 1, 7) AS last_month
  FROM events WHERE published = 1 AND archived_at IS NULL
`).first<{ first_month: string | null; last_month: string | null }>();
const byDay = new Map<number, EventRecord[]>();
for (let day = 1; day <= days; day++) {
  const date = `${month}-${String(day).padStart(2, "0")}`;
  byDay.set(day, events.filter((event) => event.start_date <= date && (event.end_date ?? event.start_date) >= date));
}
const groups = [...byDay].filter(([, items]) => items.length).map(([day, items]) => ({
  date: `${month}-${String(day).padStart(2, "0")}`, events: items,
}));
const dayLabel = (date: string) => new Intl.DateTimeFormat(locale, { month: "long", day: "numeric", weekday: "short", timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`));
const monthLabel = formatMonthLabel(locale, month);
const monthHref = (target: string, category?: string | null): string => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set("month", target);
  if (target !== month) params.delete("calendar");
  if (category !== undefined) {
    params.delete("category");
    if (category) params.set("category", category);
  }
  return calendarAgendaHref(params, today.slice(0, 7));
};
const selectedYear = Number(month.slice(0, 4));
const todayYear = Number(today.slice(0, 4));
const firstPickerYear = Math.max(1900, Math.min(Number(eventRange?.first_month?.slice(0, 4) ?? todayYear), selectedYear, 2002));
const lastPickerYear = Math.min(2100, Math.max(Number(eventRange?.last_month?.slice(0, 4) ?? todayYear), selectedYear, todayYear + 3));
const pickerYears = Array.from({ length: lastPickerYear - firstPickerYear + 1 }, (_, index) => firstPickerYear + index);
const calendarExpanded = Astro.url.searchParams.get("calendar") === "1";
const gridProps = { month, monthLabel, today, locale, days, offset, byDay };
---
<section data-event-calendar-view>
  <div class="calendar-surface">
    <header class="page-head">
      <h2 class="visually-hidden">{monthLabel}</h2>
      <div class="page-actions">
        <a class="month-step" href={monthHref(shiftMonth(month, -1))} aria-label={t(locale, "calendar.previousMonth")}><Icon name="chevron-left" /></a>
        <details class="month-picker" data-month-picker data-selected-month={month} data-today-month={today.slice(0, 7)} data-search-params={Astro.url.searchParams.toString()}>
          <summary aria-label={`${monthLabel} · ${t(locale, "calendar.openPicker")}`}>
            <span>{monthLabel}</span><Icon name="chevron-down" class="picker-caret" />
          </summary>
          <div class="month-picker-panel">
            <label class="year-select-wrap">
              <span>{t(locale, "calendar.selectYear")}</span>
              <select name="picker-year" data-picker-year>
                {pickerYears.map((year) => <option value={year} selected={year === selectedYear}>{formatYearLabel(locale, year)}</option>)}
              </select>
            </label>
            <nav class="month-grid" aria-label={t(locale, "calendar.selectMonth")}>
              {Array.from({ length: 12 }, (_, index) => {
                const value = `${selectedYear}-${String(index + 1).padStart(2, "0")}`;
                return <a class:list={["month-option", { active: value === month, current: value === today.slice(0, 7) }]} href={monthHref(value)} data-picker-month={index + 1} aria-current={value === month ? "date" : undefined}>{formatMonthOption(locale, index + 1)}</a>;
              })}
            </nav>
          </div>
        </details>
        <a class="month-step" href={monthHref(shiftMonth(month, 1))} aria-label={t(locale, "calendar.nextMonth")}><Icon name="chevron-right" /></a>
        {month !== today.slice(0, 7) && <a class="this-month" href={monthHref(today.slice(0, 7))}>{t(locale, "calendar.thisMonth")}</a>}
      </div>
    </header>
    <nav class="filters desktop-calendar" aria-label={t(locale, "calendar.categoryFilter")}>
      <a class:list={{ active: !selectedCategories.length }} aria-current={!selectedCategories.length ? "true" : undefined} href={monthHref(month, null)}>{t(locale, "common.all")}</a>
      {Object.entries(categoryLabels).map(([value, label]) => <a class:list={{ active: selectedCategories.includes(value as EventRecord["category"]) }} aria-current={selectedCategories.includes(value as EventRecord["category"]) ? "true" : undefined} href={monthHref(month, value)}>{label}</a>)}
    </nav>
    <div class="mobile-controls">
      <details class="category-picker" data-category-picker>
        <summary><Icon name="funnel" /><span>{selectedCategories.length ? t(locale, "calendar.selectedTypes", { count: selectedCategories.length }) : t(locale, "calendar.allTypes")}</span><Icon name="chevron-down" /></summary>
        <form class="category-panel" action="/calendar" method="get">
          <input type="hidden" name="view" value="calendar" />
          <input type="hidden" name="month" value={month} />
          <input type="hidden" name="lang" value={locale} />
          <input type="hidden" name="calendar" value={calendarExpanded ? "1" : "0"} />
          <fieldset>
            <legend>{t(locale, "calendar.categoryFilter")}</legend>
            {Object.entries(categoryLabels).map(([value, label]) => <label><input type="checkbox" name="category" value={value} checked={selectedCategories.includes(value as EventRecord["category"])} /><span>{label}</span></label>)}
          </fieldset>
          <div class="category-actions"><a href={monthHref(month, null)}>{t(locale, "archive.clear")}</a><button type="submit">{t(locale, "calendar.applyFilters")}</button></div>
        </form>
      </details>
      <span class="visually-hidden" aria-live="polite">{t(locale, "calendar.dayCount", { count: new Intl.NumberFormat(locale).format(events.length) })}</span>
    </div>
    <div class="desktop-calendar"><CalendarMonthGrid {...gridProps} /></div>
    <details class="mobile-overview" data-calendar-overview open={calendarExpanded}>
      <summary><Icon name="calendar3" /><span data-overview-label data-open-label={t(locale, "calendar.hideMonth")} data-closed-label={t(locale, "calendar.showMonth")}>{t(locale, calendarExpanded ? "calendar.hideMonth" : "calendar.showMonth")}</span><Icon name="chevron-down" class="overview-caret" /></summary>
      <CalendarMonthGrid {...gridProps} compact />
    </details>
  </div>
  <section class="mobile-timeline" aria-label={t(locale, "calendar.monthCount", { count: new Intl.NumberFormat(locale).format(events.length) })}>
    {selectedCategories.length > 0 && <p class="filter-summary" aria-live="polite">{selectedCategories.map((value) => categoryLabels[value]).join(" / ")} · {t(locale, "calendar.dayCount", { count: new Intl.NumberFormat(locale).format(events.length) })}</p>}
    {groups.map(({ date, events: dayEvents }) => (
      <section class="day-agenda" aria-labelledby={`agenda-${date}`}>
        <h2 id={`agenda-${date}`} tabindex="-1" class:list={["day-heading", { "is-today": date === today }]}>
          <time datetime={date}>{dayLabel(date)}</time>{date === today && <span>{t(locale, "common.today")}</span>}
        </h2>
        <div class="stack">{dayEvents.map((event) => <EventCard event={event} compact dateInGroup />)}</div>
      </section>
    ))}
    {!events.length && <div class="month-empty"><Icon name="calendar3" /><p>{t(locale, selectedCategories.length ? "calendar.noMatches" : "calendar.empty")}</p>{selectedCategories.length > 0 && <a href={monthHref(month, null)}>{t(locale, "calendar.clearFilters")}</a>}</div>}
    <a class="next-month" href={monthHref(shiftMonth(month, 1))}>{t(locale, "calendar.viewNextMonth")}<Icon name="chevron-right" /></a>
  </section>
</section>



<style>
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .page-actions { display: flex; align-items: center; gap: .5rem; }
  .month-picker, .category-picker { position: relative; }
  summary { cursor: pointer; list-style: none; touch-action: manipulation; }
  summary::-webkit-details-marker { display: none; }
  .month-picker summary { display: flex; align-items: center; justify-content: center; gap: .55rem; min-width: 10.5rem; min-height: 44px; padding: 0 .8rem; color: var(--text); background: rgba(7,16,28,.82); border: 1px solid var(--line); border-radius: 10px; font-size: .9375rem; font-weight: 650; }
  .month-picker summary:hover, .month-step:hover, .this-month:hover { color: var(--accent); border-color: rgba(var(--accent-rgb), .5); background: rgba(var(--accent-rgb), .08); }
  .month-picker-panel, .category-panel { position: absolute; z-index: 20; top: calc(100% + .5rem); left: 0; width: 19rem; max-width: calc(100vw - 3.5rem); padding: 1rem; background: #0b1728; border: 1px solid rgba(var(--accent-rgb), .3); border-radius: 16px; box-shadow: 0 24px 70px rgba(0,0,0,.45); }
  .year-select-wrap { display: grid; gap: .5rem; }
  .year-select-wrap select { min-height: 44px; color: var(--text); background: #07101c; font-weight: 750; }
  .month-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .4rem; margin-top: .75rem; }
  .month-option { display: grid; min-height: 44px; place-items: center; color: var(--muted); border: 1px solid transparent; border-radius: 9px; text-decoration: none; font-size: .8125rem; touch-action: manipulation; }
  .month-option:hover { color: var(--text); border-color: var(--line); background: rgba(255,255,255,.045); }
  .month-option.current { text-decoration: underline; text-underline-offset: .3em; }
  .month-option.active { color: #07101c; background: var(--accent); font-weight: 800; }
  .month-step, .this-month { display: grid; place-items: center; min-width: 44px; min-height: 44px; border: 1px solid var(--line); border-radius: 10px; text-decoration: none; color: var(--text); touch-action: manipulation; }
  .month-step { color: var(--accent); }
  .this-month { padding: 0 .75rem; margin-left: auto; font-size: .8125rem; white-space: nowrap; }
  .filters { display: flex; flex-wrap: wrap; gap: .25rem; margin: .75rem 0; }
  .filters a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: .5rem .75rem; color: var(--muted); border: 1px solid transparent; border-radius: 999px; text-decoration: none; font-size: .8125rem; }
  .filters a:hover { color: var(--text); background: rgba(255,255,255,.06); }
  .filters a.active { color: var(--accent); border-color: rgba(var(--accent-rgb), .4); background: rgba(var(--accent-rgb), .1); }
  .mobile-controls, .mobile-overview, .mobile-timeline { display: none; }
  @media (max-width: 800px) {
    .desktop-calendar { display: none; }
    .calendar-surface { padding: .75rem; background: rgba(7,16,28,.92); border: 1px solid var(--line); border-radius: var(--radius); }
    .page-actions { display: grid; grid-template-columns: 44px minmax(0, 1fr) 44px; gap: .375rem; }
    .month-picker { min-width: 0; }
    .month-picker summary { min-width: 0; padding: 0 .4rem; background: transparent; }
    .month-picker-panel { left: calc(-44px - .375rem); }
    .this-month { grid-column: 1 / -1; justify-self: end; border-color: transparent; }
    .mobile-controls { display: flex; align-items: center; gap: .5rem; margin-top: .25rem; padding-right: 9rem; }
    .category-picker summary { display: flex; align-items: center; gap: .4rem; min-height: 44px; padding: 0 .5rem; color: var(--text); font-size: .8125rem; }
    .category-picker summary:hover, .mobile-overview > summary:hover { color: var(--accent); }

    .category-panel { width: min(19rem, calc(100vw - 3.5rem)); }
    fieldset { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .25rem .5rem; margin: 0; padding: .5rem 0; border: 0; }
    legend { color: var(--muted); font-size: .8125rem; }
    fieldset label { display: flex; align-items: center; gap: .5rem; min-height: 44px; cursor: pointer; color: var(--text); }
    fieldset input { width: 18px; height: 18px; margin: 0; accent-color: var(--accent); }
    .category-actions { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-top: .5rem; padding-top: .75rem; border-top: 1px solid var(--line); }
    .category-actions a { display: inline-flex; align-items: center; min-height: 44px; padding: .25rem; color: var(--muted); font-size: .8125rem; }
    .category-actions a:hover { color: var(--text); }
    .category-actions button { min-height: 44px; font-size: .8125rem; }
    .mobile-overview { display: block; }
    .mobile-overview > summary { display: flex; align-items: center; justify-content: flex-end; width: max-content; max-width: 9rem; margin: -44px 0 0 auto; gap: .4rem; min-height: 44px; color: var(--muted); font-size: .8125rem; }
    .mobile-overview[open] .overview-caret { transform: rotate(180deg); }
    .mobile-timeline { display: grid; gap: 1.5rem; margin-top: 1.25rem; }
    .filter-summary { margin: 0; color: var(--muted); font-size: .8125rem; }
    .day-heading { display: flex; align-items: baseline; gap: .65rem; margin: 0 .15rem .75rem; font-size: 1rem; scroll-margin-top: 1rem; }
    .day-heading > span { color: var(--accent); font-size: .75rem; }
    .day-heading:target { color: var(--accent); }
    .day-heading:focus { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 4px; }
    .month-empty { display: grid; justify-items: start; gap: .75rem; padding: 1.25rem 1rem; background: rgba(7,16,28,.9); border: 1px solid var(--line); border-radius: var(--radius); color: var(--muted); }
    .month-empty p { margin: 0; font-size: .875rem; line-height: 1.6; }
    .month-empty a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); }
    .month-empty a:hover { color: var(--text); }
    .next-month { display: flex; align-items: center; justify-content: center; gap: .5rem; min-height: 48px; color: var(--text); border: 1px solid var(--line); border-radius: 10px; text-decoration: none; font-size: .875rem; }
    .next-month:hover { color: var(--accent); background: rgba(var(--accent-rgb), .08); }
  }
</style>
