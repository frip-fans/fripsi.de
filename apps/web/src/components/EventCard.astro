---
import { eventDetailHref } from "../lib/event-navigation";
import type { EventSummary } from "@frip-fan/core";
import { categoryLabels, displayEventStatus, formatDate, formatTime, statusLabel } from "../lib/format";
import { getLocale } from "../lib/i18n";
import Icon from "./Icon.astro";

interface Props { event: EventSummary; compact?: boolean; timeInHeader?: boolean; dateInGroup?: boolean; updateLabel?: string | null }
const { event, compact = false, timeInHeader = false, dateInGroup = false, updateLabel = null } = Astro.props;
const locale = getLocale(Astro.request);
const displayStatus = displayEventStatus(event);
const singleDay = !event.end_date || event.end_date === event.start_date;
---
<article class:list={["event-card", { compact, "time-in-header": timeInHeader, "date-in-group": dateInGroup, "single-day": singleDay, dimmed: displayStatus === "completed" }]}>
  <div class="event-date">
    <span class="event-year">{event.start_date.slice(0, 4)}</span>
    <strong>{event.start_date.slice(5).replace("-", ".")}</strong>
    {timeInHeader && <span class="event-header-time">{formatTime(event, locale)}</span>}
  </div>
  <div class="event-main">
    <div class="meta">
      <span class:list={["tag", event.category.toLowerCase()]}>{categoryLabels[event.category]}</span>
      {displayStatus !== "scheduled" && <span class:list={["tag", displayStatus]}>{statusLabel(locale, displayStatus)}</span>}
      {event.classification && <span class="tag">{event.classification}</span>}
      {updateLabel && <span class="tag update">{updateLabel}</span>}
    </div>
    <h3><a href={eventDetailHref(event.slug, Astro.url, locale)} data-astro-prefetch="tap" title={event.display_title && event.display_title !== event.title ? event.title : undefined}>{event.display_title ?? event.title}</a></h3>
    <div class="event-details">
      <div class="event-detail-text">
        <p class="event-time"><span class="event-day">{formatDate(event.start_date, event.end_date, locale)} · </span>{formatTime(event, locale)}</p>
        {event.location_label && <p class="venue">{event.location_label}</p>}
      </div>
      <span class="arrow" aria-hidden="true"><Icon name="chevron-right" size=".85rem" /></span>
    </div>
  </div>
</article>

<style>
  .event-card { position: relative; }
  .event-card:has(h3 a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 4px; }
  h3 a:focus-visible { outline: none; }
  h3 a::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .event-card { display: grid; grid-template-columns: 74px minmax(0, 1fr); gap: 1rem; align-items: start; padding: 1.25rem; border: 1px solid var(--line); border-radius: var(--radius); background: linear-gradient(135deg, rgba(15,31,51,.86), rgba(10,21,36,.7)); transition: border-color .18s, transform .18s; }
  .event-date { display: grid; align-content: start; text-align: right; border-right: 1px solid var(--line); padding-right: 1rem; }
  .event-year { color: var(--event-year-color, var(--muted)); font-size: .7rem; font-weight: 400; letter-spacing: .12em; }
  .event-date strong { color: var(--accent); font-size: 1.32rem; letter-spacing: -.04em; }
  .meta { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: .7rem; }
  .tag.update { color: var(--accent); border-color: rgba(var(--accent-rgb), .5); background: rgba(var(--accent-rgb), .1); }
  h3 { margin: 0 0 .5rem; color: var(--event-title-color, inherit); font-size: var(--event-title-size, 1.08rem); font-weight: var(--event-title-weight, 700); line-height: var(--event-title-line-height, 1.45); }
  h3 a { text-decoration: none; }
  p { margin: 0; color: var(--event-time-color, var(--muted)); font-size: .82rem; line-height: 1.55; }
  .venue { color: var(--event-venue-color, #c8d9e7); margin-top: .25rem; }
  .event-details { display: flex; align-items: center; gap: .65rem; padding-top: .75rem; border-top: 1px solid var(--line); }
  .event-detail-text { flex: 1; min-width: 0; }
  .arrow { align-self: center; display: inline-flex; color: var(--muted); opacity: .55; pointer-events: none; }
  .event-card:focus-within .arrow { color: var(--accent); opacity: 1; }
  .event-card:active { border-color: rgba(var(--accent-rgb), .5); }
  .dimmed { opacity: .72; }
  .event-main { min-width: 0; overflow-wrap: anywhere; }
  :global(body:has(.archive-head)) .event-card { padding: 1rem; background: rgba(10,21,36,.94); border-radius: 14px; }
  @media (hover: hover) and (pointer: fine) {
    .event-card:hover { transform: translateY(-2px); border-color: rgba(var(--accent-rgb), .3); }
    h3 a:hover { color: var(--accent); }
    .event-card:hover .arrow { color: var(--accent); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .event-card { transition: none; } .event-card:hover { transform: none; } }
  .event-card.date-in-group { grid-template-columns: minmax(0, 1fr); gap: 0; }
  .date-in-group .event-date { display: none; }
  .date-in-group .event-main { display: block; }
  .date-in-group .meta { justify-content: flex-start; margin-bottom: .5rem; }
  .date-in-group h3 { margin: 0 0 .75rem; }
  .event-header-time { color: var(--event-time-color, var(--muted)); font-size: .8125rem; font-weight: 400; line-height: 1.4; white-space: nowrap; }
  .time-in-header { grid-template-columns: minmax(0, 1fr) auto; gap: 0 .75rem; }
  .time-in-header .event-main { display: contents; }
  .time-in-header .event-date { grid-column: 1; grid-row: 1; display: flex; flex-wrap: wrap; align-items: baseline; gap: .35rem; align-self: center; min-width: 0; padding-right: 0; border-right: 0; text-align: left; }
  .time-in-header .event-date strong { order: -1; }
  .time-in-header .event-year { display: inline-flex; align-items: center; gap: .5rem; }
  .time-in-header .event-year::after { content: ""; width: 1px; height: 1em; background: var(--line); }
  .time-in-header .meta { grid-column: 2; grid-row: 1; align-self: center; justify-content: flex-end; min-width: 0; margin: 0; }
  .time-in-header h3, .time-in-header .event-details { grid-column: 1 / -1; min-width: 0; }
  .time-in-header h3 { margin: .65rem 0 .75rem; }
  .time-in-header.single-day .event-time { display: none; }
  .time-in-header:not(.single-day) .event-time .event-day { display: inline; }
  .compact { grid-template-columns: 62px minmax(0, 1fr); padding: 1rem; }
  @media (max-width: 560px) {
    .event-card { grid-template-columns: auto minmax(0, 1fr); gap: 0 .75rem; padding: 1rem; }
    .event-main { display: contents; }
    .single-day .event-day { display: none; }
    .event-details { grid-column: 1 / -1; min-width: 0; }
    .event-detail-text { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: .65rem; row-gap: .15rem; }
    .venue { margin-top: 0; }
    .event-date { grid-column: 1; grid-row: 1; display: flex; align-items: baseline; gap: .35rem; align-self: center; padding-right: 0; border-right: 0; text-align: left; }
    .event-date strong { order: -1; font-size: 1.125rem; line-height: 1.2; }
    .event-year { display: inline-flex; align-items: center; gap: .75rem; font-size: .6875rem; line-height: 1.2; letter-spacing: .06em; }
    .event-year::after { content: ""; width: 1px; height: 1em; background: var(--line); }
    .meta { grid-column: 2; grid-row: 1; align-self: center; justify-content: flex-end; min-width: 0; margin-bottom: 0; }
    h3, p { grid-column: 1 / -1; min-width: 0; overflow-wrap: anywhere; }
    h3 { margin: .65rem 0 .75rem; font-size: var(--event-title-size, 1rem); }
  }
</style>
