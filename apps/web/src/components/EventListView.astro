---
import { parsePublicEventSearch } from "@frip-fan/core";
import EventSearchResults from "./EventSearchResults.astro";
import Icon from "./Icon.astro";
import { publicEventFilters } from "../lib/event-search";
import { getEnv } from "../lib/env";
import { getLocale, t } from "../lib/i18n";
const locale = getLocale(Astro.request);
const filters = await publicEventFilters(getEnv().DB);
const { query, sort, year, categories: selectedCategories, locations: selectedLocations } = parsePublicEventSearch(Astro.url.searchParams);
const categoryOptions = ["LIVE", "EVENT", "RELEASE", "MEDIA", "OTHER"].map(value => ({
  value, label: value === "LIVE" ? "Live" : value[0] + value.slice(1).toLowerCase(),
  count: filters.categories.find(item => item.category === value)?.count ?? 0,
}));
const locationOptions = filters.locations.map(area => ({
  value: area.key, count: area.count,
  label: (locale === "en" ? area.name_en : locale === "ja" ? area.name_ja : area.name_zh) ?? area.name_local,
})).sort((a, b) => a.label.localeCompare(b.label, locale));
const japaneseLocationOptions = locationOptions.filter(item => item.value.startsWith("jp:"));
const overseasLocationOptions = locationOptions.filter(item => item.value.startsWith("country:"));
---
<section class="archive-head" data-event-list-view data-locale={locale} data-loading={t(locale, "search.loading")}>
  <p class="search-error" role="alert" data-search-error hidden>{t(locale, "search.error")} <button type="button" class="clear-control" data-search-retry>{t(locale, "search.retry")}</button></p>

    <form class="list-toolbar" method="get" action="/calendar" data-archive-filter-form>
      <input type="hidden" name="view" value="list" />
      {Astro.url.searchParams.has("month") && <input type="hidden" name="month" value={Astro.url.searchParams.get("month")!} />}
      {Astro.url.searchParams.has("lang") && <input type="hidden" name="lang" value={locale} />}
      <label class="event-search">
        <span class="visually-hidden">{t(locale, "archive.searchLabel")}</span>
        <Icon name="search" />
        <input type="search" name="q" value={query} placeholder={t(locale, "archive.searchPlaceholder")} autocomplete="off" data-event-search-input maxlength="200" />
      </label>
      <div class="list-control-row">
        <div class="list-controls">
          <div class="control-popover" data-control-popover>
            <button
              type="button"
              class="control-button"
              aria-expanded="false"
              aria-controls="event-filter-panel"
              data-filter-toggle
            >
              <Icon name="funnel" />
              <span>{t(locale, "common.filter")}</span>
              <span class="active-filter-count" data-filter-count hidden>0</span>
            </button>
            <div class="control-card filter-card" id="event-filter-panel" data-filter-panel hidden>
              <div class="control-card-head">
                <div><strong>{t(locale, "archive.activityType")}</strong><span>{t(locale, "archive.multiple")}</span></div>
                <button type="button" class="panel-close" data-panel-close="filter" aria-label={t(locale, "search.closeFilters")}><Icon name="x-lg" /></button>
              </div>
              <label class="year-filter">{t(locale, "calendar.selectYear")}
                <select name="year" data-year-filter>
                  <option value="">{t(locale, "search.allYears")}</option>
                  {year && !filters.years.some(item => item.year === year) && <option value={year} selected>{year}</option>}
                  {filters.years.map(item => <option value={item.year} selected={item.year === year}>{item.year} · {item.count}</option>)}
                </select>
              </label>
              <div class="filter-options">
                {categoryOptions.map((option) => (
                  <label class:list={["filter-choice", { disabled: option.count === 0 }]}>
                    <input
                      type="checkbox"
                      name="category"
                      value={option.value}
                      data-category-filter
                      disabled={option.count === 0}
                      checked={selectedCategories.includes(option.value)}
                    />
                    <span class="filter-pill"><span>{option.label}</span><small>{option.count}</small></span>
                  </label>
                ))}
              </div>
              {(japaneseLocationOptions.length > 0 || overseasLocationOptions.length > 0) && (
                <div class="location-filter-section">
                  <div class="filter-section-head"><strong>{t(locale, "archive.location")}</strong><span>{t(locale, "archive.multiple")}</span></div>
                  {japaneseLocationOptions.length > 0 && (
                    <details class="location-filter-group japan-filter" open={selectedLocations.some((value) => value.startsWith("jp:"))} data-japan-filter>
                      <summary><span>{t(locale, "archive.japanPrefectures")}</span><span class="japan-selected" data-japan-selected data-template={t(locale, "archive.selectedCount", { count: "{count}" })} hidden={!selectedLocations.some((value) => value.startsWith("jp:"))}>{t(locale, "archive.selectedCount", { count: selectedLocations.filter((value) => value.startsWith("jp:")).length })}</span><Icon name="chevron-down" /></summary>
                      <div class="filter-options location-options">
                        {japaneseLocationOptions.map((option) => (
                          <label class="filter-choice">
                            <input type="checkbox" name="location" value={option.value} data-location-filter checked={selectedLocations.includes(option.value)} />
                            <span class="filter-pill"><span>{option.label}</span><small>{option.count}</small></span>
                          </label>
                        ))}
                      </div>
                    </details>
                  )}
                  {overseasLocationOptions.length > 0 && (
                    <div class="location-filter-group">
                      <span class="filter-group-label">{t(locale, "archive.overseasCountries")}</span>
                      <div class="filter-options location-options">
                        {overseasLocationOptions.map((option) => (
                          <label class="filter-choice">
                            <input type="checkbox" name="location" value={option.value} data-location-filter checked={selectedLocations.includes(option.value)} />
                            <span class="filter-pill"><span>{option.label}</span><small>{option.count}</small></span>
                          </label>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              )}
              <div class="control-card-actions">
                <button type="button" class="clear-control" data-filter-clear disabled>{t(locale, "archive.clear")}</button>
                <button type="submit" class="done-control" data-filter-done>{t(locale, "archive.done")}</button>
              </div>
            </div>
          </div>

          <div class="control-popover" data-control-popover>
            <button
              type="button"
              class="control-button"
              aria-expanded="false"
              aria-controls="event-sort-panel"
              data-sort-toggle
            >
              <Icon name="arrow-down-up" />
              <span>{t(locale, "archive.sort")}</span>
              <span class="control-value" data-sort-button-label>{t(locale, sort === "desc" ? "archive.sortDesc" : "archive.sortAsc")}</span>
            </button>
            <div class="control-card sort-card" id="event-sort-panel" data-sort-panel hidden>
              <div class="control-card-head">
                <div><strong>{t(locale, "archive.sortTitle")}</strong><span>{t(locale, "archive.sortHelp")}</span></div>
                <button type="button" class="panel-close" data-panel-close="sort" aria-label={t(locale, "search.closeSort")}><Icon name="x-lg" /></button>
              </div>
              <div class="sort-options">
                <label class="sort-choice">
                  <input type="radio" name="sort" value="asc" data-sort-option data-sort-label={t(locale, "archive.sortAsc")} checked={sort === "asc"} />
                  <span><strong>{t(locale, "archive.sortAsc")}</strong><small>{t(locale, "archive.sortAscHelp")}</small></span>
                </label>
                <label class="sort-choice">
                  <input type="radio" name="sort" value="desc" data-sort-option data-sort-label={t(locale, "archive.sortDesc")} checked={sort === "desc"} />
                  <span><strong>{t(locale, "archive.sortDesc")}</strong><small>{t(locale, "archive.sortDescHelp")}</small></span>
                </label>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  <EventSearchResults />
</section>
<style>
  [hidden] { display: none !important; }
  .year-filter { display: grid; gap: .5rem; margin-bottom: 1rem; font-size: .875rem; }
  .search-error { color: var(--text); }
  .list-toolbar { position: sticky; top: 0; z-index: 20; display: grid; gap: .75rem; margin: 0 0 1.25rem; padding: calc(.75rem + var(--safe-area-top, 0px)) 0 .75rem; background: #07101c; border-bottom: 1px solid var(--line); }
  :global([data-event-item] a) { scroll-margin-block-start: calc(9rem + var(--safe-area-top, 0px)); }
  .event-search { position: relative; display: flex; align-items: center; width: 100%; color: var(--muted); }
  .event-search :global(.icon) { position: absolute; left: .9rem; pointer-events: none; }
  .event-search input { height: 46px; padding-left: 2.65rem; background: rgba(7,16,28,.74); border-color: var(--line); }
  .list-control-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 38px; }
  .list-controls { display: flex; align-items: center; gap: .55rem; }
  .control-popover { position: relative; }
  .control-button { min-height: 38px; padding: .5rem .75rem; color: #dce8f2; background: rgba(8,18,31,.78); border: 1px solid var(--line); border-radius: 10px; font-size: .78rem; font-weight: 680; box-shadow: 0 8px 24px rgba(0,0,0,.12); backdrop-filter: blur(16px); }
  .control-button[aria-expanded="true"] { color: var(--text); border-color: rgba(var(--accent-rgb),.38); background: rgba(16,29,46,.92); }
  .control-button.active { color: var(--accent); border-color: rgba(var(--accent-rgb),.38); }
  .control-value { color: var(--muted); font-weight: 540; padding-left: .25rem; border-left: 1px solid var(--line); }
  .active-filter-count { display: inline-grid; place-items: center; min-width: 1.25rem; height: 1.25rem; padding: 0 .28rem; color: #07101c; background: var(--accent); border-radius: 999px; font-size: .66rem; font-weight: 850; }
  .active-filter-count[hidden] { display: none; }
  .control-card { position: absolute; z-index: 30; min-width: 0; overflow-x: hidden; top: calc(100% + .65rem); left: 0; width: min(20rem, calc(100vw - 2rem)); padding: 1rem; background: linear-gradient(145deg, rgba(15,30,49,.98), rgba(7,16,28,.98)); border: 1px solid rgba(var(--accent-rgb),.28); border-radius: 16px; box-shadow: 0 24px 70px rgba(0,0,0,.5); backdrop-filter: blur(24px); }
  .control-card[hidden] { display: none; }
  .filter-card { width: min(38rem, calc(100vw - 2rem)); max-height: min(75vh, 48rem); overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; }
  .control-card-head { display: flex; align-items: start; justify-content: space-between; gap: 1rem; padding: .15rem .15rem .85rem; border-bottom: 1px solid var(--line); }
  .control-card-head div { display: grid; flex: 1; min-width: 0; gap: .2rem; overflow-wrap: anywhere; }
  .control-card-head strong { font-size: .92rem; }
  .control-card-head span { color: var(--muted); font-size: .7rem; }
  .panel-close { display: inline-flex; flex: 0 0 44px; align-items: center; justify-content: center; width: 44px; height: 44px; margin: -.65rem -.65rem 0 0; padding: 0; color: var(--muted); background: transparent; border: 1px solid transparent; border-radius: 8px; }
  .panel-close:hover { color: var(--text); background: rgba(255,255,255,.06); border-color: var(--line); }
  .panel-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .location-filter-section { padding-top: .9rem; border-top: 1px solid var(--line); }
  .filter-section-head { display: grid; gap: .2rem; }
  .filter-section-head strong { font-size: .92rem; }
  .filter-section-head span, .filter-group-label { color: var(--muted); font-size: .7rem; }
  .japan-filter summary { display: flex; align-items: center; gap: .65rem; min-height: 40px; cursor: pointer; color: var(--muted); font-size: .78rem; list-style: none; }
  .japan-filter summary::-webkit-details-marker { display: none; }
  .japan-filter summary :global(.icon) { margin-left: auto; transition: transform .16s; }
  .japan-filter[open] summary :global(.icon) { transform: rotate(180deg); }
  .japan-filter summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  .japan-selected { color: var(--accent); font-size: .7rem; }
  .japan-selected[hidden] { display: none; }
  .location-filter-group { margin-top: .9rem; }
  .location-options { grid-template-columns: repeat(3, minmax(0, 1fr)); padding: .45rem 0 0; }
  .filter-options { display: grid; min-width: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; padding: .9rem 0; }
  .filter-choice { position: relative; display: block; min-width: 0; cursor: pointer; }
  .filter-choice input, .sort-choice input { position: absolute; width: 1px; height: 1px; margin: 0; padding: 0; border: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .filter-pill { display: flex; min-width: 0; align-items: center; justify-content: space-between; min-height: 40px; padding: .55rem .7rem; color: var(--muted); background: rgba(255,255,255,.025); border: 1px solid var(--line); border-radius: 10px; transition: color .16s, border-color .16s, background .16s; }
  .filter-pill > span { min-width: 0; overflow-wrap: anywhere; font-size: .78rem; font-weight: 680; }
  .filter-pill small { min-width: 1.45rem; text-align: center; color: var(--muted); font-size: .65rem; }
  .filter-choice input:focus-visible + .filter-pill { box-shadow: 0 0 0 3px rgba(var(--accent-rgb),.1); }
  .filter-choice input:checked + .filter-pill { color: var(--accent); border-color: rgba(var(--accent-rgb),.55); background: rgba(var(--accent-rgb),.09); box-shadow: inset 0 -1px rgba(var(--accent-rgb),.22); }
  .filter-choice.disabled { opacity: .35; cursor: not-allowed; }
  .control-card-actions { display: flex; align-items: center; justify-content: space-between; gap: .6rem; padding-top: .85rem; border-top: 1px solid var(--line); }
  .control-card-actions button { min-height: 34px; padding: .42rem .7rem; font-size: .7rem; }
  .clear-control { color: var(--muted); background: transparent; border: 1px solid transparent; }
  .clear-control:disabled { opacity: .35; cursor: not-allowed; }
  .done-control { color: #07101c; background: var(--accent); }
  .sort-card { width: min(17rem, calc(100vw - 2rem)); }
  .sort-options { display: grid; gap: .45rem; padding-top: .85rem; }
  .sort-choice { position: relative; min-width: 0; display: block; cursor: pointer; }
  .sort-choice > span { position: relative; display: grid; gap: .15rem; padding: .72rem .8rem .72rem 2rem; color: var(--muted); border: 1px solid transparent; border-radius: 11px; transition: color .16s, border-color .16s, background .16s; }
  .sort-choice > span::before { content: ""; position: absolute; left: .75rem; top: .95rem; width: .55rem; height: .55rem; border: 1px solid #66778a; border-radius: 50%; box-shadow: inset 0 0 0 2px rgba(7,16,28,.98); }
  .sort-choice strong { font-size: .78rem; }
  .sort-choice small { color: var(--muted); font-size: .66rem; }
  .sort-choice input:focus-visible + span { box-shadow: 0 0 0 3px rgba(var(--accent-rgb),.1); }
  .sort-choice input:checked + span { color: var(--accent); border-color: rgba(var(--accent-rgb),.26); background: rgba(var(--accent-rgb),.065); }
  .sort-choice input:checked + span::before { border-color: var(--accent); background: var(--accent); }
  .search-count { margin-left: auto; padding-right: .15rem; color: var(--muted); font-size: .72rem; white-space: nowrap; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (hover: none), (pointer: coarse) { .event-search input { font-size: 1rem; } }
  @media (hover: hover) and (pointer: fine) {
    .control-button:hover { color: var(--text); border-color: rgba(var(--accent-rgb),.38); background: rgba(16,29,46,.92); }
    .filter-choice:hover .filter-pill { color: var(--text); border-color: rgba(var(--accent-rgb),.25); }
    .clear-control:not(:disabled):hover { color: var(--text); border-color: var(--line); background: rgba(255,255,255,.035); }
    .sort-choice:hover > span { color: var(--text); background: rgba(255,255,255,.025); }
  }
  @media (max-width: 560px) {
    .list-control-row { position: relative; align-items: flex-start; }
    .control-popover { position: static; }
    .list-controls { flex-wrap: wrap; }
    .control-card { position: absolute; top: calc(100% + .65rem); left: 0; right: 0; bottom: auto; width: auto; max-height: calc(100dvh - 10rem - var(--safe-area-top, 0px)); overflow-y: auto; overscroll-behavior: contain; }
    .control-card.filter-card { right: 0; width: auto; max-width: 100%; }
    .location-options { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .control-value { display: none; }
  }
</style>
