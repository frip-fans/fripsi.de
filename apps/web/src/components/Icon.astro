---
import archive from "bootstrap-icons/icons/archive.svg?raw";
import arrowDownUp from "bootstrap-icons/icons/arrow-down-up.svg?raw";
import arrowLeft from "bootstrap-icons/icons/arrow-left.svg?raw";
import arrowRight from "bootstrap-icons/icons/arrow-right.svg?raw";
import arrowUpRight from "bootstrap-icons/icons/arrow-up-right.svg?raw";
import boxArrowUpRight from "bootstrap-icons/icons/box-arrow-up-right.svg?raw";
import calendar3 from "bootstrap-icons/icons/calendar3.svg?raw";
import calendarPlus from "bootstrap-icons/icons/calendar-plus.svg?raw";
import checkCircle from "bootstrap-icons/icons/check2-circle.svg?raw";
import chevronLeft from "bootstrap-icons/icons/chevron-left.svg?raw";
import chevronRight from "bootstrap-icons/icons/chevron-right.svg?raw";
import chevronDown from "bootstrap-icons/icons/chevron-down.svg?raw";
import chevronUp from "bootstrap-icons/icons/chevron-up.svg?raw";
import download from "bootstrap-icons/icons/download.svg?raw";
import disc from "bootstrap-icons/icons/disc.svg?raw";
import diagram3 from "bootstrap-icons/icons/diagram-3.svg?raw";
import funnel from "bootstrap-icons/icons/funnel.svg?raw";
import globe from "bootstrap-icons/icons/globe.svg?raw";
import globeAmericas from "bootstrap-icons/icons/globe-americas.svg?raw";
import github from "bootstrap-icons/icons/github.svg?raw";
import chatDots from "bootstrap-icons/icons/chat-dots.svg?raw";
import houseDoor from "bootstrap-icons/icons/house-door.svg?raw";
import list from "bootstrap-icons/icons/list-ul.svg?raw";
import listStars from "bootstrap-icons/icons/list-stars.svg?raw";
import mic from "bootstrap-icons/icons/mic.svg?raw";
import musicNoteBeamed from "bootstrap-icons/icons/music-note-beamed.svg?raw";
import musicNoteList from "bootstrap-icons/icons/music-note-list.svg?raw";
import plus from "bootstrap-icons/icons/plus-lg.svg?raw";
import playFill from "bootstrap-icons/icons/play-fill.svg?raw";
import pauseFill from "bootstrap-icons/icons/pause-fill.svg?raw";
import search from "bootstrap-icons/icons/search.svg?raw";
import shieldCheck from "bootstrap-icons/icons/shield-check.svg?raw";
import trash from "bootstrap-icons/icons/trash3.svg?raw";
import vinyl from "bootstrap-icons/icons/vinyl.svg?raw";

const icons = {
  archive,
  "arrow-down-up": arrowDownUp,
  "arrow-left": arrowLeft,
  "arrow-right": arrowRight,
  "arrow-up-right": arrowUpRight,
  "box-arrow-up-right": boxArrowUpRight,
  calendar3,
  "calendar-plus": calendarPlus,
  "check-circle": checkCircle,
  "chevron-left": chevronLeft,
  "chevron-right": chevronRight,
  "chevron-down": chevronDown,
  "chevron-up": chevronUp,
  download,
  disc,
  "diagram-3": diagram3,
  funnel,
  globe,
  "globe-americas": globeAmericas,
  github,
  "chat-dots": chatDots,
  "house-door": houseDoor,
  list,
  "list-stars": listStars,
  mic,
  "music-note-beamed": musicNoteBeamed,
  "music-note-list": musicNoteList,
  plus,
  "play-fill": playFill,
  "pause-fill": pauseFill,
  search,
  "shield-check": shieldCheck,
  trash,
  vinyl
} as const;

interface Props {
  name: keyof typeof icons;
  size?: number | string;
  label?: string;
  class?: string;
}

const { name, size = "1em", label, class: className } = Astro.props;
const content = icons[name].replace(/^<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "");
---
<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="currentColor"
  focusable="false"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={content}
></svg>

<style>
  .icon { display: inline-block; flex: 0 0 auto; vertical-align: -.125em; }
</style>
