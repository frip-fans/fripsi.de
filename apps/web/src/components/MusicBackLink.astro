---
import Icon from "./Icon.astro";

interface Props {
  href: string;
  storageKey: string;
  label: string;
}

const { href, storageKey, label } = Astro.props;
---
<a class="music-back" href={href} data-music-back data-storage-key={storageKey} data-list-path={href}>
  <Icon name="arrow-left" />{label}
</a>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-music-back]")) {
    const storageKey = link.dataset.storageKey;
    const listPath = link.dataset.listPath;
    if (!storageKey || !listPath) continue;
    try {
      const saved = sessionStorage.getItem(storageKey);
      if (!saved) continue;
      const target = new URL(saved, location.origin);
      if (target.origin === location.origin && target.pathname === listPath) {
        link.href = `${target.pathname}${target.search}${target.hash}`;
      }
    } catch {
      // Keep the safe list-page fallback.
    }
  }
</script>
