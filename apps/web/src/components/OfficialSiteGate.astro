---
interface Props {
  autoOpen?: boolean;
}
import Icon from "./Icon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getLocale, t } from "../lib/i18n";
const { autoOpen = false } = Astro.props;
const locale = getLocale(Astro.request);
---
<dialog class="site-gate" data-site-gate data-auto-open={autoOpen ? "true" : undefined} open={autoOpen || undefined} aria-labelledby="site-gate-title" aria-describedby="site-gate-description">
  <div class="gate-card">
    <div class="gate-language"><LanguageSwitcher context="site-gate" /></div>
    <div class="gate-mark" aria-hidden="true">
      <img src="/fan-site-logo.svg" width="72" height="72" alt="" />
    </div>
    <h2 id="site-gate-title">{t(locale, "gate.title")}</h2>
    <div id="site-gate-description" class="gate-copy">
      <p>{t(locale, "gate.unofficial")}</p>
      <p>{t(locale, "gate.authority")}</p>
    </div>
    <div class="gate-actions">
      <a class="button official-link" href="https://fripside.net" rel="external">{t(locale, "gate.official")} <Icon name="box-arrow-up-right" /></a>
      <form method="dialog">
        <button class="secondary" type="submit" data-continue-site>{t(locale, "gate.continue")}</button>
      </form>
    </div>
  </div>
</dialog>

<script>
  import {
    OFFICIAL_SITE_NOTICE_REOPEN_STORAGE_KEY,
    OFFICIAL_SITE_NOTICE_STORAGE_KEY,
    serializeOfficialSiteNoticeCookie,
  } from "../lib/site-notice";

  let siteGateController: AbortController | undefined;

  const setupSiteGate = () => {
    siteGateController?.abort();
    const controller = new AbortController();
    const { signal } = controller;
    siteGateController = controller;

    const gate = document.querySelector<HTMLDialogElement>("[data-site-gate]");
    const continueButton = gate?.querySelector<HTMLButtonElement>("[data-continue-site]");
    const openButtons = document.querySelectorAll<HTMLElement>("[data-open-site-notice]");
    if (!gate) return;

    const hasAcknowledgedNotice = () => {
      try {
        return localStorage.getItem(OFFICIAL_SITE_NOTICE_STORAGE_KEY) === "yes";
      } catch {
        return false;
      }
    };

    const persistAcknowledgement = () => {
      try {
        localStorage.setItem(OFFICIAL_SITE_NOTICE_STORAGE_KEY, "yes");
      } catch {
        // The persistent cookie remains the server-side source of truth.
      }

      document.cookie = serializeOfficialSiteNoticeCookie(location.protocol === "https:");
    };

    const consumeLanguageChangeReopen = () => {
      try {
        const shouldReopen = sessionStorage.getItem(OFFICIAL_SITE_NOTICE_REOPEN_STORAGE_KEY) === "yes";
        sessionStorage.removeItem(OFFICIAL_SITE_NOTICE_REOPEN_STORAGE_KEY);
        return shouldReopen;
      } catch {
        return false;
      }
    };

    const setPageScrollLocked = (locked: boolean) => {
      document.documentElement.classList.toggle("site-gate-open", locked);
      document.body.classList.toggle("site-gate-open", locked);
    };

    const openNotice = () => {
      setPageScrollLocked(true);
      if (typeof gate.showModal === "function") {
        if (gate.open) gate.close();
        gate.showModal();
      } else {
        gate.setAttribute("open", "");
      }
      continueButton?.focus();
    };

    const acknowledgeNotice = () => {
      persistAcknowledgement();
      delete gate.dataset.reopenAfterLanguageChange;
      gate.close();
      setPageScrollLocked(false);
    };

    const reopenAfterLanguageChange = gate.dataset.reopenAfterLanguageChange === "true" || consumeLanguageChangeReopen();
    if (reopenAfterLanguageChange) gate.dataset.reopenAfterLanguageChange = "true";
    if (reopenAfterLanguageChange || (gate.dataset.autoOpen === "true" && !hasAcknowledgedNotice())) openNotice();
    else {
      if (gate.open) gate.close();
      setPageScrollLocked(false);
    }

    continueButton?.addEventListener("click", acknowledgeNotice, { signal });
    gate.addEventListener("cancel", (event) => {
      event.preventDefault();
      acknowledgeNotice();
    }, { signal });
    openButtons.forEach((button) => button.addEventListener("click", openNotice, { signal }));
  };

  document.addEventListener("astro:page-load", setupSiteGate);
  setupSiteGate();
</script>

<style>
  :global(html.site-gate-open),
  :global(body.site-gate-open),
  :global(html:has(.site-gate[open])) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  .site-gate {
    position: fixed;
    inset: 0;
    z-index: 1000;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 5vw, 3rem);
    place-items: center;
    overflow-y: auto;
    color: var(--text);
    background:
      radial-gradient(circle at 50% 25%, rgba(var(--accent-rgb), .18), transparent 32rem),
      rgba(5, 12, 21, .94);
    border: 0;
  }

  .site-gate[open] { display: grid; }
  .site-gate:not([open]) { display: none; }
  .site-gate::backdrop { background: rgba(5, 12, 21, .96); }

  .gate-card {
    position: relative;
    width: min(100%, 600px);
    padding: clamp(1.75rem, 5vw, 3rem);
    overflow: hidden;
    text-align: center;
    background: linear-gradient(145deg, rgba(16, 31, 49, .98), rgba(8, 18, 31, .98));
    border: 1px solid rgba(var(--accent-rgb), .35);
    border-radius: clamp(18px, 4vw, 28px);
    box-shadow: 0 28px 90px rgba(0, 0, 0, .48), 0 0 60px rgba(var(--accent-rgb), .08);
  }

  .gate-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }

  .gate-language { position: absolute; top: 1rem; right: 1rem; }

  .gate-mark {
    width: 4.5rem;
    height: 4.5rem;
    margin: 0 auto 1.8rem;
    filter: drop-shadow(0 0 24px rgba(var(--accent-rgb), .16));
  }

  .gate-mark img { display: block; width: 100%; height: 100%; }

  h2 {
    margin-bottom: 1.35rem;
    font-size: clamp(1.8rem, 6vw, 3rem);
    line-height: 1.15;
  }

  .gate-copy {
    max-width: 31rem;
    margin: 0 auto;
    color: var(--muted);
    font-size: clamp(.92rem, 2.2vw, 1.03rem);
    line-height: 1.75;
  }

  .gate-copy p { margin-bottom: .55rem; }
  .gate-copy strong { color: var(--text); }

  .gate-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .75rem;
    margin-top: 2.2rem;
  }

  .gate-actions form { display: contents; }
  .gate-actions :global(.button), .gate-actions :global(button) { min-height: 48px; }
  @media (max-width: 560px) {
    .gate-actions { grid-template-columns: 1fr; }
    .gate-card { padding-top: 2rem; }
    .gate-language { position: static; display: flex; justify-content: flex-end; margin-bottom: 1.2rem; }
  }
</style>
