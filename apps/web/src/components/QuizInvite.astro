---
import QuizChibi from "./QuizChibi.astro";
import { t, type Locale } from "../lib/i18n";
interface Props { locale: Locale; }
const { locale } = Astro.props;
---

<div class="quiz-invite" data-quiz-invite>
  <svg class="quiz-invite-art" viewBox="0 0 240 112" role="presentation" aria-hidden="true" focusable="false">
    <ellipse cx="118" cy="103" rx="58" ry="5" fill="#70cfff" opacity=".12" />
    <circle cx="116" cy="54" r="45" fill="#73cfff" opacity=".07" />
    <QuizChibi />
    <g class="quiz-coin">
      <circle cx="161" cy="40" r="9" fill="#ffda79" stroke="#d49a41" stroke-width="2" />
      <circle cx="161" cy="40" r="5.5" fill="none" stroke="#fff4c2" stroke-width="1.5" />
      <path d="M162 35l-4 5h5l-3 5" fill="none" stroke="#b87b30" stroke-width="1.5" />
    </g>
    <g class="quiz-sparks" fill="none" stroke="#91ddff" stroke-width="2.5">
      <path d="M177 29l7-6-2 9 8-3M177 56l9 3-5 4 8 4M64 44l-7 6 4 4-8 5" />
      <path d="M66 22v8m-4-4h8M195 47v6m-3-3h6" stroke="#ffe0a2" stroke-width="2" />
    </g>
  </svg>
  <button class="quiz-peek-restore" type="button" data-quiz-restore aria-label={t(locale, "quiz.restore")} hidden></button>
  <button class="quiz-invite-open" type="button" data-quiz-launcher aria-haspopup="dialog">
    <span class="quiz-invite-text">{t(locale, "quiz.invite")}</span>
    <span class="quiz-invite-cta"><span>{t(locale, "quiz.inviteCta")}</span><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" /></svg></span>
  </button>
  <button class="quiz-invite-dismiss" type="button" data-quiz-dismiss aria-label={t(locale, "quiz.hide")} title={t(locale, "quiz.hide")}><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m4 4 8 8M12 4l-8 8" /></svg></button>
</div>
