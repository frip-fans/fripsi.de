---
import { t, type Locale } from "../lib/i18n";
interface Props { locale: Locale; }
const { locale } = Astro.props;
---

<div class="quiz-invite" data-quiz-invite>
  <svg class="quiz-invite-art" viewBox="0 0 240 112" role="presentation" aria-hidden="true" focusable="false">
    <ellipse cx="118" cy="103" rx="58" ry="5" fill="#70cfff" opacity=".12" />
    <circle cx="116" cy="54" r="45" fill="#73cfff" opacity=".07" />
    <g class="quiz-chibi" stroke="#644536" stroke-width="2.2">
      <!-- Chestnut bob, side clip and red school-uniform bow from the reference. -->
      <path d="M82 62Q71 23 101 16Q136 7 147 35L150 65 157 79 145 74 149 88 137 80 132 88 120 78 99 85 94 78 84 87 85 74 77 78Z" fill="#a88060" />
      <path d="M97 77L88 100Q116 107 141 100L132 77" fill="#d6c8a8" />
      <path d="M98 76L114 91 132 76 126 73 104 73Z" fill="#fff9ed" />
      <path d="M98 78l-5 9 9 1-4 5 13 10M130 78l6 9-9 1 5 5-14 10" fill="none" stroke="#9b9078" stroke-width="1.3" />
      <path d="M114 86Q105 77 104 83L104 92Q110 94 114 88Q120 95 125 92L125 83Q124 78 114 86Z" fill="#a75061" stroke="#713e49" stroke-width="1.4" />
      <path d="M112 88l-3 9 5-2 3 2 2-9" fill="#a75061" stroke="#713e49" stroke-width="1.2" />
      <circle cx="114.5" cy="86.5" r="2.5" fill="#c56b7b" stroke="#713e49" stroke-width="1" />
      <path d="M129 94l6-1v5l-3 3-3-2Z" fill="#f0dfac" stroke="#998268" stroke-width=".8" />
      <path d="M91 42Q86 74 111 79Q137 82 140 48L126 29 101 29Z" fill="#ffe8d2" />
      <path d="M84 51Q79 22 106 18Q134 11 143 37L144 57 136 48 132 32 128 46 124 35 116 49 115 34 106 48 106 35 96 49 97 35 88 55Z" fill="#ae8767" />
      <path d="M96 53q6-5 12 0M120 53q6-5 12 0" fill="none" stroke-width="2" />
      <g fill="#70503c" stroke="#493d34" stroke-width="1">
        <ellipse cx="103" cy="57" rx="4.5" ry="6" />
        <ellipse cx="125" cy="57" rx="4.5" ry="6" />
      </g>
      <g fill="#fff9ed" stroke="none">
        <circle cx="104" cy="54.5" r="1.8" /><circle cx="126" cy="54.5" r="1.8" />
        <circle cx="101.5" cy="59.5" r=".8" /><circle cx="123.5" cy="59.5" r=".8" />
      </g>
      <path d="M91 31q17-12 36-7" fill="none" stroke="#d1b599" stroke-width="2.5" opacity=".65" />
      <ellipse cx="98" cy="63" rx="5" ry="2.5" fill="#efa09a" stroke="none" />
      <ellipse cx="131" cy="63" rx="5" ry="2.5" fill="#efa09a" stroke="none" />
      <path d="M109 65q5 7 10 0" fill="none" />
      <path d="M85 38l6 2m-6 3 6 2" stroke="#fff0c8" stroke-width="3" />
      <path d="M95 83Q76 78 79 64Q82 59 86 65L88 73 102 79" fill="#ffe8d2" />
      <g class="quiz-chibi-hand">
        <path d="M130 81Q148 84 159 66L156 60Q152 58 151 65L141 72 135 73" fill="#ffe8d2" />
        <path d="M156 62l5-5" fill="none" />
      </g>
    </g>
    <g class="quiz-coin">
      <circle cx="161" cy="40" r="9" fill="#ffda79" stroke="#d49a41" stroke-width="2" />
      <circle cx="161" cy="40" r="5.5" fill="none" stroke="#fff4c2" stroke-width="1.5" />
      <path d="M162 35l-4 5h5l-3 5" fill="none" stroke="#b87b30" stroke-width="1.5" />
    </g>
    <g class="quiz-sparks" fill="none" stroke="#91ddff" stroke-width="2.5">
      <path d="M177 29l7-6-2 9 8-3M177 56l9 3-5 4 8 4M64 44l-7 6 4 4-8 5" />
      <path d="M66 22v8m-4-4h8M195 47v6m-3-3h6" stroke="#ffe0a2" stroke-width="2" />
    </g>
  </svg>
  <button class="quiz-peek-restore" type="button" data-quiz-restore aria-label={t(locale, "quiz.restore")} hidden></button>
  <button class="quiz-invite-open" type="button" data-quiz-launcher aria-haspopup="dialog">
    <span class="quiz-invite-text">{t(locale, "quiz.invite")}</span>
    <span class="quiz-invite-cta"><span>{t(locale, "quiz.inviteCta")}</span><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" /></svg></span>
  </button>
  <button class="quiz-invite-dismiss" type="button" data-quiz-dismiss aria-label={t(locale, "quiz.hide")} title={t(locale, "quiz.hide")}><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m4 4 8 8M12 4l-8 8" /></svg></button>
</div>
