---
import "../styles/release-cover.css";
interface Props {
  url?: string | null;
  alt: string;
  eager?: boolean;
  noScriptFallback?: boolean;
}
const { url, alt, eager = false, noScriptFallback = true } = Astro.props;
---
<span class="release-cover" role="img" aria-label={alt}>
  <span class="release-cover-placeholder" aria-hidden="true">♫</span>
  {url && <img src={eager ? url : undefined} data-cover-src={eager ? undefined : url} hidden={!eager} alt="" width="480" height="480" loading={eager ? "eager" : "lazy"} decoding="async" referrerpolicy="no-referrer" data-release-cover-image />}
  {url && !eager && noScriptFallback && <noscript><img src={url} alt="" width="480" height="480" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></noscript>}
</span>

<script>
  import { setupReleaseCovers } from "../scripts/release-cover";
  setupReleaseCovers();
  document.addEventListener("astro:page-load", () => setupReleaseCovers());
</script>
