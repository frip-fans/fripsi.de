---
import Icon from "./Icon.astro";

interface Choice {
  value: string;
  label: string;
  searchText?: string;
  title?: string;
  muted?: boolean;
  note?: string;
}

interface Props {
  name: string;
  choices: Choice[];
  value?: string | null;
  placeholder: string;
  searchPlaceholder: string;
  emptyText: string;
  ariaLabel: string;
  required?: boolean;
}

const {
  name,
  choices,
  value = "",
  placeholder,
  searchPlaceholder,
  emptyText,
  ariaLabel,
  required = false,
} = Astro.props;
const selectedChoice = choices.find((choice) => choice.value === value);
const pickerId = `search-select-${crypto.randomUUID()}`;
---

<div class="search-select" data-search-select data-placeholder={placeholder}>
  <select
    class="search-select-native"
    name={name}
    required={required}
    tabindex="-1"
    aria-hidden="true"
    data-search-select-native
  >
    <option value="">{placeholder}</option>
    {choices.map((choice) => (
      <option value={choice.value} data-title={choice.title} selected={choice.value === value}>{choice.label}</option>
    ))}
  </select>

  <button
    type="button"
    class="search-select-trigger"
    aria-label={ariaLabel}
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={`${pickerId}-panel`}
    data-search-select-trigger
  >
    <span data-search-select-value>{selectedChoice?.label ?? placeholder}</span>
    <Icon name="chevron-down" class="search-select-caret" />
  </button>

  <div class="search-select-panel" id={`${pickerId}-panel`} data-search-select-panel hidden>
    <label class="search-select-search">
      <span class="visually-hidden">{searchPlaceholder}</span>
      <Icon name="search" />
      <input type="search" placeholder={searchPlaceholder} autocomplete="off" data-search-select-search />
    </label>
    <div class="search-select-options" role="listbox" aria-label={ariaLabel} data-search-select-options>
      {choices.map((choice) => (
        <button
          type="button"
          class:list={["search-select-option", { muted: choice.muted, selected: choice.value === value }]}
          role="option"
          aria-selected={choice.value === value ? "true" : "false"}
          data-search-select-option
          data-value={choice.value}
          data-search={(choice.searchText ?? choice.label).toLocaleLowerCase()}
        >
          <span>{choice.label}</span>
          {choice.note && <small>{choice.note}</small>}
        </button>
      ))}
      <p class="search-select-empty" data-search-select-empty hidden>{emptyText}</p>
    </div>
  </div>
</div>

<script>
  const pickerSelector = "[data-search-select]";

  const normalizeSearch = (value: string) => value.normalize("NFKC").toLocaleLowerCase().trim();

  const syncPicker = (picker: HTMLElement) => {
    const native = picker.querySelector("[data-search-select-native]");
    const value = picker.querySelector<HTMLElement>("[data-search-select-value]");
    if (!(native instanceof HTMLSelectElement) || !value) return;
    const selected = native.selectedOptions[0];
    value.textContent = selected?.value ? selected.textContent : (picker.dataset.placeholder ?? "");
    for (const option of picker.querySelectorAll<HTMLElement>("[data-search-select-option]")) {
      const isSelected = option.dataset.value === native.value;
      option.classList.toggle("selected", isSelected);
      option.setAttribute("aria-selected", String(isSelected));
    }
  };

  const filterPicker = (picker: HTMLElement) => {
    const input = picker.querySelector<HTMLInputElement>("[data-search-select-search]");
    const terms = normalizeSearch(input?.value ?? "").split(/\s+/).filter(Boolean);
    let visible = 0;
    for (const option of picker.querySelectorAll<HTMLElement>("[data-search-select-option]")) {
      const searchText = normalizeSearch(option.dataset.search ?? "");
      const matches = terms.every((term) => searchText.includes(term));
      option.hidden = !matches;
      if (matches) visible += 1;
    }
    const empty = picker.querySelector<HTMLElement>("[data-search-select-empty]");
    if (empty) empty.hidden = visible > 0;
  };

  const closePicker = (picker: HTMLElement, restoreFocus = false) => {
    const panel = picker.querySelector<HTMLElement>("[data-search-select-panel]");
    const trigger = picker.querySelector<HTMLButtonElement>("[data-search-select-trigger]");
    if (!panel || !trigger || panel.hidden) return;
    panel.hidden = true;
    trigger.setAttribute("aria-expanded", "false");
    if (restoreFocus) trigger.focus();
  };

  const closeOtherPickers = (except?: HTMLElement) => {
    for (const picker of document.querySelectorAll<HTMLElement>(pickerSelector)) {
      if (picker !== except) closePicker(picker);
    }
  };

  const openPicker = (picker: HTMLElement) => {
    const panel = picker.querySelector<HTMLElement>("[data-search-select-panel]");
    const trigger = picker.querySelector<HTMLButtonElement>("[data-search-select-trigger]");
    const search = picker.querySelector<HTMLInputElement>("[data-search-select-search]");
    if (!panel || !trigger || !search) return;
    closeOtherPickers(picker);
    panel.hidden = false;
    trigger.setAttribute("aria-expanded", "true");
    search.value = "";
    filterPicker(picker);
    search.focus();
  };

  const visibleOptions = (picker: HTMLElement) => [...picker.querySelectorAll<HTMLButtonElement>("[data-search-select-option]")]
    .filter((option) => !option.hidden);

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement) && !(target instanceof SVGElement)) return;
    const picker = target.closest<HTMLElement>(pickerSelector);
    const trigger = target.closest("[data-search-select-trigger]");
    if (picker && trigger) {
      const panel = picker.querySelector<HTMLElement>("[data-search-select-panel]");
      if (panel?.hidden) openPicker(picker);
      else closePicker(picker);
      return;
    }

    const option = target.closest<HTMLElement>("[data-search-select-option]");
    if (picker && option) {
      const native = picker.querySelector("[data-search-select-native]");
      if (!(native instanceof HTMLSelectElement)) return;
      native.value = option.dataset.value ?? "";
      syncPicker(picker);
      native.dispatchEvent(new Event("change", { bubbles: true }));
      closePicker(picker, true);
      return;
    }

    if (!picker) closeOtherPickers();
  });

  document.addEventListener("input", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement) || !target.matches("[data-search-select-search]")) return;
    const picker = target.closest<HTMLElement>(pickerSelector);
    if (picker) filterPicker(picker);
  });

  document.addEventListener("change", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLSelectElement) || !target.matches("[data-search-select-native]")) return;
    const picker = target.closest<HTMLElement>(pickerSelector);
    if (picker) syncPicker(picker);
  });

  document.addEventListener("keydown", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement) && !(target instanceof SVGElement)) return;
    const picker = target.closest<HTMLElement>(pickerSelector);
    if (!picker) return;
    if (event.key === "Escape") {
      event.preventDefault();
      closePicker(picker, true);
      return;
    }
    if (target.matches("[data-search-select-trigger]") && (event.key === "ArrowDown" || event.key === "ArrowUp")) {
      event.preventDefault();
      openPicker(picker);
      return;
    }
    if (target.matches("[data-search-select-search]") && event.key === "ArrowDown") {
      event.preventDefault();
      visibleOptions(picker)[0]?.focus();
      return;
    }
    const option = target.closest<HTMLButtonElement>("[data-search-select-option]");
    if (!option || (event.key !== "ArrowDown" && event.key !== "ArrowUp")) return;
    event.preventDefault();
    const options = visibleOptions(picker);
    const index = options.indexOf(option);
    const next = event.key === "ArrowDown" ? options[index + 1] : options[index - 1];
    (next ?? (event.key === "ArrowDown" ? options[0] : options.at(-1)))?.focus();
  });

  document.addEventListener("invalid", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLSelectElement) || !target.matches("[data-search-select-native]")) return;
    event.preventDefault();
    const picker = target.closest<HTMLElement>(pickerSelector);
    const trigger = picker?.querySelector<HTMLButtonElement>("[data-search-select-trigger]");
    trigger?.focus();
  }, true);

  for (const picker of document.querySelectorAll<HTMLElement>(pickerSelector)) syncPicker(picker);
</script>

<style>
  .search-select { position: relative; min-width: 0; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .search-select-native { position: absolute; width: 1px; height: 1px; padding: 0; opacity: 0; pointer-events: none; }
  button.search-select-trigger { width: 100%; min-height: 44px; justify-content: space-between; padding: .72rem .8rem; color: var(--text); background: rgba(4,11,20,.72); border: 1px solid var(--line); border-radius: 10px; font-weight: 400; text-align: left; }
  button.search-select-trigger:hover { filter: none; transform: none; border-color: rgba(var(--accent-rgb), .42); }
  button.search-select-trigger:focus-visible, .search-select:focus-within button.search-select-trigger { border-color: rgba(var(--accent-rgb), .55); box-shadow: 0 0 0 3px rgba(var(--accent-rgb), .08); outline: 0; }
  .search-select-trigger span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .search-select-trigger :global(.search-select-caret) { flex: 0 0 auto; color: var(--muted); transition: transform .15s ease; }
  .search-select-trigger[aria-expanded="true"] :global(.search-select-caret) { transform: rotate(180deg); }
  .search-select-panel { position: absolute; z-index: 40; top: calc(100% + .4rem); left: 0; width: 100%; min-width: min(28rem, calc(100vw - 3rem)); overflow: hidden; padding: .45rem; background: #0b1220; border: 1px solid rgba(var(--accent-rgb), .34); border-radius: 12px; box-shadow: 0 18px 48px rgba(0,0,0,.42); }
  .search-select-search { position: relative; display: flex; align-items: center; margin-bottom: .35rem; }
  .search-select-search :global(.icon) { position: absolute; left: .8rem; color: var(--muted); pointer-events: none; }
  .search-select-search input { height: 40px; padding: .55rem .7rem .55rem 2.35rem; background: rgba(2,8,16,.92); }
  .search-select-options { display: grid; gap: .12rem; max-height: 19rem; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
  button.search-select-option { width: 100%; min-height: 0; justify-content: space-between; padding: .62rem .7rem; color: var(--text); background: transparent; border: 1px solid transparent; border-radius: 8px; font-weight: 500; line-height: 1.35; text-align: left; }
  button.search-select-option:hover, button.search-select-option:focus-visible { color: var(--text); background: rgba(255,255,255,.07); border-color: var(--line); filter: none; transform: none; outline: 0; }
  button.search-select-option.selected { color: var(--accent); background: rgba(var(--accent-rgb), .08); }
  button.search-select-option.muted { color: var(--muted); background: rgba(255,255,255,.025); }
  button.search-select-option small { flex: 0 0 auto; padding: .15rem .4rem; color: #8d96a8; background: rgba(255,255,255,.06); border-radius: 999px; font-size: .65rem; font-weight: 500; white-space: nowrap; }
  .search-select-empty { margin: 0; padding: 1rem .7rem; color: var(--muted); text-align: center; }
  [hidden] { display: none !important; }
  @media (max-width: 680px) {
    .search-select-panel { min-width: 100%; }
  }
</style>
