---
import type { SongSpotlight } from "@frip-fan/core";
import Icon from "./Icon.astro";
import ReleaseCover from "./ReleaseCover.astro";
import { formatMusicDate, setlistDisplayTitle } from "../lib/music";
import { type Locale, t } from "../lib/i18n";

interface Props {
  spotlight: SongSpotlight;
  locale: Locale;
  /** Archived setlists in the whole library, the footnote that frames every number here. */
  archiveShows: number;
}
const { spotlight, locale, archiveShows } = Astro.props;
const first = spotlight.first_performance;
const last = spotlight.last_performance;
const rate = spotlight.shows_since_release
  ? Math.round((spotlight.show_count / spotlight.shows_since_release) * 100)
  : null;
const releaseYear = spotlight.first_release_date?.slice(0, 4) ?? null;
const meta = [
  releaseYear ? t(locale, "home.spotlightReleased", { year: releaseYear }) : null,
  spotlight.release_count > 0 ? t(locale, "home.spotlightReleaseCount", { count: spotlight.release_count }) : null,
].filter(Boolean);
// The grey bar is every archived show that year, the accent bar the ones with this song, so a
// short accent bar reads as "rarely played that year" rather than "few shows that year".
const maxTotal = Math.max(1, ...spotlight.years.map((year) => year.total));
const chartYears = spotlight.years.length > 1 ? spotlight.years : [];
const axisYears = [chartYears[0]?.year, chartYears.at(-1)?.year].filter(Boolean);
const barLabel = (year: { year: string; total: number; sung: number }) => year.total
  ? t(locale, "music.yearBar", { year: year.year, total: year.total, count: year.sung })
  : t(locale, "music.yearNoShows", { year: year.year });
---
<section class="spotlight panel" aria-labelledby="spotlight-title">
  <div class="spotlight-top">
    <span class="spotlight-label">{t(locale, "home.spotlightLabel")}</span>
    <a class="spotlight-more" href={`/music/songs/${spotlight.slug}`}>
      {t(locale, "home.spotlightMore")} <Icon name="chevron-right" size=".75rem" />
    </a>
  </div>

  <div class="spotlight-head">
    {spotlight.release && (
      <a class="spotlight-cover" href={`/music/releases/${spotlight.release.slug}`} aria-label={t(locale, "music.coverAlt", { title: spotlight.release.title })}>
        <ReleaseCover url={spotlight.release.cover_url} alt="" />
      </a>
    )}
    <div class="spotlight-head-text">
      <h2 id="spotlight-title" class="spotlight-song">
        <a href={`/music/songs/${spotlight.slug}`} translate="no">{spotlight.title}</a>
      </h2>
      <p class="spotlight-meta"><span translate="no">{spotlight.original_artist}</span>{meta.map((item) => <span>{item}</span>)}</p>
    </div>
  </div>

  <dl class="spotlight-stats">
    <div class="spotlight-stat">
      <dt>{t(locale, "music.statShows")}</dt>
      <dd><strong>{spotlight.show_count}</strong><span>{t(locale, "music.statShowsHint")}</span></dd>
    </div>
    {rate !== null && (
      <div class="spotlight-stat">
        <dt>{t(locale, "music.statRate")}</dt>
        <dd><strong>{rate}%</strong><span title={t(locale, "music.statRateHint", { total: spotlight.shows_since_release, count: spotlight.show_count })}>{t(locale, "music.statRateHint", { total: spotlight.shows_since_release, count: spotlight.show_count })}</span></dd>
      </div>
    )}
    {last && (
      <div class="spotlight-stat">
        <dt>{t(locale, "music.statLast")}</dt>
        <dd>
          <strong>{formatMusicDate(last.start_date, locale)}</strong>
          <span class:list={{ "is-gap": spotlight.shows_since_last > 0 }} title={spotlight.shows_since_last > 0 ? t(locale, "home.spotlightGap", { count: spotlight.shows_since_last }) : t(locale, "home.spotlightGapNone")}>
            {spotlight.shows_since_last > 0
              ? t(locale, "home.spotlightGap", { count: spotlight.shows_since_last })
              : t(locale, "home.spotlightGapNone")}
          </span>
        </dd>
      </div>
    )}
    {first && (
      <div class="spotlight-stat">
        <dt>{t(locale, "music.statFirst")}</dt>
        <dd>
          <strong>{formatMusicDate(first.start_date, locale)}</strong>
          <a href={`/music/lives/${encodeURIComponent(first.setlist_id)}`} title={setlistDisplayTitle(first)}>{setlistDisplayTitle(first)}</a>
        </dd>
      </div>
    )}
  </dl>

  {chartYears.length > 0 && (
    <figure class="spotlight-chart-figure">
      <figcaption>
        <span class="spotlight-chart-title">{t(locale, "music.yearlyHeading")}</span>
        <span class="spotlight-legend"><span class="is-total">{t(locale, "music.legendShows")}</span><span class="is-sung">{t(locale, "music.legendSung")}</span></span>
      </figcaption>
      <div class="spotlight-chart" style={`--years: ${chartYears.length}`} role="img" aria-label={chartYears.map(barLabel).join("；")}>
        {chartYears.map((year) => (
          <div class="spotlight-bar" data-chip={`${year.sung}/${year.total}`} aria-label={barLabel(year)} style={`--total: ${(year.total / maxTotal) * 100}%; --sung: ${(year.sung / maxTotal) * 100}%`}>
            <span class:list={["spotlight-bar-total", { "is-gap": !year.total }]}></span>
            {year.sung > 0 && <span class="spotlight-bar-sung"></span>}
            <span class="spotlight-bar-year" aria-hidden="true">{year.year}</span>
          </div>
        ))}
      </div>
      <div class="spotlight-axis" style={`--years: ${chartYears.length}`} aria-hidden="true">{chartYears.map((year) => <span>{axisYears.includes(year.year) ? year.year : ""}</span>)}</div>
    </figure>
  )}

  <p class="spotlight-footnote">{t(locale, "home.spotlightArchive", { count: archiveShows })}</p>
</section>

<style>
  .spotlight { display: grid; gap: .85rem; padding: 1.5rem; }
  .spotlight-top { display: flex; align-items: center; justify-content: space-between; gap: .75rem; color: var(--muted); }
  .spotlight-label { font: 700 .68rem/1 ui-monospace; text-transform: uppercase; letter-spacing: .12em; }
  .spotlight-more { display: inline-flex; align-items: center; gap: .3rem; min-height: 32px; color: var(--muted); font-size: .8125rem; text-decoration: none; }
  .spotlight-more:hover, .spotlight-more:focus-visible { color: var(--accent); }
  .spotlight-head { display: flex; align-items: center; gap: 1.1rem; min-width: 0; }
  .spotlight-cover { flex: 0 0 auto; width: 5.5rem; border-radius: 12px; text-decoration: none; transition: transform .18s; }
  .spotlight-cover:hover { transform: translateY(-2px); }
  .spotlight-cover:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 12px; }
  .spotlight-head-text { min-width: 0; }
  .spotlight-song { margin: 0; font-size: clamp(1.5rem, 3.2vw, 2.1rem); line-height: 1.2; letter-spacing: -.02em; overflow-wrap: anywhere; }
  .spotlight-song a { color: inherit; text-decoration: none; }
  .spotlight-song a:hover { color: var(--accent); }
  .spotlight-meta { display: flex; flex-wrap: wrap; gap: .4rem .75rem; margin: .45rem 0 0; color: var(--muted); font-size: .8125rem; }
  .spotlight-meta span + span::before { content: "·"; margin-right: .75rem; opacity: .6; }
  .spotlight-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .6rem; margin: .25rem 0 0; }
  .spotlight-stat { min-width: 0; padding: .8rem .9rem; border: 1px solid var(--line); border-radius: 14px; background: rgba(7, 16, 28, .5); }
  .spotlight-stat dt { color: var(--muted); font-size: .72rem; font-weight: 650; }
  .spotlight-stat dd { display: grid; gap: .25rem; min-width: 0; margin: .35rem 0 0; }
  /* Dates are the longest value here, so the number scales down before it wraps. */
  .spotlight-stat strong { color: var(--accent); font-size: clamp(1.05rem, 1.9vw, 1.4rem); line-height: 1.15; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .spotlight-stat span, .spotlight-stat a { overflow: hidden; color: var(--muted); font-size: .72rem; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
  .spotlight-stat span.is-gap { color: #e8c88a; }
  .spotlight-stat a { color: var(--text); text-decoration: underline; text-decoration-color: rgba(159, 180, 211, .35); text-underline-offset: 3px; }
  .spotlight-stat a:hover { color: var(--accent); }
  .spotlight-chart-figure { margin: .35rem 0 0; }
  .spotlight-chart-figure figcaption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .35rem .75rem; margin-bottom: .55rem; color: var(--muted); font-size: .75rem; }
  .spotlight-chart-title { font-weight: 650; }
  .spotlight-legend { display: flex; gap: .75rem; }
  .spotlight-legend span::before { content: ""; display: inline-block; width: .7rem; height: .55rem; margin-right: .35rem; border-radius: 2px; }
  .spotlight-legend .is-total::before { background: rgba(159, 180, 211, .3); }
  .spotlight-legend .is-sung::before { background: var(--accent); }
  /* Cap the bar width so a short archive reads as a chart, not as colour blocks. */
  .spotlight-chart { display: grid; grid-template-columns: repeat(var(--years), minmax(0, 2.5rem)); justify-content: start; gap: 3px; height: 4.5rem; border-bottom: 1px solid var(--line); }
  .spotlight-bar { position: relative; min-width: 0; height: 100%; }
  /* Hovering a bar names its year and count; the axis only labels the ends. */
  .spotlight-bar::after {
    content: attr(data-chip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + .3rem);
    z-index: 2;
    padding: .2rem .45rem;
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 6px;
    background: rgba(7, 16, 28, .95);
    font-size: .6875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-50%);
    transition: opacity .12s;
    pointer-events: none;
  }
  .spotlight-bar:first-child::after { left: 0; transform: none; }
  .spotlight-bar:last-child::after { left: auto; right: 0; transform: none; }
  .spotlight-bar:hover::after { opacity: 1; }
  /* The hovered year appears under its own bar, where the axis labels sit, as on the song page. */
  .spotlight-bar-year { position: absolute; left: 50%; top: calc(100% + .35rem); color: var(--text); font-size: .6875rem; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; opacity: 0; transform: translateX(-50%); transition: opacity .12s; }
  .spotlight-bar:hover .spotlight-bar-year { opacity: 1; }
  .spotlight-chart:has(.spotlight-bar:hover) + .spotlight-axis { opacity: 0; }
  .spotlight-axis { transition: opacity .12s; }
  @media (hover: none) { .spotlight-bar::after { content: none; } }
  .spotlight-bar-total, .spotlight-bar-sung { position: absolute; left: 0; right: 0; bottom: 0; border-radius: 4px 4px 1px 1px; }
  .spotlight-bar-total { height: var(--total); background: rgba(159, 180, 211, .22); }
  .spotlight-bar-total.is-gap { height: 100%; background: repeating-linear-gradient(135deg, rgba(159, 180, 211, .09) 0 5px, transparent 5px 10px); }
  .spotlight-bar-sung { height: var(--sung); background: var(--accent); }
  .spotlight-axis { display: grid; grid-template-columns: repeat(var(--years), minmax(0, 2.5rem)); justify-content: start; gap: 3px; margin-top: .35rem; white-space: nowrap; color: var(--muted); font-size: .6875rem; font-variant-numeric: tabular-nums; }
  .spotlight-footnote { margin: 0; color: var(--muted); font-size: .72rem; }
  @media (max-width: 800px) {
    .spotlight { padding: 1.15rem; gap: .7rem; }
    .spotlight-head { gap: .85rem; }
    .spotlight-cover { width: 4rem; }
    .spotlight-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .spotlight-stat strong { font-size: 1.15rem; }
    .spotlight-chart, .spotlight-axis { grid-template-columns: repeat(var(--years), minmax(0, 2rem)); }
    .spotlight-chart { height: 3.75rem; }
  }
</style>
