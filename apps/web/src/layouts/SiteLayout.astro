---
interface Props {
  title?: string;
  description?: string;
  admin?: boolean;
  clientRouting?: boolean;
  /** Schema.org data for this page, rendered as JSON-LD. */
  structuredData?: unknown;
}
import { ClientRouter } from "astro:transitions";
import { getEnv } from "../lib/env";
import { getLocale, t } from "../lib/i18n";
import Icon from "../components/Icon.astro";
import NavigationLoading from "../components/NavigationLoading.astro";
import NavigationDiagnostics from "../components/NavigationDiagnostics.astro";
import routerBootstrap from "../scripts/router-bootstrap.js?url";
import AdminChatDock from "../components/AdminChatDock.astro";
import { chatDockState, chatEnabled } from "../lib/chat";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import OfficialSiteGate from "../components/OfficialSiteGate.astro";
import QuizBoard from "../components/QuizBoard.astro";
import QuizInvite from "../components/QuizInvite.astro";
import QuizChibi from "../components/QuizChibi.astro";
import "../styles/quiz.css";
import { OFFICIAL_SITE_NOTICE_COOKIE } from "../lib/site-notice";
import moonBackground from "../../../../images/A_New_View_of_the_Moon-no-earth.webp?url";
import issBackground from "../../../../images/ISS.jpg?url";

const {
  title = "fripSi.de Fan Site",
  description,
  structuredData,
  admin = false,
  clientRouting = !admin && !/^\/(journey|yaginuma-intensity-calibrator)(?:\/|$)/.test(Astro.url.pathname)
} = Astro.props;
const current = Astro.url.pathname;
const locale = admin ? "zh-CN" : getLocale(Astro.request);
const resolvedDescription = description ?? t(locale, "site.description");
const rotateHomeBackground = !admin && current === "/";
const siteName = admin ? "Calendar Studio" : "fripSi.de Fan Site";
// The /quiz page already shows the board, so the floating entry would duplicate it.
const showQuizLauncher = !admin && !current.startsWith("/quiz");
const autoOpenOfficialSiteGate = !admin && current === "/" && Astro.cookies.get(OFFICIAL_SITE_NOTICE_COOKIE)?.value !== "yes";
interface NavigationItem {
  href?: string;
  label: string;
  active: boolean;
  children?: { href: string; label: string; active: boolean }[];
}
const funLinks = [
  { href: "/quiz", label: t(locale, "nav.quiz"), active: current.startsWith("/quiz") },
  { href: "/journey", label: t(locale, "nav.journey"), active: current.startsWith("/journey") },
  { href: "/yaginuma-intensity-calibrator", label: t(locale, "nav.yaginuma"), active: current.startsWith("/yaginuma-intensity-calibrator") },
];
const navigationLinks: NavigationItem[] = admin ? [
  { href: "/admin", label: "概览", active: current === "/admin" },
  { href: "/admin/events", label: "活动", active: current.startsWith("/admin/events") },
  { href: "/admin/tours", label: "巡演", active: current.startsWith("/admin/tours") },
  { href: "/admin/music/setlists", label: "音乐库", active: current.startsWith("/admin/music") },
  { href: "/admin/changes", label: "提案", active: current.startsWith("/admin/changes") },
  { href: "/admin/audit", label: "审计", active: current.startsWith("/admin/audit") },
  { href: "/admin/data", label: "数据", active: current.startsWith("/admin/data") },
] : [
  { href: "/", label: t(locale, "nav.home"), active: current === "/" },
  { href: "/calendar", label: t(locale, "nav.calendar"), active: current.startsWith("/calendar") || current.startsWith("/archive") },
  { href: "/music/lives", label: t(locale, "nav.music"), active: current.startsWith("/music") },
  { label: t(locale, "nav.fun"), active: funLinks.some(link => link.active), children: funLinks },
  { href: "/about", label: t(locale, "nav.about"), active: current.startsWith("/about") },
];
// A hover reliably precedes a desktop click, so it buys the most time; touch
// input has no hover, so the mobile menu starts on the pointer going down
// instead. Admin documents are private and never cached: leave them alone.
const hoverPrefetch = admin ? undefined : "hover";
const tapPrefetch = admin ? undefined : "tap";
const canonicalBase = getEnv().SITE_URL || Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, canonicalBase).href;
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;

// The dock is re-rendered on every admin page because admin keeps client routing off.
// The cookie lets the server emit the open class in the first byte, so the rail's
// reflow never flashes.
const chatDock = admin && chatEnabled() ? await chatDockState(Astro.locals.actor!) : null;
const chatDockOpen = chatDock !== null && Astro.cookies.get("chat_dock_open")?.value === "1";
---
<!doctype html>
<html lang={locale} class:list={{ "chat-dock-open": chatDockOpen }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={resolvedDescription} />
    <meta name="theme-color" content="#07101c" />
    <!-- Select the responsive navigation before external styles or scripts load. -->
    <style is:inline data-critical-navigation>
      .mobile-menu-trigger { display: none; }
      @media (max-width: 760px) {
        .header-actions { display: none; }
        .mobile-menu-trigger { display: inline-flex; }
      }
    </style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, canonicalBase)} />
    <title>{pageTitle}</title>
    {!admin && (
      <>
        <meta property="og:site_name" content={siteName} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={resolvedDescription} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:locale" content={locale.replace("-", "_")} />
        <meta property="og:image" content={new URL("/og-cover.jpg", canonicalBase)} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={siteName} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={resolvedDescription} />
        <meta name="twitter:image" content={new URL("/og-cover.jpg", canonicalBase)} />
      </>
    )}
    {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />}
    {clientRouting && <script is:inline src={`${routerBootstrap}?release=${encodeURIComponent(getEnv().FRIP_RELEASE_SHA || "development")}`}></script>}
    {clientRouting && <ClientRouter fallback="animate" />}
  </head>
  <body class:list={{ admin }}>
    <div class="safe-area-top" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">{t(locale, "nav.skip")}</a>
    <div class="background-rotator" data-background-rotator={rotateHomeBackground || undefined} aria-hidden="true">
      <div class="space-backdrop moon-backdrop is-active" data-background-slide style={`--space-image: url("${moonBackground}"); --space-position: center top`}></div>
      {rotateHomeBackground && (
        <div class="space-backdrop iss-backdrop" data-background-slide style={`--space-image: url("${issBackground}"); --space-position: center 18%`}></div>
      )}
    </div>
    <div class="ambient ambient-a"></div>
    <div class="ambient ambient-b"></div>
    <header class="site-header">
      <a class="brand" href={admin ? "/admin" : "/"} aria-label={siteName}>
        {admin ? (
          <>
            <span class="brand-mark">F</span>
            <span><b>{siteName}</b><small>protected workspace</small></span>
          </>
        ) : (
          <>
            <img class="brand-logo" src="/fan-site-logo.svg" width="48" height="48" alt="" />
            <span><b>fripSi<span class="brand-tld">.de</span> Fan Site</b><small>unofficial</small></span>
          </>
        )}
      </a>
      <div class="header-actions" data-desktop-menu data-loading-label={t(locale, "search.loading")}>
      <nav data-main-nav aria-label={admin ? "主导航" : t(locale, "nav.main")}>
        {navigationLinks.map(link => link.children ? (
          <details class="nav-group" data-nav-group>
            <summary class:list={{ active: link.active }}>{link.label}<Icon name="chevron-down" /></summary>
            <div class="nav-submenu">
              {link.children.map(child => <a href={child.href} aria-current={child.active ? "page" : undefined} data-astro-prefetch={hoverPrefetch}>{child.label}</a>)}
            </div>
          </details>
        ) : <a class:list={{ active: link.active }} aria-current={link.active ? "page" : undefined} href={link.href} data-astro-prefetch={hoverPrefetch} data-music-entry={!admin && link.href === "/music/lives" || undefined}>{link.label}</a>)}
        {admin && <a href="/" target="_blank">查看网站 <Icon name="box-arrow-up-right" /></a>}
      </nav>
      <span class="menu-loading-status" data-menu-loading-status role="status" aria-live="polite"></span>
      </div>
      {showQuizLauncher && (
        <span class="quiz-header-slot">
          <button class="quiz-header-button" type="button" data-quiz-header-launcher aria-haspopup="dialog" aria-label={t(locale, "quiz.invite")} title={t(locale, "quiz.invite")}>
            <svg viewBox="80 12 82 82" aria-hidden="true" focusable="false"><QuizChibi /></svg>
            <span class="quiz-header-dot" data-quiz-header-dot hidden></span>
          </button>
          <button class="quiz-header-bubble" type="button" data-quiz-header-launcher data-quiz-header-bubble hidden>{t(locale, "quiz.invite")}<span aria-hidden="true">→</span></button>
        </span>
      )}
      <button class="mobile-menu-trigger" type="button" data-menu-open aria-label={t(locale, "nav.openMenu")} aria-haspopup="dialog" aria-controls="mobile-menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        <span>{t(locale, "nav.menu")}</span>
      </button>
    </header>
    <div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" hidden data-mobile-menu data-loading-label={t(locale, "search.loading")} aria-label={t(locale, "nav.menu")}>
      <div class="mobile-menu-top">
        <div class="mobile-menu-brand"><img src="/fan-site-logo.svg" width="40" height="40" alt="" /><span>fripSi<span class="brand-tld">.de</span></span></div>
        <button type="button" class="mobile-menu-close" data-menu-close aria-label={t(locale, "nav.closeMenu")}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
      </div>
      <nav class="mobile-menu-links" aria-label={t(locale, "nav.main")}>
        {navigationLinks.map(link => link.children ? (
          <details class="mobile-nav-group" open={link.active}>
            <summary>{link.label}<Icon name="chevron-down" /></summary>
            <div class="mobile-nav-submenu">
              {link.children.map(child => <a href={child.href} aria-current={child.active ? "page" : undefined} data-astro-prefetch={tapPrefetch}><span>{child.label}</span><Icon name="chevron-right" /></a>)}
            </div>
          </details>
        ) : <a href={link.href} aria-current={link.active ? "page" : undefined} data-astro-prefetch={tapPrefetch}><span>{link.label}</span><Icon name="chevron-right" /></a>)}
        {admin && <a href="/">查看网站 <Icon name="chevron-right" /></a>}
      </nav>
      <span class="menu-loading-status" data-menu-loading-status role="status" aria-live="polite"></span>
      {!admin && <div class="mobile-menu-language"><span>{t(locale, "language.label")}</span><LanguageSwitcher /></div>}
    </div>
    {!admin && <OfficialSiteGate autoOpen={autoOpenOfficialSiteGate} />}
    <main id="main-content" tabindex="-1"><slot /></main>
    {showQuizLauncher && (
      <div class="quiz-launcher-root" transition:persist="quiz-launcher">
        <div class="quiz-launcher-dock" data-quiz-launcher-bar hidden>
        <QuizInvite locale={locale} />
        </div>
        <dialog class="quiz-dialog" data-quiz-dialog aria-label={t(locale, "quiz.title")}>
          <div class="quiz-dialog-inner">
            <header class="quiz-dialog-head">
              <p class="quiz-eyebrow">{t(locale, "quiz.todayLabel")}</p>
              <button class="quiz-dialog-close" type="button" data-quiz-close aria-label={t(locale, "quiz.close")}><Icon name="x-lg" /></button>
            </header>
            <QuizBoard locale={locale} />
          </div>
        </dialog>
      </div>
    )}
    {!admin && <NavigationLoading />}
    {!admin && ["staging", "development"].includes(getEnv().APP_ENV ?? "") && <NavigationDiagnostics />}
    <footer>
      <span>{admin ? "fripSide 名称、标识、作品及其他相关内容的权利归各自权利人所有。" : t(locale, "footer.rights")}</span>
      {admin ? <span>本站并非 fripSide 官方网站</span> : (
        <div class="footer-links">
          <a class="footer-github" href="https://github.com/frip-fans/fripsi.de" target="_blank" rel="external noopener noreferrer"><Icon name="github" />{t(locale, "footer.github")}</a>
          <button class="footer-notice" type="button" data-open-site-notice>{t(locale, "footer.unofficial")}</button>
          <div class="footer-language"><LanguageSwitcher /></div>
        </div>
      )}
    </footer>
    {chatDock && <AdminChatDock state={chatDock} />}
  </body>
</html>

<script>
  import { setupAdminChatDock } from "../lib/chat-dock-client";
  import { setupQuizLauncher } from "../lib/quiz-launcher";
  setupAdminChatDock();
  setupQuizLauncher();
  document.addEventListener("astro:page-load", () => setupQuizLauncher());
  import "../lib/public-navigation";
  import { setupPageEntryTransitions } from "../lib/page-entry-navigation";
  setupPageEntryTransitions();

  // Record the exact source URL (including filters and fragment) before opening a music detail.
  document.addEventListener("click", event => {
    const anchor = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[href]") : null;
    if (!anchor) return;
    const target = new URL(anchor.href, location.origin);
    if (target.origin !== location.origin || !/^\/music\/(lives|songs|releases)\/[^/]+\/?$/.test(target.pathname)) return;
    try { sessionStorage.setItem("music:detail-source", JSON.stringify({ destination: target.pathname, source: location.href })); } catch { /* optional navigation context */ }
  });

  import "../lib/event-navigation-client";
  import { setupMenuIndicator } from "../lib/menu-indicator";
  import { setupMenuLoading } from "../lib/menu-loading";
  let navigationController: AbortController | undefined;
  let cleanupNavigation: (() => void) | undefined;
  let menuExitOverlay: HTMLElement | undefined;
  const setupNavigation = () => {
    cleanupNavigation?.();
    navigationController?.abort();
    navigationController = new AbortController();
    const { signal } = navigationController;
    const groups = [...document.querySelectorAll<HTMLDetailsElement>("[data-nav-group]")];
    const closeGroups = () => groups.forEach(group => { group.open = false; });
    document.addEventListener("click", event => {
      if (event.target instanceof Node) groups.forEach(group => {
        if (!group.contains(event.target as Node)) group.open = false;
      });
    }, { signal });
    document.addEventListener("keydown", event => {
      if (event.key !== "Escape") return;
      const openGroup = groups.find(group => group.open);
      if (!openGroup) return;
      event.preventDefault();
      closeGroups();
      openGroup.querySelector("summary")?.focus();
    }, { signal });
    groups.forEach(group => group.addEventListener("focusout", event => {
      const next = event.relatedTarget as Node | null;
      // macOS Safari never focuses a clicked link, so pressing a submenu item blurs to
      // nothing; closing then would hide the item before its click lands. Outside
      // clicks are handled by the document listener above.
      if (next ? !group.contains(next) : !group.matches(":hover")) group.open = false;
    }, { signal }));
    document.addEventListener("astro:before-swap", closeGroups, { signal });
    const desktopMenu = document.querySelector<HTMLElement>("[data-desktop-menu]");
    if (desktopMenu) { setupMenuLoading(desktopMenu, signal); setupMenuIndicator(desktopMenu, signal); }
    const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
    const trigger = document.querySelector<HTMLButtonElement>("[data-menu-open]");
    const close = document.querySelector<HTMLButtonElement>("[data-menu-close]");
    if (!menu || !trigger || !close) return;
    const clearMenuLoading = setupMenuLoading(menu, signal);
    const resetMenuIndicator = setupMenuIndicator(menu, signal);
    const setOpenState = (open: boolean) => {
      trigger.setAttribute("aria-expanded", String(open));
      document.documentElement.classList.toggle("mobile-menu-open", open);
    };
    let background: { element: HTMLElement; inert: boolean }[] = [];
    let menuAnimation: Animation | undefined;
    let closing = false;
    let menuCloseTimer: number | undefined;
    const reducedMenuMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const finishClose = (restoreFocus: boolean) => {
      clearMenuLoading();
      window.clearTimeout(menuCloseTimer);
      menuCloseTimer = undefined;
      menuAnimation?.cancel();
      menuAnimation = undefined;
      closing = false;
      const wasOpen = !menu.hidden;
      menu.hidden = true;
      background.forEach(({ element, inert }) => { element.inert = inert; });
      background = [];
      setOpenState(false);
      if (restoreFocus && wasOpen && trigger.getClientRects().length > 0) trigger.focus();
    };
    const closeMenu = (restoreFocus = true, animate = true) => {
      if (closing && animate) return;
      if (!animate || menu.hidden || reducedMenuMotion.matches) { finishClose(restoreFocus); return; }
      const current = getComputedStyle(menu);
      const from = { opacity: current.opacity, transform: current.transform };
      menuAnimation?.cancel();
      closing = true;
      const animation = menuAnimation = menu.animate([from, { opacity: 0, transform: "translateY(10px)" }], { duration: 140, easing: "ease-in", fill: "forwards" });
      animation.addEventListener("finish", () => { if (menuAnimation === animation) finishClose(restoreFocus); }, { once: true });
      // Backgrounded renderers can pause animation events; never leave a closing
      // menu trapping focus or scrolling after its short exit has elapsed.
      menuCloseTimer = window.setTimeout(() => { if (menuAnimation === animation) finishClose(restoreFocus); }, 180);
    };
    cleanupNavigation = () => closeMenu(false, false);
    reducedMenuMotion.addEventListener("change", () => {
      if (reducedMenuMotion.matches) menuAnimation?.finish();
    }, { signal });
    trigger.addEventListener("click", () => {
      if (!menu.hidden) return;
      menuExitOverlay?.remove();
      menuExitOverlay = undefined;
      menu.hidden = false;
      resetMenuIndicator();
      background = [...document.querySelectorAll<HTMLElement>(".site-header, main, footer")].map(element => ({ element, inert: element.inert }));
      background.forEach(({ element }) => { element.inert = true; });
      setOpenState(true);
      if (!reducedMenuMotion.matches) {
        menuAnimation = menu.animate([{ opacity: 0, transform: "translateY(12px)" }, { opacity: 1, transform: "translateY(0)" }], { duration: 180, easing: "ease-out" });
      }
      close.focus();
    }, { signal });
    close.addEventListener("click", () => closeMenu(), { signal });
    menu.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        event.preventDefault();
        closeMenu();
        return;
      }
      if (event.key !== "Tab") return;
      const items = [...menu.querySelectorAll<HTMLElement>('a[href], button:not(:disabled), select:not(:disabled), summary, [tabindex="0"]')].filter(item => item.getClientRects().length > 0);
      const first = items[0], last = items.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault(); last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault(); first?.focus();
      }
    }, { signal });
    // Keep the menu covering the outgoing page while the router (or browser)
    // loads the destination. Same-document links still need to dismiss it.
    menu.querySelectorAll<HTMLAnchorElement>("a[href]").forEach(link => {
      link.addEventListener("click", event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || (link.target && link.target !== "_self")) return;
        const target = new URL(link.href, location.href);
        if (target.origin === location.origin && target.pathname === location.pathname && target.search === location.search) closeMenu(false);
      }, { signal });
    });
    const mobile = matchMedia("(max-width: 760px)");
    mobile.addEventListener("change", () => { if (!mobile.matches) closeMenu(false, false); }, { signal });
    // The old DOM is detached now: cleanup cannot reveal the outgoing page.
    document.addEventListener("astro:after-swap", () => {
      // Fade a non-interactive copy over the NEW page. The outgoing page has
      // already been replaced, so closing the menu cannot reveal stale content.
      if (!menu.hidden && !reducedMenuMotion.matches) {
        menuExitOverlay?.remove();
        const overlay = menu.cloneNode(true) as HTMLElement;
        for (const element of [overlay, ...overlay.querySelectorAll("*")]) {
          element.removeAttribute("id");
          for (const attribute of [...element.attributes]) {
            if (attribute.name.startsWith("data-") && !attribute.name.startsWith("data-astro-")) element.removeAttribute(attribute.name);
          }
        }
        const nextMenuLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-mobile-menu] a")];
        overlay.querySelectorAll<HTMLAnchorElement>("a").forEach((link, index) => {
          if (nextMenuLinks[index]?.getAttribute("aria-current") === "page") {
            link.setAttribute("aria-current", "page");
          } else link.removeAttribute("aria-current");
        });
        overlay.dataset.menuExitOverlay = "true";
        overlay.removeAttribute("role");
        overlay.removeAttribute("aria-modal");
        overlay.setAttribute("aria-hidden", "true");
        overlay.inert = true;
        menuExitOverlay = overlay;
        document.body.appendChild(overlay);
        const animation = overlay.animate([{ opacity: 1, transform: "translateY(0)" }, { opacity: 0, transform: "translateY(10px)" }], { duration: 140, easing: "ease-in", fill: "forwards" });
        const remove = () => { overlay.remove(); if (menuExitOverlay === overlay) menuExitOverlay = undefined; };
        animation.addEventListener("finish", remove, { once: true });
        animation.addEventListener("cancel", remove, { once: true });
        window.setTimeout(remove, 220);
      }
      closeMenu(false, false);
    }, { signal });
    window.addEventListener("pageshow", event => { if (event.persisted) closeMenu(false, false); }, { signal });
    setOpenState(false);
  };
  setupNavigation();
  document.addEventListener("astro:page-load", setupNavigation);

  let cleanupBackground: (() => void) | undefined;
  const setupBackground = () => {
    cleanupBackground?.();
    const controller = new AbortController();
    const { signal } = controller;
    const backgroundRotator = document.querySelector<HTMLElement>("[data-background-rotator]");
    const backgroundSlides = [...(backgroundRotator?.querySelectorAll<HTMLElement>("[data-background-slide]") ?? [])];
    const reducedBackgroundMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let activeBackgroundIndex = 0;
    let backgroundTimer: number | undefined;

    const showBackground = (index: number) => {
      backgroundSlides.forEach((slide, slideIndex) => slide.classList.toggle("is-active", slideIndex === index));
      activeBackgroundIndex = index;
    };

    const stopBackgroundRotation = () => {
      if (backgroundTimer !== undefined) window.clearInterval(backgroundTimer);
      backgroundTimer = undefined;
    };

    const startBackgroundRotation = () => {
      stopBackgroundRotation();
      if (backgroundSlides.length > 1 && !reducedBackgroundMotion.matches && !document.hidden && document.documentElement.dataset.homeMotionPaused !== "true") {
        backgroundTimer = window.setInterval(() => {
          showBackground((activeBackgroundIndex + 1) % backgroundSlides.length);
        }, 16000);
      }
    };

    reducedBackgroundMotion.addEventListener("change", startBackgroundRotation, { signal });
    document.addEventListener("visibilitychange", startBackgroundRotation, { signal });
    document.addEventListener("home-motion-change", () => {
      if (document.documentElement.dataset.homeMotionPaused === "true") {
        backgroundSlides.forEach(slide => slide.getAnimations().forEach(animation => animation.finish()));
      }
      startBackgroundRotation();
    }, { signal });
    startBackgroundRotation();
    cleanupBackground = () => { stopBackgroundRotation(); controller.abort(); };
  };
  document.addEventListener("astro:before-swap", () => cleanupBackground?.());
  document.addEventListener("astro:page-load", setupBackground);
  setupBackground();
</script>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #07101c;
    --safe-area-top: env(safe-area-inset-top, 0px);
    --panel: rgba(12, 25, 43, .82);
    --panel-solid: #0d1b2d;
    --line: rgba(173, 206, 231, .16);
    --text: #eff8ff;
    --muted: #9db2c5;
    --accent: rgb(234, 129, 66);
    --accent-rgb: 234, 129, 66;
    --purple: #9c86ff;
    --danger: #ff8498;
