---
interface Props {
  title?: string;
  description?: string;
  admin?: boolean;
}
import { getEnv } from "../lib/env";
import Icon from "../components/Icon.astro";
import moonBackground from "../../../../images/A_New_View_of_the_Moon.jpg?url";

const {
  title = "fripSide Fan Site",
  description = "fripsi.de 是由粉丝维护的非官方 fripSide 活动日历与历史档案。",
  admin = false
} = Astro.props;
const current = Astro.url.pathname;
const siteName = admin ? "Calendar Studio" : "fripSide Fan Site";
const canonicalBase = getEnv().SITE_URL || Astro.url.origin;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07101c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, canonicalBase)} />
    <title>{title === siteName ? title : `${title} · ${siteName}`}</title>
  </head>
  <body class:list={{ admin }}>
    <div class="moon-backdrop" style={`--moon-image: url("${moonBackground}")`} aria-hidden="true"></div>
    <div class="ambient ambient-a"></div>
    <div class="ambient ambient-b"></div>
    <header class="site-header">
      <a class="brand" href={admin ? "/admin" : "/"} aria-label={siteName}>
        {admin ? (
          <>
            <span class="brand-mark">F</span>
            <span><b>{siteName}</b><small>protected workspace</small></span>
          </>
        ) : (
          <>
            <img class="brand-logo" src="/fan-site-logo.svg" width="48" height="48" alt="" />
            <span><b>{siteName}</b><small>fripsi.de · unofficial</small></span>
          </>
        )}
      </a>
      <nav aria-label="主导航">
        {admin ? (
          <>
            <a class:list={{ active: current === "/admin" }} href="/admin">概览</a>
            <a class:list={{ active: current.startsWith("/admin/events") }} href="/admin/events">活动</a>
            <a class:list={{ active: current.startsWith("/admin/changes") }} href="/admin/changes">提案</a>
            <a class:list={{ active: current.startsWith("/admin/audit") }} href="/admin/audit">审计</a>
            <a class:list={{ active: current.startsWith("/admin/data") }} href="/admin/data">数据</a>
            <a href="/" target="_blank">查看网站 <Icon name="box-arrow-up-right" /></a>
          </>
        ) : (
          <>
            <a class:list={{ active: current === "/" }} href="/">首页</a>
            <a class:list={{ active: current.startsWith("/calendar") }} href="/calendar">日历</a>
            <a class:list={{ active: current.startsWith("/archive") }} href="/archive">归档</a>
            <a class:list={{ active: current.startsWith("/about") }} href="/about">关于</a>
          </>
        )}
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <span>Fan-made, independent, and source-linked.</span>
      <span>非 fripSide 官方网站</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #07101c;
    --panel: rgba(12, 25, 43, .82);
    --panel-solid: #0d1b2d;
    --line: rgba(173, 206, 231, .16);
    --text: #eff8ff;
    --muted: #9db2c5;
    --accent: rgb(234, 129, 66);
    --accent-rgb: 234, 129, 66;
    --purple: #9c86ff;
    --danger: #ff8498;
    --warning: #ffc56c;
    --radius: 20px;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: var(--bg);
    color: var(--text);
  }
  * { box-sizing: border-box; }
  html { min-width: 320px; background: var(--bg); scroll-behavior: smooth; scrollbar-gutter: stable; }
  body { position: relative; isolation: isolate; margin: 0; min-height: 100vh; background: transparent; }
  a { color: inherit; }
  button, input, select, textarea { font: inherit; }
  button, .button { cursor: pointer; }
  .moon-backdrop { position: fixed; z-index: -3; inset: 0; pointer-events: none; background-image: radial-gradient(ellipse 48% 46% at 20% 30%, rgba(7,16,28,.9) 0%, rgba(7,16,28,.72) 48%, rgba(7,16,28,.2) 78%, transparent 100%), linear-gradient(180deg, rgba(7,16,28,.3) 0%, rgba(7,16,28,.44) 52%, rgba(7,16,28,.86) 88%, var(--bg) 100%), linear-gradient(90deg, rgba(7,16,28,.18), rgba(7,16,28,.02) 52%, rgba(7,16,28,.24)), var(--moon-image); background-position: center top; background-size: cover; background-repeat: no-repeat; filter: saturate(.76) contrast(1.08) brightness(1.08); }
  .ambient { position: fixed; width: 28rem; height: 28rem; border-radius: 50%; filter: blur(110px); opacity: .12; pointer-events: none; z-index: -1; }
  .ambient-a { background: var(--accent); left: -16rem; top: 12rem; }
  .ambient-b { background: var(--purple); right: -18rem; top: 35rem; }
  .site-header { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; min-height: 88px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; border-bottom: 1px solid var(--line); }
  .brand { display: flex; align-items: center; gap: .8rem; text-decoration: none; letter-spacing: -.02em; }
  .brand-logo { display: block; width: 3rem; height: 3rem; object-fit: contain; }
  .brand-mark { display: grid; place-items: center; width: 2.55rem; height: 2.55rem; border: 1px solid rgba(var(--accent-rgb), .5); border-radius: 12px; background: linear-gradient(145deg, rgba(var(--accent-rgb), .16), rgba(156,134,255,.2)); color: var(--accent); font-weight: 900; font-size: 1.25rem; }
  .brand b, .brand small { display: block; }
  .brand small { color: var(--muted); font-size: .67rem; margin-top: .15rem; text-transform: uppercase; letter-spacing: .15em; }
  nav { display: flex; align-items: center; gap: .2rem; flex-wrap: wrap; }
  nav a { text-decoration: none; color: var(--muted); padding: .6rem .72rem; border-radius: 9px; font-size: .92rem; }
  nav a:hover, nav a.active { color: var(--text); background: rgba(255,255,255,.06); }
  nav a.active { box-shadow: inset 0 -1px var(--accent); }
  main { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; padding: 3rem 0 6rem; min-height: calc(100vh - 180px); }
  footer { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; border-top: 1px solid var(--line); padding: 1.5rem 0 2.5rem; display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); font-size: .78rem; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { font-size: clamp(2.4rem, 7vw, 5.5rem); line-height: .98; letter-spacing: -.055em; }
  h2 { font-size: clamp(1.4rem, 3vw, 2rem); letter-spacing: -.025em; }
  .eyebrow { color: var(--accent); text-transform: uppercase; letter-spacing: .18em; font-weight: 700; font-size: .72rem; }
  .lede { color: var(--muted); font-size: clamp(1rem, 2vw, 1.22rem); line-height: 1.75; max-width: 43rem; }
  .panel { border: 1px solid var(--line); background: var(--panel); border-radius: var(--radius); padding: clamp(1rem, 3vw, 1.6rem); backdrop-filter: blur(18px); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin: 3.5rem 0 1.2rem; }
  .section-heading h2, .section-heading p { margin: 0; }
  .muted { color: var(--muted); }
  .button, button { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; min-height: 42px; padding: .65rem 1rem; color: #07101c; background: var(--accent); border: 0; border-radius: 10px; text-decoration: none; font-weight: 750; }
  .button.secondary, button.secondary { color: var(--text); background: rgba(255,255,255,.07); border: 1px solid var(--line); }
  .button.danger, button.danger { color: #310812; background: var(--danger); }
  .button:hover, button:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .tag { display: inline-flex; align-items: center; padding: .25rem .55rem; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font-size: .72rem; letter-spacing: .04em; }
  .tag.live { color: var(--accent); border-color: rgba(var(--accent-rgb), .3); }
  .tag.cancelled { color: var(--danger); border-color: rgba(255,132,152,.35); }
  .tag.postponed { color: var(--warning); border-color: rgba(255,197,108,.35); }
  .empty { text-align: center; padding: 4rem 1rem; color: var(--muted); }
  .stack { display: grid; gap: 1rem; }
  .actions { display: flex; align-items: center; gap: .65rem; flex-wrap: wrap; }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  th { text-align: left; color: var(--muted); font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; }
  th, td { padding: .8rem .65rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  tr:last-child td { border-bottom: 0; }
  td a { color: var(--accent); }
  .table-wrap { overflow-x: auto; }
  label { display: grid; gap: .4rem; color: var(--muted); font-size: .82rem; }
  input, select, textarea { width: 100%; color: var(--text); background: rgba(4,11,20,.72); border: 1px solid var(--line); border-radius: 10px; padding: .72rem .8rem; outline: 0; }
  input:focus, select:focus, textarea:focus { border-color: rgba(var(--accent-rgb), .55); box-shadow: 0 0 0 3px rgba(var(--accent-rgb), .08); }
  textarea { min-height: 110px; resize: vertical; }
  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .form-grid .wide { grid-column: 1 / -1; }
  .notice { border-left: 3px solid var(--warning); padding: .8rem 1rem; color: #f6dfb9; background: rgba(255,197,108,.08); border-radius: 0 10px 10px 0; }
  .error { border-left-color: var(--danger); color: #ffd9df; background: rgba(255,132,152,.08); }
  code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  pre { overflow: auto; color: #cde5f5; background: #050c15; border: 1px solid var(--line); border-radius: 12px; padding: 1rem; }
  @media (max-width: 760px) {
    .site-header { align-items: flex-start; padding: 1rem 0; flex-direction: column; gap: .8rem; }
    nav { width: 100%; overflow-x: auto; flex-wrap: nowrap; }
    nav a { white-space: nowrap; }
    main { padding-top: 2rem; }
    .form-grid { grid-template-columns: 1fr; }
    footer { flex-direction: column; }
  }
</style>
