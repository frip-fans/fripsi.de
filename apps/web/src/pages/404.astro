---
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon.astro";
import { getLocale, t } from "../lib/i18n";
const locale = getLocale(Astro.request);
---
<SiteLayout title={t(locale, "notFound.title")}>
  <section class="empty-state">
    <p class="eyebrow">404 · Signal lost</p>
    <h1>{t(locale, "notFound.heading")}</h1>
    <p class="lede">{t(locale, "notFound.copy")}</p>
    <a class="button" href="/"><Icon name="house-door" />{t(locale, "notFound.home")}</a>
  </section>
</SiteLayout>
<style>.empty-state { min-height: 55vh; display: grid; place-content: center; justify-items: start; }</style>
