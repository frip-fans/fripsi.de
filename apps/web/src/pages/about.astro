---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getLocale, t } from "../lib/i18n";
const locale = getLocale(Astro.request);
---
<SiteLayout title={t(locale, "about.title")}>
  <section class="about">
    <div>
      <p class="eyebrow">About</p>
      <h1><span class="domain-name">fripSi<span>.de</span></span><span class="fan-title">Fan Site</span></h1>
    </div>
    <div class="copy">
      <p class="lede">{t(locale, "about.intro")}</p>
      <h2>{t(locale, "about.rightsTitle")}</h2>
      <p>{t(locale, "about.rights")}</p>
    </div>
  </section>
</SiteLayout>

<style>
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem, 9vw, 9rem); align-items: start; }
  .about h1 { display: grid; gap: .04em; }
  .domain-name { color: #d8e4ed; }
  .domain-name span { color: var(--accent); }
  .fan-title { color: rgba(157,178,197,.34); }
  @supports (-webkit-text-stroke: 1px currentColor) {
    .fan-title { color: transparent; -webkit-text-stroke: 1.5px rgba(200,218,232,.72); }
  }
  .copy { padding-top: 3rem; line-height: 1.8; }
  .copy h2 { margin-top: 3rem; font-size: 1.1rem; color: var(--accent); }
  .copy p:not(.lede) { color: var(--muted); }
  @media (max-width: 780px) { .about { grid-template-columns: 1fr; gap: 0; } }
</style>
