---
import { listChangeSets } from "@frip-fan/core";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../lib/env";
const status = Astro.url.searchParams.get("status") ?? undefined;
const changes = await listChangeSets(getEnv().DB, status, 200);
---
<SiteLayout title="变更提案" admin>
  <p class="eyebrow">Change sets</p><h1 class="page-title">变更提案</h1>
  <div class="filters">{["", "proposed", "published", "discarded", "failed"].map((value) => <a class:list={{ active: (status ?? "") === value }} href={value ? `/admin/changes?status=${value}` : "/admin/changes"}>{value || "全部"}</a>)}</div>
  <div class="panel table-wrap"><table><thead><tr><th>状态</th><th>操作</th><th>原因</th><th>创建人</th><th>时间</th></tr></thead><tbody>
    {changes.map((change) => <tr><td><span class="tag">{change.status}</span></td><td><a href={`/admin/changes/${change.id}`}>{change.operation}</a></td><td>{change.reason}</td><td>{change.created_by}<small>{change.created_via}</small></td><td>{change.created_at.slice(0,16).replace("T"," ")}</td></tr>)}
  </tbody></table>{!changes.length && <div class="empty">没有提案。</div>}</div>
</SiteLayout>
<style>.page-title{font-size:clamp(2.5rem,6vw,4.5rem);margin-bottom:2rem}.filters{display:flex;gap:.4rem;margin-bottom:1rem}.filters a{padding:.5rem .8rem;border:1px solid var(--line);border-radius:999px;text-decoration:none;color:var(--muted);font-size:.8rem}.filters a.active{color:var(--accent);border-color:rgba(var(--accent-rgb),.4)}td small{display:block;color:var(--muted)}</style>
