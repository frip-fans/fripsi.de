---
import { BACKUP_COUNTED_TABLES, countBackupTables, countOfficialSyncRuns, getOfficialSyncOverview, listOfficialSyncRuns, listOfficialSyncSources } from "@frip-fan/core";
import AdminPageHeader from "../../components/AdminPageHeader.astro";
import Icon from "../../components/Icon.astro";
import Pagination from "../../components/Pagination.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { CHANGE_STATUS_LABELS, formatTimestamp } from "../../lib/change-review";
import { getEnv } from "../../lib/env";
import {
  backupHealth, formatAge, formatBytes, readBackupStatus, syncErrorLabel, syncHealth, syncRunTone,
  SYNC_NOTIFICATION_LABELS, SYNC_RUN_STATUS_LABELS,
} from "../../lib/ops-status";

const PAGE_SIZE = 20;
const requestedPageValue = Astro.url.searchParams.get("page") ?? "1";
const requestedPage = /^\d+$/.test(requestedPageValue) ? Math.max(1, Number(requestedPageValue)) : 1;

const env = getEnv();
const db = env.DB;
const now = new Date();
const backup = await readBackupStatus(env.BACKUP_STATUS_FILE);
const backupState = backupHealth(backup, now);
const snapshot = backup.state === "found" ? backup.status.last_success : null;
const liveCounts = await countBackupTables(db);
const overview = await getOfficialSyncOverview(db, now);
const syncState = syncHealth(overview, now);
const totalRuns = await countOfficialSyncRuns(db);
const totalPages = Math.max(1, Math.ceil(totalRuns / PAGE_SIZE));
const currentPage = Math.min(requestedPage, totalPages);
const runs = await listOfficialSyncRuns(db, PAGE_SIZE, (currentPage - 1) * PAGE_SIZE);
const sources = await listOfficialSyncSources(db, 8);

const tableLabels: Record<(typeof BACKUP_COUNTED_TABLES)[number], string> = {
  events: "活动", songs: "歌曲", releases: "专辑", setlists: "Setlist", change_sets: "提案", audit_logs: "审计记录",
};
const recent = overview.recent_runs;
const recentTotal = Object.values(recent).reduce((sum, value) => sum + value, 0);
const usd = (value: number | null) => value == null ? "—" : `$${value.toFixed(value < 0.1 ? 3 : 2)}`;
const outcomeOrder = ["published", "proposed", "discarded", "rejected", "failed"];
---
<SiteLayout title="数据与运行状态" admin>
  <AdminPageHeader title="数据与运行状态" description="数据库备份和官方同步任务的运行情况，以及数据导出。时间均为 UTC。" />

  <div class="status-grid">
    <section class="panel status" aria-labelledby="backup-heading">
      <header>
        <h2 id="backup-heading">数据库备份</h2>
        <span class:list={["tag", `tone-${backupState.tone}`]}>{backupState.label}</span>
      </header>
      <p class="status-detail">{backupState.detail}</p>
      {backup.state === "found" && (
        <dl class="facts">
          <div><dt>最近成功</dt><dd>{snapshot ? <>{formatTimestamp(snapshot.created_at)}<small>{formatAge(snapshot.created_at, now)}</small></> : "—"}</dd></div>
          <div><dt>最近尝试</dt><dd>{formatTimestamp(backup.status.last_attempt_at)}<small>{backup.status.last_attempt_ok ? "成功" : `失败${backup.status.last_error ? ` · ${backup.status.last_error}` : ""}`}</small></dd></div>
          {snapshot && <div><dt>快照大小</dt><dd>{formatBytes(snapshot.sqlite_bytes)}<small>加密上传 {formatBytes(snapshot.encrypted_bytes)}</small></dd></div>}
          {snapshot && <div><dt>应用版本</dt><dd><code>{snapshot.app_commit_sha?.slice(0, 7) ?? "—"}</code><small>{snapshot.migration_count ?? "—"} 个迁移{snapshot.latest_migration ? `，到 ${snapshot.latest_migration.replace(/\.sql$/, "")}` : ""}</small></dd></div>}
        </dl>
      )}
      {snapshot && (
        <>
          <table class="counts">
            <thead><tr><th>行数</th>{BACKUP_COUNTED_TABLES.map((table) => <th class="num">{tableLabels[table]}</th>)}</tr></thead>
            <tbody>
              <tr><th scope="row">现在</th>{BACKUP_COUNTED_TABLES.map((table) => <td class="num">{liveCounts[table]}</td>)}</tr>
              <tr><th scope="row">备份时</th>{BACKUP_COUNTED_TABLES.map((table) => <td class="num">{snapshot.table_counts[table] ?? "—"}</td>)}</tr>
            </tbody>
          </table>
          {snapshot.object_key && <p class="object-key"><span>R2 对象</span><code>{snapshot.object_key}</code></p>}
        </>
      )}
      <p class="status-note">每天 04:00（新加坡时间）由主机定时器加密上传到私有 R2 桶，保留 180 天。这里显示的是备份任务自己写下的结果；远端对象的独立核对在监控主机上，失败时会另发通知。</p>
    </section>

    <section class="panel status" aria-labelledby="sync-heading">
      <header>
        <h2 id="sync-heading">官方同步</h2>
        <span class:list={["tag", `tone-${syncState.tone}`]}>{syncState.label}</span>
      </header>
      <p class="status-detail">{syncState.detail}</p>
      <dl class="facts">
        <div><dt>最近任务</dt><dd>{overview.latest_run ? <>{formatTimestamp(overview.latest_run.created_at)}<small>{formatAge(overview.latest_run.created_at, now)}</small></> : "—"}</dd></div>
        <div><dt>最近完成</dt><dd>{formatTimestamp(overview.last_completed_at)}<small>{overview.last_completed_at ? formatAge(overview.last_completed_at, now) : "还没有完成过"}</small></dd></div>
        <div><dt>近 30 天</dt><dd>{recentTotal} 次任务<small>{recentTotal ? `${recent.completed ?? 0} 次完成 · ${recent.failed ?? 0} 次失败` : "没有运行"}</small></dd></div>
        <div><dt>近 30 天费用</dt><dd>{usd(overview.recent_usd)}<small>按用量估算，以账单为准</small></dd></div>
        <div><dt>已抓取公告</dt><dd>{overview.sources.total} 篇<small>{overview.sources.unprocessed ? `${overview.sources.unprocessed} 篇有未处理的正文` : "正文都已处理"}</small></dd></div>
        <div><dt>最近抓取</dt><dd>{formatTimestamp(overview.sources.last_fetched_at)}<small>{overview.sources.last_fetched_at ? formatAge(overview.sources.last_fetched_at, now) : "还没有抓取过"}</small></dd></div>
        <div><dt>Bark 通知</dt><dd>{overview.notifications.waiting ? `${overview.notifications.waiting} 条待发送` : "没有积压"}<small>{overview.notifications.retrying
          ? `${overview.notifications.retrying} 条发送失败重试中${overview.notifications.last_error_code ? ` · ${overview.notifications.last_error_code}` : ""}`
          : overview.notifications.last_sent_at ? `上次送达 ${formatAge(overview.notifications.last_sent_at, now)}` : "还没有送达过"}</small></dd></div>
      </dl>
      <p class="status-note">主机定时器每 5 分钟运行一次：每个日本日历日最多启动一次任务，抓取官网公告并比较正文，有变化才调用模型。</p>
    </section>
  </div>

  <section class="block" aria-labelledby="sync-runs">
    <div class="block-head">
      <h2 id="sync-runs">同步任务</h2>
      <span class="muted">共 {totalRuns} 次，新的在前</span>
    </div>
    <div class="panel table-wrap">
      <table>
        <thead><tr><th>开始</th><th>状态</th><th>任务</th><th class="num">公告</th><th>变更</th><th class="num hide-sm">工具调用</th><th class="num hide-sm">费用</th><th class="hide-sm">通知</th></tr></thead>
        <tbody>
          {runs.map((run) => {
            const outcomes = outcomeOrder.filter((status) => run.outcomes[status]);
            const error = syncErrorLabel(run.error_code);
            const minutes = Math.max(0, Math.round((Date.parse(run.updated_at) - Date.parse(run.created_at)) / 60_000));
            return <tr>
              <td class="date">{formatTimestamp(run.created_at)}<small>{run.status === "completed" || run.status === "failed" ? `用时 ${minutes} 分钟` : formatAge(run.created_at, now)}</small></td>
              <td class="state">
                <span class:list={["tag", `tone-${syncRunTone(run)}`]}>{SYNC_RUN_STATUS_LABELS[run.status] ?? run.status}</span>
                {!run.auto_publish && <span class="tag off">仅提案</span>}
                {error && <small>{error}</small>}
                {run.status !== "failed" && run.attempts > 0 && <small>重试过 {run.attempts} 次</small>}
                {run.unresolved > 0 && <small>{run.unresolved} 项复核后未解决</small>}
              </td>
              <td class="run"><code>{run.id}</code>{run.summary && <small>{run.summary}</small>}</td>
              <td class="num">{run.articles || "—"}</td>
              <td>{outcomes.length
                ? <a class="outcomes" href="/admin/changes">{outcomes.map((status) => <span>{CHANGE_STATUS_LABELS[status] ?? status} {run.outcomes[status]}</span>)}</a>
                : <span class="muted">无</span>}</td>
              <td class="num hide-sm">{run.tool_calls || "—"}</td>
              <td class="num hide-sm">{usd(run.estimated_usd)}</td>
              <td class="hide-sm">{run.notification_status ? SYNC_NOTIFICATION_LABELS[run.notification_status] ?? run.notification_status : <span class="muted">—</span>}</td>
            </tr>;
          })}
        </tbody>
      </table>
      {!runs.length && <div class="empty">还没有同步任务。</div>}
    </div>
    <Pagination currentPage={currentPage} totalPages={totalPages} totalItems={totalRuns} itemLabel="次任务" anchor="sync-runs" />
  </section>

  <section class="block" aria-labelledby="sync-sources">
    <div class="block-head">
      <h2 id="sync-sources">最近抓取的公告</h2>
      <span class="muted">最近 {sources.length} 篇，共 {overview.sources.total} 篇</span>
    </div>
    <div class="panel table-wrap">
      <table>
        <thead><tr><th>抓取</th><th>公告</th><th class="hide-sm">发布日期</th><th>正文</th></tr></thead>
        <tbody>
          {sources.map((source) => <tr>
            <td class="date">{formatTimestamp(source.fetched_at)}<small>{formatAge(source.fetched_at, now)}</small></td>
            <td><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a></td>
            <td class="date hide-sm">{source.published_date ?? "—"}</td>
            <td>{source.processed ? <span class="tag tone-ok">已处理</span> : <span class="tag tone-warn">未处理</span>}</td>
          </tr>)}
        </tbody>
      </table>
      {!sources.length && <div class="empty">还没有抓取过公告。</div>}
    </div>
  </section>

  <section class="block" aria-labelledby="export-heading">
    <div class="block-head"><h2 id="export-heading">导出</h2></div>
    <div class="panel export">
      <div>
        <strong>活动 CSV</strong>
        <p class="muted">全部 {liveCounts.events} 条活动，含会场、地区、渠道和来源链接。UTF-8 带 BOM，可直接用 Excel 打开。</p>
      </div>
      <a class="button" href="/api/admin/export.csv"><Icon name="download" />下载 CSV</a>
    </div>
    <details class="panel legacy">
      <summary>Notion 一次性迁移</summary>
      <p class="muted">把 Notion 导出的 CSV 放入 <code>data/raw/</code>，运行仓库脚本先生成核验报告；不会把 Notion 设为运行时依赖。</p>
      <pre>npm run import:notion -- data/raw/export.csv</pre>
    </details>
  </section>
</SiteLayout>
<style>
  .status-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; align-items: start; }
  .status header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .status h2, .block-head h2 { margin: 0; font-size: 1.05rem; }
  .status-detail { margin: .6rem 0 0; font-size: .9rem; line-height: 1.6; }
  .status-note { margin: 1rem 0 0; padding-top: .8rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .78rem; line-height: 1.6; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem 1.25rem; margin: 1rem 0 0; }
  .facts div { min-width: 0; }
  .facts dt { color: var(--muted); font-size: .74rem; }
  .facts dd { margin: .15rem 0 0; font-size: .92rem; font-variant-numeric: tabular-nums; }
  .facts small { display: block; margin-top: .1rem; color: var(--muted); font-size: .76rem; overflow-wrap: anywhere; }
  .counts { margin-top: 1rem; font-size: .8rem; }
  .counts th, .counts td { padding: .35rem .5rem; }
  .counts tbody th { color: var(--muted); font-weight: 500; text-align: left; white-space: nowrap; }
  .counts tbody tr:last-child th { border-bottom: 0; }
  .object-key { display: grid; gap: .2rem; margin: .9rem 0 0; }
  .object-key span { color: var(--muted); font-size: .74rem; }
  .object-key code, .run code { font-size: .72rem; overflow-wrap: anywhere; }
  .tag.tone-ok { color: #9be6b4; border-color: rgba(120,220,160,.45); }
  .tag.tone-warn { color: #ffd39a; border-color: rgba(255,190,110,.45); }
  .tag.tone-error { color: var(--danger); border-color: rgba(255,132,152,.5); }
  .block { margin-top: 1.75rem; }
  .block-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: .6rem; }
  .block-head .muted { font-size: .8rem; }
  .run { min-width: 13rem; }
  .state { min-width: 8rem; }
  .outcomes { display: flex; flex-wrap: wrap; gap: .1rem .7rem; font-weight: 500; }
  .outcomes span { white-space: nowrap; }
  .run small { max-width: 34rem; line-height: 1.5; }
  .export { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .export p { margin: .25rem 0 0; font-size: .84rem; }
  .legacy { margin-top: .75rem; }
  .legacy summary { cursor: pointer; color: var(--muted); font-size: .86rem; }
  .legacy p { margin: .7rem 0 .5rem; font-size: .84rem; }
  .legacy pre { margin: 0; overflow-x: auto; }
  @media (max-width: 1000px) { .status-grid { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .export { flex-direction: column; align-items: stretch; }
    .counts { display: block; overflow-x: auto; }
  }
</style>
