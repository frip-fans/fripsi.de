---
import { getEventById } from "@frip-fan/core";
import EventForm from "../../../components/EventForm.astro";
import Icon from "../../../components/Icon.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../lib/env";

const event = await getEventById(getEnv().DB, Astro.params.id!);
if (!event) return Astro.redirect("/admin/events", 302);
const actor = Astro.locals.actor!;
const canWrite = actor.scopes.includes("events:publish");
const saved = Astro.url.searchParams.get("saved") === "1";
---
<SiteLayout title={event.title} admin>
  <a class="muted back-link" href="/admin/events"><Icon name="arrow-left" />活动列表</a>
  <header class="edit-head"><div><p class="eyebrow">Event · v{event.version}</p><h1>{event.title}</h1></div>{event.published && !event.archived_at && <a class="button secondary" href={`/events/${event.slug}`} target="_blank">公开页面 <Icon name="box-arrow-up-right" /></a>}</header>
  {event.archived_at && <p class="notice">此活动已归档：{event.archived_at}</p>}
  {saved && <p class="notice success">活动已经保存并写入审计日志。</p>}
  <form class="panel event-form" method="post" action="/api/admin/events/save">
    <input type="hidden" name="id" value={event.id} />
    <input type="hidden" name="expected_version" value={event.version} />
    <input type="hidden" name="idempotency_key" value={`admin-save-${event.id}-${crypto.randomUUID()}`} />
    <EventForm event={event} submitLabel="保存活动" canWrite={canWrite} />
  </form>
  <section class="panel lifecycle">
    <div><h2>归档</h2><p class="muted">归档会立即从公开页面隐藏，同时保留数据和审计记录。</p></div>
    <div class="actions">
      <form method="post" action="/api/admin/events/save">
        <input type="hidden" name="intent" value="archive"/>
        <input type="hidden" name="id" value={event.id}/>
        <input type="hidden" name="expected_version" value={event.version}/>
        <input type="hidden" name="archived" value={event.archived_at ? "0" : "1"}/>
        <input type="hidden" name="idempotency_key" value={`archive-${event.id}-${crypto.randomUUID()}`}/>
        <button class:list={{ danger: !event.archived_at, secondary: Boolean(event.archived_at) }} disabled={!actor.scopes.includes("events:archive")}>{event.archived_at ? "恢复活动" : "归档活动"}</button>
      </form>
    </div>
  </section>
</SiteLayout>
<style>
  .edit-head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin: 1.5rem 0 2rem; }
  .back-link { display: inline-flex; align-items: center; gap: .35rem; text-decoration: none; }
  .edit-head h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin: 0; }
  .event-form { max-width: 900px; }
  .lifecycle { max-width: 900px; margin-top: 1rem; display: grid; gap: 1rem; }
  .lifecycle h2 { font-size: 1.1rem; margin-bottom: .35rem; }
  form { margin: 0; }
  button:disabled { opacity: .45; cursor: not-allowed; }
  .success { border-left-color: #79d9a6; color: #c9f8dc; background: rgba(78,190,127,.08); }
</style>
