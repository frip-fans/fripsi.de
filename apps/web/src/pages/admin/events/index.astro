---
import { categorySchema, countEvents, searchEvents } from "@frip-fan/core";
import Icon from "../../../components/Icon.astro";
import Pagination from "../../../components/Pagination.astro";
import AdminPageHeader from "../../../components/AdminPageHeader.astro";
import { EVENT_STATUS_LABELS } from "../../../lib/change-review";
import { categoryLabels } from "../../../lib/format";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../lib/env";

const PAGE_SIZE = 50;
const query = Astro.url.searchParams.get("q")?.trim() || undefined;
const categoryResult = categorySchema.safeParse(Astro.url.searchParams.get("category"));
const category = categoryResult.success ? categoryResult.data : undefined;
const includeArchived = Astro.url.searchParams.get("archived") === "1";
const requestedPageValue = Astro.url.searchParams.get("page") ?? "1";
const requestedPage = /^\d+$/.test(requestedPageValue) ? Math.max(1, Number(requestedPageValue)) : 1;
const filters = {
  query,
  categories: category ? [category] : undefined,
  include_archived: includeArchived,
};
const db = getEnv().DB;
const totalItems = await countEvents(db, filters);
const totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));
const currentPage = Math.min(requestedPage, totalPages);
const events = await searchEvents(db, {
  ...filters,
  limit: PAGE_SIZE,
  offset: (currentPage - 1) * PAGE_SIZE,
}, false, { newestFirst: true });
---
<SiteLayout title="活动管理" admin>
  <AdminPageHeader title="活动管理" description={`共 ${totalItems} 条${query || category || includeArchived ? "符合筛选条件的" : ""}活动，按日期从新到旧排列。`}>
    <a class="button" href="/admin/events/new"><Icon name="plus" />新活动</a>
  </AdminPageHeader>
  <form class="filters panel" method="get">
    <label>搜索<input type="search" name="q" value={query} placeholder="标题、场地、来源 URL" /></label>
    <label>分类<select name="category"><option value="">全部</option>{Object.keys(categoryLabels).map((value) => <option value={value} selected={category === value}>{categoryLabels[value as keyof typeof categoryLabels]}</option>)}</select></label>
    <label class="check"><input type="checkbox" name="archived" value="1" checked={includeArchived} /> 包含归档</label>
    <button type="submit"><Icon name="funnel" />筛选</button>
    {(query || category || includeArchived) && <a class="button secondary" href="/admin/events">清除</a>}
  </form>
  <div class="panel table-wrap">
    <table>
      <thead><tr><th>日期</th><th>活动</th><th class="hide-sm">分类</th><th class="hide-sm">状态</th><th>公开</th><th class="num hide-sm">版本</th></tr></thead>
      <tbody>
        {events.map((event) => <tr>
          <td class="date">{event.start_date}</td>
          <td><a href={`/admin/events/${event.id}`}>{event.title}</a><small>{event.location_label}</small></td>
          <td class="hide-sm nowrap">{categoryLabels[event.category]}</td>
          <td class="hide-sm"><span class:list={["tag", event.status]}>{EVENT_STATUS_LABELS[event.status]}</span></td>
          <td><span class:list={["tag", event.archived_at ? "warn" : event.published ? "live" : "off"]}>{event.archived_at ? "已归档" : event.published ? "公开" : "未公开"}</span></td>
          <td class="num hide-sm muted">v{event.version}</td>
        </tr>)}
      </tbody>
    </table>
    {!events.length && <div class="empty">没有符合条件的活动。</div>}
  </div>
  <Pagination currentPage={currentPage} totalPages={totalPages} totalItems={totalItems} itemLabel="条活动" />
</SiteLayout>
<style>
  .filters { display: grid; grid-template-columns: 1fr 180px auto auto auto; align-items: end; gap: .8rem; margin-bottom: 1rem; }
  .check { display: flex; align-items: center; gap: .4rem; min-height: 38px; white-space: nowrap; }
  .check input { width: auto; }
  @media (max-width: 760px) { .filters { grid-template-columns: 1fr; } }
</style>
