---
import AdminPageHeader from "../../../components/AdminPageHeader.astro";
import EventForm from "../../../components/EventForm.astro";
import { listAdministrativeAreas, listTours, listVenues } from "@frip-fan/core";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../lib/env";
const canWrite = Astro.locals.actor!.scopes.includes("events:publish");
const [areas, venueOptions, tours] = await Promise.all([listAdministrativeAreas(getEnv().DB), listVenues(getEnv().DB), listTours(getEnv().DB)]);
---
<SiteLayout title="新增活动" admin>
  <AdminPageHeader title="新增活动" description="人工后台保存会直接生效并写入审计日志；关闭公开显示可以先保存在后台。" back={{ href: "/admin/events", label: "活动列表" }} />
  <form class="panel event-form" method="post" action="/api/admin/events/save">
    <input type="hidden" name="idempotency_key" value={`admin-create-${crypto.randomUUID()}`} />
    <EventForm {areas} {venueOptions} {tours} canWrite={canWrite} submitLabel="创建活动" />
  </form>
</SiteLayout>
<style>.event-form { max-width: 900px; }</style>
