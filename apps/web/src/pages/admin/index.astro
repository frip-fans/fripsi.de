---
import { countChangeSetsByStatus, countEvents, dateInTimeZone, countAdminSetlists, getEventHeads, listAuditLogs, listChangeSets, searchEvents } from "@frip-fan/core";
import AdminPageHeader from "../../components/AdminPageHeader.astro";
import Icon from "../../components/Icon.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { auditActionLabel, auditTargetHref } from "../../lib/admin-labels";
import { CHANGE_OPERATION_LABELS, changeHeadline, formatTimestamp } from "../../lib/change-review";
import { getEnv } from "../../lib/env";

const db = getEnv().DB;
const today = dateInTimeZone();
const [proposed, changeCounts, upcoming, upcomingCount, eventCount, setlistCounts, audit] = await Promise.all([
  listChangeSets(db, "proposed", 6),
  countChangeSetsByStatus(db),
  searchEvents(db, { date_from: today, limit: 5 }, false),
  countEvents(db, { date_from: today }),
  countEvents(db, { include_archived: true }),
  countAdminSetlists(db),
  listAuditLogs(db, 8),
]);
const targets = await getEventHeads(db, proposed.map((change) => change.target_event_id ?? ""));
const pendingCount = changeCounts.proposed ?? 0;
// The union of the quick-filter buckets on the Setlist list.
const setlistFollowUps = setlistCounts.follow_up;
const actor = Astro.locals.actor!;
const canPublish = actor.scopes.includes("events:publish");
const canWriteMusic = actor.scopes.includes("music:write");
---
<SiteLayout title="概览" admin>
  <AdminPageHeader title="概览" description={`${actor.id} · ${canPublish ? "发布者" : "编辑者"}`}>
    {canWriteMusic && <a class="button secondary" href="/admin/music/setlists/new"><Icon name="plus" />新 Setlist</a>}
    <a class="button" href="/admin/events/new"><Icon name="plus" />新活动</a>
  </AdminPageHeader>

  <section class="stats" aria-label="待办与数据概况">
    <a class:list={["panel", { attention: pendingCount > 0 }]} href="/admin/changes"><span>待处理提案</span><strong>{pendingCount}</strong><small>{pendingCount > 0 ? "等待核对后发布或丢弃" : "全部处理完了"}</small></a>
    <a class="panel" href="/admin/events"><span>即将举行</span><strong>{upcomingCount}</strong><small>今天及以后的活动</small></a>
    <a class:list={["panel", { attention: setlistFollowUps > 0 }]} href="/admin/music/setlists"><span>待完善 Setlist</span><strong>{setlistFollowUps}</strong><small>未公开、不完整、待核验或没有歌曲</small></a>
    <a class="panel" href="/admin/events?archived=1"><span>活动总数</span><strong>{eventCount}</strong><small>含已归档 · Setlist {setlistCounts.all} 份</small></a>
  </section>

  <div class="columns">
    <section class="panel">
      <div class="block-head"><h2>待处理提案</h2><a href="/admin/changes">查看全部{pendingCount > proposed.length ? ` ${pendingCount} 条` : ""}</a></div>
      {proposed.length ? <ul class="rows">
        {proposed.map((change) => {
          const headline = changeHeadline(change, change.target_event_id ? targets.get(change.target_event_id) : undefined);
          return <li><a href={`/admin/changes/${change.id}`}>
            <span class="tag">{CHANGE_OPERATION_LABELS[change.operation] ?? change.operation}</span>
            <strong>{headline.title}</strong>
            {change.reason && <p>{change.reason}</p>}
            <small>{change.created_by} · {formatTimestamp(change.created_at)}</small>
          </a></li>;
        })}
      </ul> : <div class="empty">没有待处理提案。</div>}
    </section>

    <div class="side">
      <section class="panel">
        <div class="block-head"><h2>即将举行</h2><a href="/admin/events">全部活动</a></div>
        {upcoming.length ? <ul class="rows compact">
          {upcoming.map((event) => <li><a href={`/admin/events/${event.id}`}>
            <time datetime={event.start_date}>{event.start_date.slice(5)}</time>
            <strong>{event.display_title ?? event.title}</strong>
          </a></li>)}
        </ul> : <div class="empty">没有未来的活动。</div>}
      </section>
      <section class="panel">
        <div class="block-head"><h2>最近操作</h2><a href="/admin/audit">审计日志</a></div>
        {audit.length ? <ul class="rows compact">
          {audit.map((entry) => {
            const href = auditTargetHref(entry.target_type, entry.target_id);
            const body = <><time datetime={entry.created_at}>{formatTimestamp(entry.created_at).slice(5)}</time><strong>{auditActionLabel(entry.action)}</strong><small>{entry.actor_id}</small></>;
            return <li>{href ? <a href={href}>{body}</a> : <div>{body}</div>}</li>;
          })}
        </ul> : <div class="empty">还没有写操作。</div>}
      </section>
    </div>
  </div>
</SiteLayout>

<style>
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; margin-bottom: .75rem; }
  .stats a { display: grid; gap: .15rem; text-decoration: none; transition: border-color .15s; }
  .stats a:hover { border-color: rgba(var(--accent-rgb), .5); }
  .stats span { color: var(--muted); font-size: .8rem; }
  .stats strong { font-size: 1.9rem; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .stats small { color: var(--muted); font-size: .74rem; }
  .stats .attention strong { color: var(--accent); }
  .columns { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: .75rem; align-items: start; }
  .side { display: grid; gap: .75rem; }
  .block-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: .5rem; }
  .block-head h2 { margin: 0; }
  .block-head a { color: var(--accent); font-size: .8rem; text-decoration: none; }
  .block-head a:hover { text-decoration: underline; }
  .rows { margin: 0 -.5rem; padding: 0; list-style: none; }
  .rows li + li { border-top: 1px solid var(--line); }
  .rows a, .rows div { display: grid; gap: .25rem; justify-items: start; padding: .65rem .5rem; border-radius: 8px; text-decoration: none; }
  .rows a:hover { background: rgba(255,255,255,.04); }
  .rows strong { font-size: .9rem; font-weight: 600; overflow-wrap: anywhere; }
  .rows p { margin: 0; color: var(--muted); font-size: .82rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .rows small { color: var(--muted); font-size: .74rem; }
  .rows.compact a, .rows.compact div { grid-template-columns: 5.6rem minmax(0, 1fr) auto; align-items: baseline; gap: .6rem; padding-block: .5rem; }
  .rows.compact time { color: var(--muted); font-size: .78rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .rows.compact small { max-width: 11rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 900px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } .columns { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .rows.compact small { display: none; } .rows.compact a, .rows.compact div { grid-template-columns: 5.6rem minmax(0, 1fr); } }
</style>
