---
import AdminPageHeader from "../../../../components/AdminPageHeader.astro";
import { getMusicEditorOptions } from "@frip-fan/core";
import AdminMusicNav from "../../../../components/AdminMusicNav.astro";
import ReleaseAdminForm from "../../../../components/ReleaseAdminForm.astro";
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../../lib/env";

const options = await getMusicEditorOptions(getEnv().DB);
const canWrite = Astro.locals.actor!.scopes.includes("music:write");
---
<SiteLayout title="新增专辑" admin>
  <AdminMusicNav />
  <AdminPageHeader title="新增专辑" description="保存后直接写入音乐库；关闭“公开显示”可以先保存在后台。" back={{ href: "/admin/music/releases", label: "专辑列表" }} />
  <ReleaseAdminForm options={options} canWrite={canWrite} />
</SiteLayout>
