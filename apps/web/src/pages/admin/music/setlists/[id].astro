---
import AdminPageHeader from "../../../../components/AdminPageHeader.astro";
import { getAdminSetlistById, getMusicEditorOptions } from "@frip-fan/core";
import AdminMusicNav from "../../../../components/AdminMusicNav.astro";
import Icon from "../../../../components/Icon.astro";
import SetlistAdminForm from "../../../../components/SetlistAdminForm.astro";
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../../lib/env";

const [setlist, options] = await Promise.all([
  getAdminSetlistById(getEnv().DB, Astro.params.id!),
  getMusicEditorOptions(getEnv().DB),
]);
if (!setlist) return Astro.redirect("/admin/music/setlists", 302);
const canWrite = Astro.locals.actor!.scopes.includes("music:write");
const saved = Astro.url.searchParams.get("saved") === "1";
---
<SiteLayout title={`编辑 ${setlist.title || setlist.event_title}`} admin>
  <AdminMusicNav />
  <AdminPageHeader title={setlist.title || setlist.event_title} back={{ href: "/admin/music/setlists", label: "Setlist 列表" }}>
    <p class="muted" slot="meta">{setlist.start_date} · {setlist.performance_label}</p>
    {setlist.published && <a class="button secondary" href={`/music/lives/${setlist.id}`} target="_blank">公开页面 <Icon name="box-arrow-up-right" /></a>}
  </AdminPageHeader>
  {saved && <p class="notice success">Setlist 已经保存并写入审计日志。</p>}
  <SetlistAdminForm setlist={setlist} options={options} canWrite={canWrite} />
</SiteLayout>
