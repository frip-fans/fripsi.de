---
import AdminPageHeader from "../../../../components/AdminPageHeader.astro";
import { ADMIN_SETLIST_FOLLOW_UP_KEYS, countAdminSetlists, listAdminSetlists, type AdminSetlistFollowUp } from "@frip-fan/core";
import AdminMusicNav from "../../../../components/AdminMusicNav.astro";
import Icon from "../../../../components/Icon.astro";
import Pagination from "../../../../components/Pagination.astro";
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../../lib/env";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const canWrite = Astro.locals.actor!.scopes.includes("music:write");
const completenessLabels = { complete: "完整", partial: "部分", unknown: "未知" } as const;
const confidenceLabels = { official: "官方", reported: "现场记录", unverified: "待核验" } as const;
// Quick filters for the follow-up work an admin looks for: hidden drafts and lists that still need checking.
const followUpLabels: Record<AdminSetlistFollowUp, string> = { draft: "未公开", incomplete: "部分 / 未知", unverified: "待核验", empty: "没有歌曲" };
const requested = Astro.url.searchParams.get("show") ?? "";
const followUp = ADMIN_SETLIST_FOLLOW_UP_KEYS.find((key) => key === requested);
const PAGE_SIZE = 50;
const requestedPageValue = Astro.url.searchParams.get("page") ?? "1";
const requestedPage = /^\d+$/.test(requestedPageValue) ? Math.max(1, Number(requestedPageValue)) : 1;
const db = getEnv().DB;
const counts = await countAdminSetlists(db, query || undefined);
const filters = [
  { value: "", label: "全部", count: counts.all },
  ...ADMIN_SETLIST_FOLLOW_UP_KEYS.map((key) => ({ value: key as string, label: followUpLabels[key], count: counts[key] })),
];
const active = filters.find((filter) => filter.value === (followUp ?? ""))!;
const totalItems = active.count;
const totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));
const currentPage = Math.min(requestedPage, totalPages);
const setlists = await listAdminSetlists(db, query || undefined, PAGE_SIZE, { followUp, offset: (currentPage - 1) * PAGE_SIZE });
const hrefFor = (value: string) => {
  const params = new URLSearchParams();
  if (query) params.set("q", query);
  if (value) params.set("show", value);
  const search = params.toString();
  return search ? `/admin/music/setlists?${search}` : "/admin/music/setlists";
};
---
<SiteLayout title="Setlist 管理" admin>
  <AdminMusicNav />
  <AdminPageHeader title="Setlist 管理" description={`共 ${counts.all} 份${query ? "符合搜索条件的" : ""} Setlist，按演出日期从新到旧排列。维护关联活动、歌曲顺序、演唱版本、Medley 与来源。`}>
    <a class:list={["button", { disabled: !canWrite }]} href={canWrite ? "/admin/music/setlists/new" : undefined} aria-disabled={!canWrite}><Icon name="plus" />新 Setlist</a>
  </AdminPageHeader>
  <form class="filters panel" method="get">
    <label>搜索<input type="search" name="q" value={query} placeholder="活动、场地或 Setlist 标题" /></label>
    {active.value && <input type="hidden" name="show" value={active.value} />}
    <button type="submit"><Icon name="search" />搜索</button>
    {query && <a class="button secondary" href={active.value ? `/admin/music/setlists?show=${active.value}` : "/admin/music/setlists"}>清除</a>}
  </form>
  <nav class="chips" aria-label="快速筛选">
    {filters.map((filter) => <a class:list={{ active: filter === active }} aria-current={filter === active ? "page" : undefined} href={hrefFor(filter.value)}>{filter.label}<span>{filter.count}</span></a>)}
  </nav>
  <div class="panel table-wrap">
    <table>
      <thead><tr><th>日期</th><th>Setlist</th><th class="hide-sm">类型</th><th class="num">歌曲</th><th class="hide-sm">资料状态</th><th>公开</th><th class="row-links"><span class="visually-hidden">操作</span></th></tr></thead>
      <tbody>
        {setlists.map((setlist) => <tr>
          <td class="date">{setlist.start_date}</td>
          <td><a href={`/admin/music/setlists/${setlist.id}`}>{setlist.title || setlist.event_title}</a><small>{setlist.performance_label} · {setlist.venue || "场地待补"}</small></td>
          <td class="hide-sm nowrap">{setlist.event_classification || "—"}</td>
          <td class:list={["num", { zero: setlist.entry_count === 0 }]}>{setlist.entry_count}</td>
          <td class="hide-sm status">
            <span class:list={["tag", { warn: setlist.completeness !== "complete" }]}>{completenessLabels[setlist.completeness] ?? setlist.completeness}</span>
            <span class:list={["tag", { warn: setlist.confidence === "unverified" }]}>{confidenceLabels[setlist.confidence] ?? setlist.confidence}</span>
          </td>
          <td><span class:list={["tag", setlist.published ? "live" : "off"]}>{setlist.published ? "公开" : "未公开"}</span></td>
          <td class="row-links">
            <a href={`/admin/music/setlists/${setlist.id}`} aria-label="编辑"><Icon name="pencil-square" /></a>
            {setlist.published && <a href={`/music/lives/${setlist.id}`} target="_blank" aria-label="查看公开页面"><Icon name="box-arrow-up-right" /></a>}
          </td>
        </tr>)}
      </tbody>
    </table>
    {!setlists.length && <div class="empty">没有符合条件的 Setlist。</div>}
  </div>
  <Pagination currentPage={currentPage} totalPages={totalPages} totalItems={totalItems} itemLabel="份 Setlist" />
</SiteLayout>
<style>
  .filters { display:grid;grid-template-columns:1fr auto auto;align-items:end;gap:.8rem;margin-bottom:.8rem }
  .chips { display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:1rem }
  .chips a { display:inline-flex;align-items:center;gap:.45rem;padding:.45rem .75rem;border:1px solid var(--line);border-radius:999px;color:var(--muted);text-decoration:none;font-size:.8rem }
  .chips a span { min-width:1.3rem;padding:.05rem .35rem;border-radius:999px;background:rgba(255,255,255,.07);font:700 .68rem/1.4 ui-monospace,monospace;text-align:center }
  .chips a.active { color:var(--accent);border-color:rgba(var(--accent-rgb),.4) }
  .chips a.active span { color:#07101c;background:var(--accent) }
  .zero { color:#ffd39a }
  .status { white-space:nowrap }
  .tag + .tag { margin-left:.25rem }
  @media(max-width:720px){.filters{grid-template-columns:1fr}}
</style>
