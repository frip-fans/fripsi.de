---
import { getMusicEditorOptions } from "@frip-fan/core";
import AdminMusicNav from "../../../../components/AdminMusicNav.astro";
import SetlistAdminForm from "../../../../components/SetlistAdminForm.astro";
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../../lib/env";

const options = await getMusicEditorOptions(getEnv().DB);
const canWrite = Astro.locals.actor!.scopes.includes("music:write");
---
<SiteLayout title="新增 Setlist" admin>
  <AdminMusicNav />
  <p class="eyebrow">New setlist</p><h1 class="page-title">新增 Setlist</h1>
  <p class="lede">选择已有活动与歌曲；保存后直接写入音乐库，关闭公开显示可以暂存在后台。</p>
  <SetlistAdminForm options={options} canWrite={canWrite} />
</SiteLayout>
<style>.page-title{font-size:clamp(2.5rem,6vw,4.5rem);margin-bottom:.8rem}.catalog-form{margin-top:2rem}</style>
