---
import AdminPageHeader from "../../../../components/AdminPageHeader.astro";
import { getAdminSongById } from "@frip-fan/core";
import AdminMusicNav from "../../../../components/AdminMusicNav.astro";
import Icon from "../../../../components/Icon.astro";
import SongAdminForm from "../../../../components/SongAdminForm.astro";
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../../lib/env";

const song = await getAdminSongById(getEnv().DB, Astro.params.id!);
if (!song) return Astro.redirect("/admin/music/songs", 302);
const canWrite = Astro.locals.actor!.scopes.includes("music:write");
const saved = Astro.url.searchParams.get("saved") === "1";
---
<SiteLayout title={`编辑 ${song.title}`} admin>
  <AdminMusicNav />
  <AdminPageHeader title={song.title} back={{ href: "/admin/music/songs", label: "歌曲列表" }}>
    {song.published && <a class="button secondary" href={`/music/songs/${song.slug}`} target="_blank">公开页面 <Icon name="box-arrow-up-right" /></a>}
  </AdminPageHeader>
  {saved && <p class="notice success">歌曲已经保存，可立即在专辑与 Setlist 编辑器中选择。</p>}
  <SongAdminForm song={song} canWrite={canWrite} />
</SiteLayout>
