---
import AdminPageHeader from "../../../../components/AdminPageHeader.astro";
import { listAdminSongs, songPhasesFromMask } from "@frip-fan/core";
import AdminMusicNav from "../../../../components/AdminMusicNav.astro";
import Icon from "../../../../components/Icon.astro";
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../../lib/env";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const songs = await listAdminSongs(getEnv().DB, query || undefined);
const canWrite = Astro.locals.actor!.scopes.includes("music:write");
---
<SiteLayout title="歌曲管理" admin>
  <AdminMusicNav />
  <AdminPageHeader title="歌曲管理" description="新增歌曲并维护别名、歌曲版本、公开状态与来源。">
    <a class:list={["button", { disabled: !canWrite }]} href={canWrite ? "/admin/music/songs/new" : undefined} aria-disabled={!canWrite}><Icon name="plus" />新歌曲</a>
  </AdminPageHeader>
  <form class="filters panel" method="get">
    <label>搜索<input type="search" name="q" value={query} placeholder="歌曲名、别名、歌手或 slug" /></label>
    <button type="submit"><Icon name="search" />搜索</button>
  </form>
  <div class="panel table-wrap">
    <table>
      <thead><tr><th>歌曲</th><th class="hide-sm">歌手</th><th class="hide-sm">期别</th><th class="num">版本</th><th class="num hide-sm">专辑</th><th class="num hide-sm">Live</th><th>公开</th><th class="row-links"><span class="visually-hidden">操作</span></th></tr></thead>
      <tbody>
        {songs.map((song) => <tr>
          <td><a href={`/admin/music/songs/${song.id}`}>{song.title}</a><small>{song.slug}</small></td>
          <td class="hide-sm">{song.original_artist}</td>
          <td class="nowrap hide-sm">{songPhasesFromMask(song.phase_mask).join("·") || "—"}</td>
          <td class="num">{song.version_count}</td>
          <td class="num hide-sm">{song.release_count}</td>
          <td class="num hide-sm">{song.show_count}</td>
          <td><span class:list={["tag", song.published ? "live" : "off"]}>{song.published ? "公开" : "未公开"}</span></td>
          <td class="row-links">
            <a href={`/admin/music/songs/${song.id}`} aria-label="编辑"><Icon name="pencil-square" /></a>
            {song.published && <a href={`/music/songs/${song.slug}`} target="_blank" aria-label="查看公开页面"><Icon name="box-arrow-up-right" /></a>}
          </td>
        </tr>)}
      </tbody>
    </table>
    {!songs.length && <div class="empty">没有符合条件的歌曲。</div>}
  </div>
</SiteLayout>
<style>
  .filters { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: .8rem; margin-bottom: 1rem; }
  @media (max-width: 720px) { .filters { grid-template-columns: 1fr; } }
</style>
