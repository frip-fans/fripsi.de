---
import { listAdminSongs } from "@frip-fan/core";
import AdminMusicNav from "../../../../components/AdminMusicNav.astro";
import Icon from "../../../../components/Icon.astro";
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../../lib/env";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const songs = await listAdminSongs(getEnv().DB, query || undefined);
const canWrite = Astro.locals.actor!.scopes.includes("music:write");
---
<SiteLayout title="歌曲管理" admin>
  <AdminMusicNav />
  <header class="list-head">
    <div><p class="eyebrow">Song catalog</p><h1>歌曲管理</h1><p class="lede">新增歌曲并维护别名、歌曲版本、公开状态与来源。</p></div>
    <a class:list={["button", { disabled: !canWrite }]} href={canWrite ? "/admin/music/songs/new" : undefined} aria-disabled={!canWrite}><Icon name="plus" />新歌曲</a>
  </header>
  <form class="filters panel" method="get">
    <label>搜索<input type="search" name="q" value={query} placeholder="歌曲名、别名、歌手或 slug" /></label>
    <button type="submit"><Icon name="search" />搜索</button>
  </form>
  <div class="panel table-wrap">
    <table>
      <thead><tr><th>歌曲</th><th>歌手</th><th>版本</th><th>专辑</th><th>Live</th><th>公开</th><th>操作</th></tr></thead>
      <tbody>
        {songs.map((song) => <tr>
          <td><a href={`/admin/music/songs/${song.id}`}>{song.title}</a><small>{song.slug}</small></td>
          <td>{song.original_artist}</td>
          <td>{song.version_count}</td>
          <td>{song.release_count}</td>
          <td>{song.show_count}</td>
          <td><span class:list={["tag", { live: song.published }]}>{song.published ? "公开" : "未公开"}</span></td>
          <td>{song.published && <a href={`/music/songs/${song.slug}`} target="_blank" aria-label="查看公开页面"><Icon name="box-arrow-up-right" /></a>}</td>
        </tr>)}
      </tbody>
    </table>
    {!songs.length && <div class="empty">没有符合条件的歌曲。</div>}
  </div>
</SiteLayout>
<style>
  .list-head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2rem; }
  .list-head h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); margin-bottom: .5rem; }
  .filters { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: .8rem; margin-bottom: 1rem; }
  td small { display: block; color: var(--muted); margin-top: .2rem; }
  .button.disabled { opacity: .45; pointer-events: none; }
  @media (max-width: 720px) { .list-head { align-items: flex-start; flex-direction: column; } .filters { grid-template-columns: 1fr; } }
</style>
