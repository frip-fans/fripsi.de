---
import AdminPageHeader from "../../../../components/AdminPageHeader.astro";
import AdminMusicNav from "../../../../components/AdminMusicNav.astro";
import SongAdminForm from "../../../../components/SongAdminForm.astro";
import SiteLayout from "../../../../layouts/SiteLayout.astro";

const canWrite = Astro.locals.actor!.scopes.includes("music:write");
---
<SiteLayout title="新增歌曲" admin>
  <AdminMusicNav />
  <AdminPageHeader title="新增歌曲" description="创建歌曲及至少一个歌曲版本；保存后即可在专辑和 Setlist 编辑器中选择。" back={{ href: "/admin/music/songs", label: "歌曲列表" }} />
  <SongAdminForm canWrite={canWrite} />
</SiteLayout>
