---
import AdminPageHeader from "../../../components/AdminPageHeader.astro";
import { listTours } from "@frip-fan/core";
import TourAdminForm from "../../../components/TourAdminForm.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../lib/env";

const tours = await listTours(getEnv().DB);
const canWrite = Astro.locals.actor!.scopes.includes("events:publish");
---
<SiteLayout title="巡演管理" admin>
  <AdminPageHeader title="巡演管理" description="巡演把多场活动归为一组。活动的显示名优先用别名，其次是「巡演名称 · 场次」，最后是官方名称。进入巡演即可搜索并批量加入或移出各站，也可在活动编辑页选择所属巡演。" />
  <div class="panel table-wrap">
    <table>
      <thead><tr><th>巡演</th><th class="num">站数</th><th>时间</th><th>公开</th></tr></thead>
      <tbody>
        {tours.map((tour) => <tr>
          <td><a href={`/admin/tours/${tour.id}`}>{tour.name}</a><small>{tour.slug}</small></td>
          <td class="num">{tour.stop_count}</td>
          <td class="date">{tour.first_date ? `${tour.first_date} – ${tour.last_date}` : "—"}</td>
          <td><span class:list={["tag", tour.published ? "live" : "off"]}>{tour.published ? "公开" : "未公开"}</span></td>
        </tr>)}
      </tbody>
    </table>
    {!tours.length && <div class="empty">还没有巡演。</div>}
  </div>
  <h2 class="section-title">新建巡演</h2>
  <TourAdminForm canWrite={canWrite} />
</SiteLayout>
<style>
  .section-title { margin: 2rem 0 .75rem; }
</style>
