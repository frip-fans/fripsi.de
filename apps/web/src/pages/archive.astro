---
import {
  dateInTimeZone,
  listAdministrativeAreas,
  listArchiveFilterEntries,
  searchEvents,
  type AdministrativeArea,
} from "@frip-fan/core";
import EventCard from "../components/EventCard.astro";
import Icon from "../components/Icon.astro";
import { archiveLocationCounts, archiveYearCounts } from "../lib/archive-filter";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getEnv } from "../lib/env";
import { getLocale, t } from "../lib/i18n";

const db = getEnv().DB;
const locale = getLocale(Astro.request);
const [areas, archiveEntries] = await Promise.all([
  listAdministrativeAreas(db),
  listArchiveFilterEntries(db),
]);
const areaById = new Map(areas.map((area) => [area.id, area]));
const countryAreas = new Map(areas.filter((area) => area.level === "country").map((area) => [area.country_code, area]));
const localizedAreaName = (area: AdministrativeArea): string => locale === "en" ? area.name_en ?? area.name_local : locale === "ja" ? area.name_ja ?? area.name_local : area.name_zh ?? area.name_local;

const areaLocationKey = (areaId: string): string | null => {
  let area = areaById.get(areaId);
  if (!area) return null;
  if (area.country_code !== "JP") return `country:${area.country_code}`;
  const visited = new Set<string>();
  while (area && area.level !== "subdivision") {
    if (!area.parent_id || visited.has(area.id)) return null;
    visited.add(area.id);
    area = areaById.get(area.parent_id);
  }
  return area?.level === "subdivision" ? `jp:${area.id}` : null;
};

const locationLabel = (key: string): string => {
  const area = key.startsWith("jp:") ? areaById.get(key.slice(3)) : countryAreas.get(key.slice(8));
  return area ? localizedAreaName(area) : key;
};
const archiveItems = archiveEntries.map((entry) => {
  const locationKeys = [...new Set(entry.area_ids.map(areaLocationKey).filter((key): key is string => Boolean(key)))];
  const searchText = [
    entry.title, entry.category, entry.classification, entry.location_note, entry.remark,
    ...entry.venue_names, ...entry.area_names, ...entry.channel_names,
  ].filter(Boolean).join(" ").toLocaleLowerCase();
  return { id: entry.id, startDate: entry.start_date, category: entry.category, searchText, locationKeys };
});
const locationCounts = archiveLocationCounts(archiveItems);
const validCategories = new Set(["LIVE", "EVENT", "RELEASE", "MEDIA", "OTHER"]);
const query = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 200);
const selectedCategories = [...new Set(Astro.url.searchParams.getAll("category"))]
  .filter((value) => validCategories.has(value));
const selectedLocations = [...new Set(Astro.url.searchParams.getAll("location"))]
  .filter((value) => locationCounts.has(value));
const filterState = { query, categories: selectedCategories, locations: selectedLocations };
const filtering = Boolean(query || selectedCategories.length || selectedLocations.length);

const today = dateInTimeZone();
const currentYear = today.slice(0, 4);
const matchedYears = archiveYearCounts(archiveItems, filterState);
const years = !filtering && !matchedYears.some((item) => item.year === currentYear)
  ? [...matchedYears, { year: currentYear, count: 0 }].sort((left, right) => right.year.localeCompare(left.year))
  : matchedYears;
const requested = Astro.url.searchParams.get("year");
const year = requested && /^\d{4}$/.test(requested) && years.some((item) => item.year === requested)
  ? requested : years.find((item) => item.year === currentYear)?.year ?? years[0]?.year ?? currentYear;
const events = await searchEvents(db, { date_from: `${year}-01-01`, date_to: `${year}-12-31`, limit: 500 }, true);
const categoryOptions = [
  { value: "LIVE", label: "Live" },
  { value: "EVENT", label: "Event" },
  { value: "RELEASE", label: "Release" },
  { value: "MEDIA", label: "Media" },
  { value: "OTHER", label: "Other" },
].map((option) => ({ ...option, count: archiveItems.filter((event) => event.category === option.value).length }));
const locationOptions = [...locationCounts].map(([value, count]) => ({ value, count, label: locationLabel(value) }))
  .sort((left, right) => left.label.localeCompare(right.label, locale));
const japaneseLocationOptions = locationOptions.filter((option) => option.value.startsWith("jp:"));
const overseasLocationOptions = locationOptions.filter((option) => option.value.startsWith("country:"));
const locationKeysByEventId = new Map(archiveItems.map((item) => [item.id, item.locationKeys]));
const archiveHref = (targetYear: string): string => {
  const params = new URLSearchParams();
  params.set("year", targetYear);
  if (query) params.set("q", query);
  for (const category of selectedCategories) params.append("category", category);
  for (const location of selectedLocations) params.append("location", location);
  return `/archive?${params}`;
};
---
<SiteLayout title={t(locale, "archive.title")} clientRouting>
  <header class="archive-head">
    <h1>Event List</h1>
  </header>
  {archiveEntries.length > 0 && (
    <form class="list-toolbar" method="get" action="/archive" data-archive-filter-form>
      <input type="hidden" name="year" value={year} />
      <label class="event-search">
        <span class="visually-hidden">{t(locale, "archive.searchLabel")}</span>
        <Icon name="search" />
        <input type="search" name="q" value={query} placeholder={t(locale, "archive.searchPlaceholder")} autocomplete="off" data-event-search-input />
      </label>
      <div class="list-control-row">
        <div class="list-controls">
          <div class="control-popover" data-control-popover>
            <button
              type="button"
              class="control-button"
              aria-expanded="false"
              aria-controls="event-filter-panel"
              data-filter-toggle
            >
              <Icon name="funnel" />
              <span>{t(locale, "common.filter")}</span>
              <span class="active-filter-count" data-filter-count hidden>0</span>
            </button>
            <div class="control-card filter-card" id="event-filter-panel" data-filter-panel hidden>
              <div class="control-card-head">
                <div><strong>{t(locale, "archive.activityType")}</strong><span>{t(locale, "archive.multiple")}</span></div>
                <small>FILTER</small>
              </div>
              <div class="filter-options">
                {categoryOptions.map((option) => (
                  <label class:list={["filter-choice", { disabled: option.count === 0 }]}>
                    <input
                      type="checkbox"
                      name="category"
                      value={option.value}
                      data-category-filter
                      disabled={option.count === 0}
                      checked={selectedCategories.includes(option.value)}
                    />
                    <span class="filter-pill"><span>{option.label}</span><small>{option.count}</small></span>
                  </label>
                ))}
              </div>
              {(japaneseLocationOptions.length > 0 || overseasLocationOptions.length > 0) && (
                <div class="location-filter-section">
                  <div class="filter-section-head"><strong>{t(locale, "archive.location")}</strong><span>{t(locale, "archive.multiple")}</span></div>
                  {japaneseLocationOptions.length > 0 && (
                    <div class="location-filter-group">
                      <span class="filter-group-label">{t(locale, "archive.japanPrefectures")}</span>
                      <div class="filter-options location-options">
                        {japaneseLocationOptions.map((option) => (
                          <label class="filter-choice">
                            <input type="checkbox" name="location" value={option.value} data-location-filter checked={selectedLocations.includes(option.value)} />
                            <span class="filter-pill"><span>{option.label}</span><small>{option.count}</small></span>
                          </label>
                        ))}
                      </div>
                    </div>
                  )}
                  {overseasLocationOptions.length > 0 && (
                    <div class="location-filter-group">
                      <span class="filter-group-label">{t(locale, "archive.overseasCountries")}</span>
                      <div class="filter-options location-options">
                        {overseasLocationOptions.map((option) => (
                          <label class="filter-choice">
                            <input type="checkbox" name="location" value={option.value} data-location-filter checked={selectedLocations.includes(option.value)} />
                            <span class="filter-pill"><span>{option.label}</span><small>{option.count}</small></span>
                          </label>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              )}
              <div class="control-card-actions">
                <button type="button" class="clear-control" data-filter-clear disabled>{t(locale, "archive.clear")}</button>
                <button type="submit" class="done-control" data-filter-done>{t(locale, "archive.done")}</button>
              </div>
            </div>
          </div>

          <div class="control-popover" data-control-popover>
            <button
              type="button"
              class="control-button"
              aria-expanded="false"
              aria-controls="event-sort-panel"
              data-sort-toggle
            >
              <Icon name="arrow-down-up" />
              <span>{t(locale, "archive.sort")}</span>
              <span class="control-value" data-sort-button-label>{t(locale, "archive.sortAsc")}</span>
            </button>
            <div class="control-card sort-card" id="event-sort-panel" data-sort-panel hidden>
              <div class="control-card-head">
                <div><strong>{t(locale, "archive.sortTitle")}</strong><span>{t(locale, "archive.sortHelp")}</span></div>
                <small>SORT</small>
              </div>
              <div class="sort-options">
                <label class="sort-choice">
                  <input type="radio" name="event-sort" value="asc" data-sort-option data-sort-label={t(locale, "archive.sortAsc")} checked />
                  <span><strong>{t(locale, "archive.sortAsc")}</strong><small>{t(locale, "archive.sortAscHelp")}</small></span>
                </label>
                <label class="sort-choice">
                  <input type="radio" name="event-sort" value="desc" data-sort-option data-sort-label={t(locale, "archive.sortDesc")} />
                  <span><strong>{t(locale, "archive.sortDesc")}</strong><small>{t(locale, "archive.sortDescHelp")}</small></span>
                </label>
              </div>
            </div>
          </div>
        </div>
        <span
          class="search-count"
          data-search-count
          data-total-template={t(locale, "archive.total", { count: "{count}" })}
          data-filtered-template={t(locale, "archive.filtered", { visible: "{visible}", total: "{total}" })}
          aria-live="polite"
        >{t(locale, "archive.total", { count: events.length })}</span>
      </div>
    </form>
  )}
  <div class="year-tabs" data-year-tabs>
    {years.map((item) => <a class:list={{ active: item.year === year }} href={archiveHref(item.year)} data-astro-prefetch="viewport"><strong>{item.year}</strong><small>{t(locale, "archive.yearCount", { count: item.count })}</small></a>)}
  </div>
  <section
    class="stack"
    data-event-list
    data-current-year-page={year === currentYear ? "true" : "false"}
    data-today={today}
  >
    {events.map((event, index) => (
      <div
        class="event-item"
        data-event-item
        data-event-index={index}
        data-event-category={event.category}
        data-event-locations={(locationKeysByEventId.get(event.id) ?? []).join(" ")}
        data-event-sort={`${event.start_date}T${event.start_time ?? "00:00"}`}
        data-search-text={[event.title, event.category, event.classification, event.location_label, event.remark].filter(Boolean).join(" ").toLocaleLowerCase()}
      >
        <EventCard event={event} />
      </div>
    ))}
    <div
      class="current-time-marker"
      id="archive-current-time"
      role="separator"
      aria-label={t(locale, "archive.now")}
      data-current-time-marker
      hidden={year !== currentYear}
    >
      <span class="current-time-line" aria-hidden="true"></span>
      <span class="current-time-label"><i aria-hidden="true"></i>{t(locale, "archive.now")}<time datetime={today}>{today.slice(5).replace("-", ".")}</time></span>
      <span class="current-time-line" aria-hidden="true"></span>
    </div>
    <div class="empty panel" data-search-empty hidden>{t(locale, "archive.noMatch")}</div>
    {!events.length && <div class="empty panel">{t(locale, "archive.empty")}</div>}
  </section>
  <button
    type="button"
    class="jump-current-time"
    aria-controls="archive-current-time"
    data-jump-current-time
    hidden
  >
    <Icon name="chevron-down" class="jump-direction jump-down" />
    <Icon name="chevron-up" class="jump-direction jump-up" />
    <span>{t(locale, "archive.jumpNow")}</span>
  </button>
</SiteLayout>

<script>
  const yearTabsScrollKey = "frip-fan:archive-year-tabs-scroll";
  let archivePageController: AbortController | undefined;

  const setupArchivePage = () => {
    archivePageController?.abort();
    archivePageController = undefined;

    const yearTabs = document.querySelector<HTMLElement>("[data-year-tabs]");
    if (!yearTabs) return;

    const controller = new AbortController();
    const { signal } = controller;
    archivePageController = controller;
    const searchInput = document.querySelector<HTMLInputElement>("[data-event-search-input]");
    const eventItems = [...document.querySelectorAll<HTMLElement>("[data-event-item]")];
    const eventList = document.querySelector<HTMLElement>("[data-event-list]");
    const searchCount = document.querySelector<HTMLElement>("[data-search-count]");
    const searchEmpty = document.querySelector<HTMLElement>("[data-search-empty]");
    const filterToggle = document.querySelector<HTMLButtonElement>("[data-filter-toggle]");
    const filterPanel = document.querySelector<HTMLElement>("[data-filter-panel]");
    const categoryFilterInputs = [...document.querySelectorAll<HTMLInputElement>("[data-category-filter]")];
    const locationFilterInputs = [...document.querySelectorAll<HTMLInputElement>("[data-location-filter]")];
    const filterCount = document.querySelector<HTMLElement>("[data-filter-count]");
    const filterClear = document.querySelector<HTMLButtonElement>("[data-filter-clear]");
    const filterDone = document.querySelector<HTMLButtonElement>("[data-filter-done]");
    const sortToggle = document.querySelector<HTMLButtonElement>("[data-sort-toggle]");
    const sortPanel = document.querySelector<HTMLElement>("[data-sort-panel]");
    const sortInputs = [...document.querySelectorAll<HTMLInputElement>("[data-sort-option]")];
    const sortButtonLabel = document.querySelector<HTMLElement>("[data-sort-button-label]");
    const currentTimeMarker = document.querySelector<HTMLElement>("[data-current-time-marker]");
    const jumpCurrentTime = document.querySelector<HTMLButtonElement>("[data-jump-current-time]");
    const isCurrentYearPage = eventList?.dataset.currentYearPage === "true";
    const currentSortBoundary = `${eventList?.dataset.today ?? ""}T00:00`;
    let jumpUpdateFrame = 0;

    const updateJumpButton = () => {
      cancelAnimationFrame(jumpUpdateFrame);
      jumpUpdateFrame = requestAnimationFrame(() => {
        if (!jumpCurrentTime || !currentTimeMarker || !eventList || currentTimeMarker.hidden || !isCurrentYearPage) {
          if (jumpCurrentTime) jumpCurrentTime.hidden = true;
          return;
        }
        const markerBounds = currentTimeMarker.getBoundingClientRect();
        const markerInViewport = markerBounds.bottom > 0 && markerBounds.top < window.innerHeight;
        if (markerInViewport) {
          jumpCurrentTime.hidden = true;
          return;
        }

        jumpCurrentTime.hidden = false;
        const listBounds = eventList.getBoundingClientRect();
        const buttonBounds = jumpCurrentTime.getBoundingClientRect();
        const viewportGap = window.innerWidth <= 560 ? 14 : 20;
        const visibleListTop = Math.max(viewportGap, listBounds.top);
        const visibleListBottom = Math.min(window.innerHeight - viewportGap, listBounds.bottom);
        if (visibleListBottom - visibleListTop < buttonBounds.height) {
          jumpCurrentTime.hidden = true;
          return;
        }

        const preferredTop = window.innerHeight - buttonBounds.height - viewportGap;
        const clampedTop = Math.min(
          Math.max(preferredTop, visibleListTop),
          visibleListBottom - buttonBounds.height
        );
        jumpCurrentTime.style.top = `${clampedTop}px`;

        const sideGap = 16;
        const rightRailWidth = window.innerWidth - listBounds.right;
        if (window.innerWidth >= 900 && rightRailWidth >= buttonBounds.width + sideGap) {
          jumpCurrentTime.style.left = `${listBounds.right + sideGap}px`;
          jumpCurrentTime.style.right = "auto";
        } else {
          jumpCurrentTime.style.left = "auto";
          jumpCurrentTime.style.right = `${Math.max(viewportGap, window.innerWidth - listBounds.right)}px`;
        }
        jumpCurrentTime.dataset.direction = markerBounds.top >= window.innerHeight ? "down" : "up";
      });
    };

    const saveYearTabsScroll = () => {
      const max = Math.max(0, yearTabs.scrollWidth - yearTabs.clientWidth);
      try {
        sessionStorage.setItem(yearTabsScrollKey, JSON.stringify({
          left: yearTabs.scrollLeft,
          max,
          progress: max > 0 ? yearTabs.scrollLeft / max : 0
        }));
      } catch {
        // The archive remains usable when browser storage is unavailable.
      }
    };

    const restoreYearTabsScroll = () => {
      try {
        const saved = JSON.parse(sessionStorage.getItem(yearTabsScrollKey) ?? "null") as {
          left?: number;
          max?: number;
          progress?: number;
        } | null;
        if (!saved) return;
        const max = Math.max(0, yearTabs.scrollWidth - yearTabs.clientWidth);
        const sameTrackWidth = Number.isFinite(saved.max) && Math.abs(max - (saved.max ?? 0)) < 1;
        const target = sameTrackWidth
          ? saved.left ?? 0
          : max * Math.min(1, Math.max(0, saved.progress ?? 0));
        yearTabs.scrollLeft = Math.min(max, Math.max(0, target));
      } catch {
        // Ignore invalid or inaccessible session storage.
      }
    };

    const closePanel = (button: HTMLButtonElement | null, panel: HTMLElement | null) => {
      if (!button || !panel) return;
      panel.hidden = true;
      button.setAttribute("aria-expanded", "false");
    };

    const closeControlPanels = () => {
      closePanel(filterToggle, filterPanel);
      closePanel(sortToggle, sortPanel);
    };

    const togglePanel = (button: HTMLButtonElement | null, panel: HTMLElement | null) => {
      if (!button || !panel) return;
      const shouldOpen = panel.hidden;
      closeControlPanels();
      panel.hidden = !shouldOpen;
      button.setAttribute("aria-expanded", String(shouldOpen));
    };

    const applyListState = () => {
      const terms = searchInput?.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean) ?? [];
      const selectedCategories = new Set(categoryFilterInputs.filter((input) => input.checked).map((input) => input.value));
      const selectedLocations = new Set(locationFilterInputs.filter((input) => input.checked).map((input) => input.value));
      const sortDirection = sortInputs.find((input) => input.checked)?.value === "desc" ? -1 : 1;

      const sortedItems = [...eventItems].sort((left, right) => {
        const byTime = (left.dataset.eventSort ?? "").localeCompare(right.dataset.eventSort ?? "") * sortDirection;
        if (byTime !== 0) return byTime;
        return Number(left.dataset.eventIndex ?? 0) - Number(right.dataset.eventIndex ?? 0);
      });
      sortedItems.forEach((item) => eventList?.insertBefore(item, searchEmpty));

      let visibleCount = 0;
      eventItems.forEach((item) => {
        const searchText = item.dataset.searchText ?? "";
        const matchesSearch = terms.every((term) => searchText.includes(term));
        const matchesCategory = selectedCategories.size === 0 || selectedCategories.has(item.dataset.eventCategory ?? "");
        const itemLocations = (item.dataset.eventLocations ?? "").split(" ").filter(Boolean);
        const matchesLocation = selectedLocations.size === 0 || itemLocations.some((location) => selectedLocations.has(location));
        item.hidden = !(matchesSearch && matchesCategory && matchesLocation);
        if (!item.hidden) visibleCount += 1;
      });

      const filtering = terms.length > 0 || selectedCategories.size > 0 || selectedLocations.size > 0;
      if (currentTimeMarker && eventList) {
        currentTimeMarker.hidden = !isCurrentYearPage || (filtering && visibleCount === 0);
        if (!currentTimeMarker.hidden) {
          const visibleItems = sortedItems.filter((item) => !item.hidden);
          const insertionPoint = sortDirection === 1
            ? visibleItems.find((item) => (item.dataset.eventSort ?? "") >= currentSortBoundary)
            : visibleItems.find((item) => (item.dataset.eventSort ?? "") < currentSortBoundary);
          eventList.insertBefore(currentTimeMarker, insertionPoint ?? searchEmpty);
        }
      }
      if (searchCount) {
        const totalTemplate = searchCount.dataset.totalTemplate ?? "{count}";
        const filteredTemplate = searchCount.dataset.filteredTemplate ?? "{visible} / {total}";
        searchCount.textContent = filtering
          ? filteredTemplate.replaceAll("{visible}", String(visibleCount)).replaceAll("{total}", String(eventItems.length))
          : totalTemplate.replaceAll("{count}", String(eventItems.length));
      }
      if (searchEmpty) searchEmpty.hidden = !filtering || visibleCount > 0;
      const selectedFilterCount = selectedCategories.size + selectedLocations.size;
      if (filterCount) {
        filterCount.textContent = String(selectedFilterCount);
        filterCount.hidden = selectedFilterCount === 0;
      }
      if (filterClear) filterClear.disabled = selectedFilterCount === 0;
      filterToggle?.classList.toggle("active", selectedFilterCount > 0);
      updateJumpButton();
    };

    restoreYearTabsScroll();
    requestAnimationFrame(() => { if (!signal.aborted) restoreYearTabsScroll(); });
    yearTabs.addEventListener("scroll", saveYearTabsScroll, { passive: true, signal });
    yearTabs.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>("a");
      if (!link) return;
      saveYearTabsScroll();
      if (!link.classList.contains("active")) {
        link.classList.add("is-pending");
        link.setAttribute("aria-busy", "true");
      }
    }, { signal });
    window.addEventListener("pagehide", saveYearTabsScroll, { signal });
    window.addEventListener("pageshow", restoreYearTabsScroll, { signal });
    window.addEventListener("scroll", updateJumpButton, { passive: true, signal });
    window.addEventListener("resize", updateJumpButton, { passive: true, signal });
    searchInput?.addEventListener("input", applyListState, { signal });
    filterToggle?.addEventListener("click", () => togglePanel(filterToggle, filterPanel), { signal });
    sortToggle?.addEventListener("click", () => togglePanel(sortToggle, sortPanel), { signal });
    [...categoryFilterInputs, ...locationFilterInputs].forEach((input) => input.addEventListener("change", applyListState, { signal }));
    filterClear?.addEventListener("click", () => {
      categoryFilterInputs.forEach((input) => { input.checked = false; });
      locationFilterInputs.forEach((input) => { input.checked = false; });
      applyListState();
    }, { signal });
    filterDone?.addEventListener("click", () => closePanel(filterToggle, filterPanel), { signal });
    sortInputs.forEach((input) => input.addEventListener("change", () => {
      if (sortButtonLabel) sortButtonLabel.textContent = input.dataset.sortLabel ?? sortInputs[0]?.dataset.sortLabel ?? "";
      applyListState();
      closePanel(sortToggle, sortPanel);
    }, { signal }));
    document.addEventListener("pointerdown", (event) => {
      const target = event.target;
      if (target instanceof Element && !target.closest("[data-control-popover]")) closeControlPanels();
    }, { signal });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeControlPanels();
    }, { signal });
    jumpCurrentTime?.addEventListener("click", () => {
      currentTimeMarker?.scrollIntoView({
        block: "center",
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth"
      });
    }, { signal });
    applyListState();
  };

  document.addEventListener("astro:page-load", setupArchivePage);
  setupArchivePage();
</script>

<style>
  .archive-head h1 { margin-bottom: 0; }
  .year-tabs { display: flex; gap: .7rem; margin: 1.25rem 0; overflow-x: auto; padding-bottom: .5rem; }
  .year-tabs a { min-width: 120px; display: grid; gap: .2rem; text-decoration: none; border: 1px solid var(--line); border-radius: 14px; padding: .9rem 1rem; transition: color .16s, border-color .16s, background .16s, opacity .16s; }
  .year-tabs a.active { border-color: rgba(var(--accent-rgb), .45); background: rgba(var(--accent-rgb), .06); }
  .year-tabs a.is-pending { color: var(--accent); border-color: rgba(var(--accent-rgb), .5); background: rgba(var(--accent-rgb), .08); animation: year-tab-pulse .8s ease-in-out infinite alternate; }
  .year-tabs strong { font-size: 1.2rem; }
  .year-tabs small { color: var(--muted); }
  @keyframes year-tab-pulse { to { opacity: .58; } }
  .list-toolbar { display: grid; gap: .75rem; margin-top: 2.5rem; }
  .event-search { position: relative; display: flex; align-items: center; width: 100%; color: var(--muted); }
  .event-search :global(.icon) { position: absolute; left: .9rem; pointer-events: none; }
  .event-search input { height: 46px; padding-left: 2.65rem; background: rgba(7,16,28,.74); border-color: var(--line); }
  .event-search input::-webkit-search-cancel-button { cursor: pointer; }
  .list-control-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 38px; }
