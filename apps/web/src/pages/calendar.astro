---
import { dateInTimeZone } from "@frip-fan/core";
import EventCalendarView from "../components/EventCalendarView.astro";
import EventListView from "../components/EventListView.astro";
import Icon from "../components/Icon.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { calendarViewHref } from "../lib/calendar-navigation";
import { getEnv } from "../lib/env";
import { getLocale, t } from "../lib/i18n";

const locale = getLocale(Astro.request);
const view = Astro.url.searchParams.get("view") === "list" ? "list" : "calendar";
const todayMonth = dateInTimeZone().slice(0, 7);
const subscriptionUrl = new URL("/calendar.ics", getEnv().SITE_URL || Astro.url.origin);
const webcalUrl = subscriptionUrl.href.replace(/^https?:/, "webcal:");
---
<SiteLayout title={t(locale, "calendar.title")} clientRouting>
  <header class="events-head">
    <h1>{t(locale, "nav.calendar")}</h1>
    <a class="button secondary subscribe-button" href={webcalUrl} title={t(locale, "home.subscriptionTitle", { url: subscriptionUrl.href })}><Icon name="calendar-plus" />{t(locale, "home.subscribe")}</a>
  </header>
  <nav class="event-views" aria-label={t(locale, "calendar.views")} data-event-views data-today-month={todayMonth}>
    <a href={calendarViewHref(Astro.url.searchParams, "calendar", todayMonth)} aria-current={view === "calendar" ? "page" : undefined} data-calendar-view="calendar"><Icon name="calendar3" />{t(locale, "calendar.calendarView")}</a>
    <a href={calendarViewHref(Astro.url.searchParams, "list", todayMonth)} aria-current={view === "list" ? "page" : undefined} data-calendar-view="list"><Icon name="list" />{t(locale, "calendar.listView")}</a>
  </nav>
  {view === "list" ? <EventListView /> : <EventCalendarView />}
</SiteLayout>

<style>
  .events-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .events-head h1 { margin: 0; font-size: clamp(1.5rem, 3.5vw, 2rem); }
  .subscribe-button { min-height: 44px; font-size: .8125rem; }
  .event-views { display: inline-flex; gap: .25rem; max-width: 100%; margin: 1.25rem 0 1.5rem; padding: .25rem; border: 1px solid var(--line); border-radius: 12px; background: rgba(7,16,28,.75); }
  .event-views a { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; min-height: 44px; padding: .6rem 1rem; color: var(--muted); border-radius: 8px; text-decoration: none; font-size: .875rem; font-weight: 600; }
  .event-views a:hover { color: var(--text); background: rgba(255,255,255,.05); }
  .event-views a[aria-current="page"] { color: var(--accent); background: rgba(var(--accent-rgb),.12); }
  @media (max-width: 480px) { .events-head { align-items: center; flex-wrap: wrap; } .event-views { display: flex; } .event-views a { flex: 1; } }
</style>
