---
import { dateInTimeZone } from "@frip-fan/core";
import EventCalendarView from "../components/EventCalendarView.astro";
import EventListView from "../components/EventListView.astro";
import BackLink from "../components/BackLink.astro";
import Icon from "../components/Icon.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { calendarAgendaHref, calendarViewHref } from "../lib/calendar-navigation";
import { getEnv } from "../lib/env";
import { getLocale, t } from "../lib/i18n";

const locale = getLocale(Astro.request);
const view = Astro.url.searchParams.get("view") === "list" ? "list" : "calendar";
const todayMonth = dateInTimeZone().slice(0, 7);
const subscriptionUrl = new URL("/calendar.ics", getEnv().SITE_URL || Astro.url.origin);
const webcalUrl = subscriptionUrl.href.replace(/^https?:/, "webcal:");
---
<SiteLayout title={t(locale, "calendar.title")} clientRouting>
  <div data-calendar-shell data-mode={view} data-today-month={todayMonth} data-locale={locale} data-error={t(locale, "search.error")}>
  <BackLink hidden={view !== "list"} href={calendarAgendaHref(Astro.url.searchParams, todayMonth)} label={t(locale, "search.backCalendar")} agendaReturn />
  <header class="events-head">
    <h1 data-calendar-title data-calendar-label={t(locale, "nav.calendar")} data-search-label={t(locale, "calendar.findEvents")}>{t(locale, view === "list" ? "calendar.findEvents" : "nav.calendar")}</h1>
    <div class="head-actions">
      <a hidden={view === "list"} data-calendar-subscribe class="button secondary subscribe-button" href={webcalUrl} title={t(locale, "home.subscriptionTitle", { url: subscriptionUrl.href })}><Icon name="calendar-plus" /><span class="desktop-label">{t(locale, "home.subscribe")}</span><span class="mobile-label">{t(locale, "calendar.subscribeShort")}</span></a>
      <a class="button secondary search-trigger" hidden={view === "list"} href={calendarViewHref(Astro.url.searchParams, "list", todayMonth)} data-calendar-view="list" data-search-toggle><Icon name="search" />{t(locale, "calendar.findEvents")}</a>
    </div>
  </header>
  <p role="alert" data-shell-error hidden></p>
  <div data-calendar-pane hidden={view === "list"}>{view !== "list" && <EventCalendarView />}</div>
  <div data-search-pane hidden={view !== "list"}>{view === "list" && <EventListView />}</div>
  </div>
</SiteLayout>

<script>
  import "../lib/calendar-search-shell";
</script>
<style>
  [hidden] { display: none !important; }
  .events-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .events-head h1 { margin: 0; font-size: clamp(1.5rem, 3.5vw, 2rem); }
  .head-actions { display: flex; align-items: center; gap: .5rem; }
  .mobile-label { display: none; }
  .subscribe-button { min-height: 44px; font-size: .8125rem; }
  .search-trigger { min-height: 44px; font-size: .8125rem; }
  .search-trigger[aria-busy="true"] { opacity: .65; }
  .events-head { margin-bottom: 1.5rem; }
  @media (max-width: 800px) {
    .desktop-label { display: none; }
    .mobile-label { display: inline; }
    .events-head { margin-bottom: 1rem; }
    .events-head h1 { min-width: 0; font-size: 1.375rem; }
    .head-actions { flex-shrink: 0; gap: .4rem; }
    .search-trigger { padding: .55rem .75rem; font-size: .8125rem; }
    .subscribe-button { padding: .55rem .65rem; }
  }
  @media (max-width: 480px) { .events-head { align-items: center; flex-wrap: wrap; } }
</style>
