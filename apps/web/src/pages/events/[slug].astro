---
import { getPublicEventBySlug, listPublicSetlistsForEvent } from "@frip-fan/core";
import BackLink from "../../components/BackLink.astro";
import { eventReturnLink } from "../../lib/event-navigation";
import Icon from "../../components/Icon.astro";
import { categoryLabels, displayEventStatus, formatDate, formatTime, statusLabel } from "../../lib/format";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getEnv } from "../../lib/env";
import { getLocale, t } from "../../lib/i18n";

const locale = getLocale(Astro.request);
const event = await getPublicEventBySlug(getEnv().DB, Astro.params.slug!);
if (!event) return Astro.redirect("/404", 302);
const setlists = await listPublicSetlistsForEvent(getEnv().DB, event.id);
const displayStatus = displayEventStatus(event);
const returnLink = eventReturnLink(Astro.url, event.start_date.slice(0, 7), locale);

// Search engines read this as the event itself: date, place and whether it still stands.
const schemaStatus = displayStatus === "cancelled" ? "EventCancelled" : displayStatus === "postponed" ? "EventPostponed" : "EventScheduled";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.title,
  url: new URL(`/events/${event.slug}`, getEnv().SITE_URL || Astro.url.origin).href,
  startDate: event.start_time ? `${event.start_date}T${event.start_time}` : event.start_date,
  ...(event.end_date ? { endDate: event.end_date } : {}),
  eventStatus: `https://schema.org/${schemaStatus}`,
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  performer: { "@type": "MusicGroup", name: "fripSide" },
  // location_label already carries the area, so the venue name alone keeps Place.name clean.
  ...(event.venue_label || event.location_label
    ? { location: { "@type": "Place", name: event.venue_label || event.location_label, ...(event.area_label ? { address: event.area_label } : {}) } }
    : {}),
  ...(event.remark ? { description: event.remark } : {}),
};
---
<SiteLayout title={event.title} description={`${formatDate(event.start_date, event.end_date, locale)} ${event.title}`} structuredData={structuredData}>
  <div class="event-page">
  <BackLink href={returnLink.href} label={t(locale, returnLink.label)} eventReturn />
  <article class="event-detail">
    <header data-page-entry>
      <div class="meta">
        <span class="tag live">{categoryLabels[event.category]}</span>
        <span class:list={["tag", displayStatus]}>{statusLabel(locale, displayStatus)}</span>
        {event.classification && <span class="tag">{event.classification}</span>}
      </div>
      <h1>{event.title}</h1>
      <p class="date">{formatDate(event.start_date, event.end_date, locale)}</p>
    </header>
    <div class="detail-grid">
      <section class="panel facts" data-page-entry>
        <div><small>TIME</small><strong>{formatTime(event, locale)}</strong></div>
        <div><small>LOCATION</small><strong>{event.location_label || t(locale, "common.pending")}</strong></div>
        <div><small>REGION</small><strong>{event.area_label || "—"}</strong></div>
        <div><small>MODE</small><strong>{event.location_mode}</strong></div>
        <div><small>TIMEZONE</small><strong>{event.timezone}</strong></div>
      </section>
      <section class="content">
        {event.remark ? <p>{event.remark}</p> : <p class="muted">{t(locale, "event.noRemark")}</p>}
        {setlists.length > 0 && (
          <div class="setlist-links">
            <p class="eyebrow">Setlist</p>
            {setlists.map((setlist) => (
              <a href={`/music/lives/${encodeURIComponent(setlist.id)}`}>
                <span><Icon name="list-stars" /> {setlist.title || t(locale, "event.setlistFallback", { label: setlist.performance_label })}</span>
                <small>{t(locale, "event.records", { count: setlist.entry_count })}</small>
              </a>
            ))}
          </div>
        )}
        <div class="sources">
          <p class="eyebrow">Sources</p>
          {event.sources?.map((source, index) => <a href={source.url} target="_blank" rel="noreferrer">{source.label || t(locale, "event.source", { index: index + 1 })} <Icon name="box-arrow-up-right" /></a>)}
        </div>
      </section>
    </div>
  </article>
  </div>
</SiteLayout>

<style>
  .event-page { max-width: 1000px; margin: 0 auto; }
  .event-detail { margin-top: 1.5rem; }
  .meta { display: flex; gap: .4rem; flex-wrap: wrap; }
  h1 { margin: 1.2rem 0; max-width: 1000px; }
  .date { color: var(--accent); font-size: 1.1rem; }
  .detail-grid { display: grid; grid-template-columns: .72fr 1.28fr; align-items: start; gap: clamp(2rem, 7vw, 6rem); margin-top: 4rem; }
  .facts { display: grid; gap: 1.4rem; }
  .facts div { display: grid; gap: .3rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .facts div:last-child { border-bottom: 0; }
  .facts small { color: var(--muted); font: .65rem/1 ui-monospace; letter-spacing: .1em; }
  .facts strong { font-size: .95rem; }
  .content { font-size: 1rem; line-height: 1.9; white-space: pre-wrap; }
  .sources { margin-top: 3rem; display: grid; justify-items: start; gap: .7rem; }
  .sources a { display: inline-flex; align-items: center; gap: .35rem; color: var(--accent); text-decoration: none; font-size: .9rem; }
  .setlist-links { display: grid; gap: .55rem; margin-top: 2rem; }
  .setlist-links p { margin-bottom: .15rem; }
  .setlist-links a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem .9rem; color: var(--text); border: 1px solid var(--line); border-radius: 11px; background: rgba(12,25,43,.62); text-decoration: none; white-space: normal; }
  .setlist-links a:hover { color: var(--accent); border-color: rgba(var(--accent-rgb),.35); }
  .setlist-links span { display: inline-flex; align-items: center; gap: .4rem; }
  .setlist-links small { color: var(--muted); }
  @media (max-width: 760px) { .detail-grid { grid-template-columns: 1fr; } }
</style>
