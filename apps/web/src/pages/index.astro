---
import { eventDetailHref } from "../lib/event-navigation";
import { dateInTimeZone, eventUpdateWindowStart, getActiveTour, getLastOfficialSyncAt, getMusicLibraryStats, getOnThisDay, getSongSpotlight, listEventUpdates, listReleaseYouTubeTracks, listReleases, listSetlists, listSongCatalog, listSongYouTubePreviews, searchEvents, songPhasesFromMask, type EventUpdateKind } from "@frip-fan/core";
import ActiveTourCard from "../components/ActiveTourCard.astro";
import Comments from "../components/Comments.astro";
import Icon from "../components/Icon.astro";
import ReleaseCover from "../components/ReleaseCover.astro";
import SongSpotlight from "../components/SongSpotlight.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getEnv } from "../lib/env";
import { categoryLabels, displayEventStatus, formatDate, formatTime, statusLabel } from "../lib/format";
import { getLocale, t } from "../lib/i18n";
import { youtubeLinks } from "../lib/music-listen";
import {
  formatMusicDate,
  releaseTypeLabel,
  setlistDisplayTitle,
} from "../lib/music";

const env = getEnv();
const locale = getLocale(Astro.request);
const db = env.DB;
const today = dateInTimeZone();
const [upcoming, recentSetlists, spotlight, topSongsCatalog, recentReleasesRaw, libraryStats, lastSyncAt, onThisDay, activeTour] = await Promise.all([
  searchEvents(db, { date_from: today, statuses: ["scheduled", "cancelled", "postponed"], limit: 10 }, true),
  listSetlists(db, { order: "desc", limit: 4 }),
  // The date is the seed, so the spotlight holds for the whole day and for every visitor and language.
  getSongSpotlight(db, today),
  listSongCatalog(db, 6),
  listReleases(db, { limit: 12 }),
  getMusicLibraryStats(db),
  getLastOfficialSyncAt(db),
  // The pill above the headline leads with what happened on this calendar day.
  getOnThisDay(db, today),
  // Shown only between a tour's first and last stop.
  getActiveTour(db, today),
]);
const topSongs = [...topSongsCatalog].sort((a, b) => b.show_count - a.show_count || b.performance_count - a.performance_count).slice(0, 6);
const maxTopSongShows = Math.max(1, ...topSongs.map((song) => song.show_count));
// Collapse same-day edition variants (e.g. WMS / Selected Edition) so the list shows distinct releases.
const seenReleaseDates = new Set<string>();
const recentReleases = recentReleasesRaw.filter((release) => {
  const key = release.release_date ?? release.id;
  if (seenReleaseDates.has(key)) return false;
  seenReleaseDates.add(key);
  return true;
}).slice(0, 3);
const [songPreviews, releasePreviews] = await Promise.all([
  listSongYouTubePreviews(db, topSongs.map((song) => song.id)),
  listReleaseYouTubeTracks(db, recentReleases.map((release) => release.id)),
]);
// Claim the daily sync only while it is actually running: the line disappears once the last
// completed run falls out of the window, rather than promising something that stopped.
const SYNC_NOTE_DAYS = 7;
const lastSyncDate = lastSyncAt ? dateInTimeZone(new Date(lastSyncAt)) : null;
const showSyncNote = Boolean(lastSyncDate && Date.parse(today) - Date.parse(lastSyncDate) <= SYNC_NOTE_DAYS * 86_400_000);
const siteUrl = env.SITE_URL || Astro.url.origin;
const SOURCE_URL = "https://github.com/frip-fans/fripsi.de";
// Split rather than interpolate markup, so the sentence stays one translatable string.
const [subtitleBefore, subtitleAfter] = t(locale, "home.heroSubtitle").split("{link}");
const subscriptionUrl = new URL("/calendar.ics", siteUrl);
const webcalUrl = subscriptionUrl.href.replace(/^https?:/, "webcal:");
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "fripSi.de Fan Site",
  url: new URL("/", siteUrl).href,
  inLanguage: locale,
  description: t(locale, "site.description"),
  about: { "@type": "MusicGroup", name: "fripSide" },
};
const next = upcoming[0];
// What actually changed recently, read from the audit log: events.updated_at also moves for bulk
// archive imports, which would announce a 2005 show as freshly updated.
const eventUpdates = await listEventUpdates(db, upcoming.map((event) => event.id), eventUpdateWindowStart(today));
const updateLabels: Record<EventUpdateKind, Parameters<typeof t>[1]> = {
  new: "home.updateNew",
  status: "home.updateStatus",
  time: "home.updateTime",
  venue: "home.updateVenue",
  details: "home.updateDetails",
};
const updateLabel = (eventId: string) => {
  const update = eventUpdates.get(eventId);
  return update ? t(locale, updateLabels[update.kind]) : null;
};
const daysUntilNext = next ? Math.max(0, Math.round((Date.parse(next.start_date) - Date.parse(today)) / 86_400_000)) : 0;
const nextStatus = next ? displayEventStatus(next, today) : "scheduled";
const nextCountdown = !next
  ? ""
  : nextStatus !== "scheduled"
    ? statusLabel(locale, nextStatus)
    : daysUntilNext === 0
    ? t(locale, "home.countdownToday")
    : daysUntilNext === 1
      ? t(locale, "home.countdownTomorrow")
      : t(locale, "home.countdownDays", { count: daysUntilNext });
// The stream is the schedule itself: every upcoming event after the pinned one, soonest first. The
// daily cards have no date of their own, so they are slotted in at fixed positions between them.
type UpcomingEvent = (typeof upcoming)[number];
type FeedEntry =
  | { kind: "event"; event: UpcomingEvent }
  | { kind: "spotlight" | "today" | "songs" | "explore" };
const news: FeedEntry[] = upcoming.slice(1).map((event) => ({ kind: "event", event }));
const feedCategories = [...new Set(upcoming.slice(1).map((event) => event.category))];
const daily: Array<[number, FeedEntry | null]> = [
  [1, onThisDay ? { kind: "today" } : null],
  [3, spotlight ? { kind: "spotlight" } : null],
  [5, topSongs.length > 0 ? { kind: "songs" } : null],
  [7, { kind: "explore" }],
];
const feed: FeedEntry[] = [];
news.forEach((entry, index) => {
  for (const [slot, card] of daily) if (slot === index && card) feed.push(card);
  feed.push(entry);
});
for (const [slot, card] of daily) if (slot >= news.length && card) feed.push(card);
const dateBadge = (event: UpcomingEvent) => {
  const singleDay = !event.end_date || event.end_date === event.start_date;
  return `${event.start_date.slice(5).replace("-", ".")}${!singleDay && event.end_date ? `–${event.end_date.slice(5).replace("-", ".")}` : ""}`;
};
---
<SiteLayout structuredData={structuredData}>
  <div class="home-stage" data-page-entry>
    <h1 class="home-h1">fripSi.de Fan Site</h1>

    <div class="home-main">
      <div class="home-pinned">
        <section class="signal panel" aria-label={t(locale, "home.next")}>
          <div class="panel-top"><span>{t(locale, "home.next")}</span>{next && <b class="signal-countdown">{nextCountdown}</b>}<i></i></div>
          {next ? (
            <>
              <div class="signal-head">
                <strong>{next.start_date.slice(5).replace("-", ".")}</strong>
                <div class="signal-meta">
                  <span class:list={["tag", next.category.toLowerCase()]}>{categoryLabels[next.category]}</span>
                  {next.classification && <span class="tag">{next.classification}</span>}
                  {updateLabel(next.id) && <span class="tag update">{updateLabel(next.id)}</span>}
                </div>
              </div>
              <h2>{next.display_title ?? next.title}</h2>
              <div class="signal-footer">
                <div class="signal-details">
                  <p class="signal-time">{(!next.end_date || next.end_date === next.start_date) ? formatTime(next, locale) : `${formatDate(next.start_date, next.end_date, locale)} · ${formatTime(next, locale)}`}</p>
                  <p class="signal-venue">{next.location_label || t(locale, "common.locationPending")}</p>
                </div>
                <a href={eventDetailHref(next.slug, Astro.url, locale)} aria-label={t(locale, "common.view", { title: next.title })}><Icon name="chevron-right" size=".85rem" /></a>
              </div>
            </>
          ) : (
            <div class="no-signal"><strong>—</strong><h2>{t(locale, "home.waiting")}</h2><p>{t(locale, "home.noUpcoming")}</p></div>
          )}
        </section>

        {activeTour && <ActiveTourCard tour={activeTour} today={today} />}
      </div>

      <section class="home-feed" aria-labelledby="home-feed-title">
        <div class="feed-bar">
          <h2 id="home-feed-title"><Icon name="tickets" />{t(locale, "home.moreEvents")}</h2>
          {feedCategories.length > 1 && (
            <div class="feed-filter" role="group" aria-label={t(locale, "home.feedFilterLabel")}>
              <button type="button" data-feed-filter="all" aria-pressed="true">{t(locale, "common.all")}</button>
              {feedCategories.map((category) => <button type="button" data-feed-filter={category.toLowerCase()} aria-pressed="false">{categoryLabels[category]}</button>)}
            </div>
          )}
        </div>

        <ol class="feed" data-feed data-filter="all">
          {feed.map((entry) => {
            if (entry.kind === "event") {
              const event = entry.event;
              const displayStatus = displayEventStatus(event);
              return (
                <li data-kind={event.category.toLowerCase()}>
                  <a class="card card-link event-card" href={eventDetailHref(event.slug, Astro.url, locale)} data-astro-prefetch="tap">
                    <span class="event-date"><strong>{dateBadge(event)}</strong><small>{event.start_date.slice(0, 4)}</small></span>
                    <span class="event-body">
                      <span class="event-tags">
                        <span class:list={["tag", event.category.toLowerCase()]}>{categoryLabels[event.category]}</span>
                        {displayStatus !== "scheduled" && <span class:list={["tag", displayStatus]}>{statusLabel(locale, displayStatus)}</span>}
                        {event.classification && <span class="tag">{event.classification}</span>}
                        {updateLabel(event.id) && <span class="tag update">{updateLabel(event.id)}</span>}
                      </span>
                      <strong>{event.display_title ?? event.title}</strong>
                      <span class="card-sub">{[event.location_label, formatTime(event, locale)].filter(Boolean).join(" · ")}</span>
                    </span>
                  </a>
                </li>
              );
            }
            if (entry.kind === "spotlight") return (
              <li data-kind="daily" class="feed-spotlight">{spotlight && <SongSpotlight spotlight={spotlight} locale={locale} archiveShows={libraryStats.setlist_count} />}</li>
            );
            if (entry.kind === "today") return onThisDay && (
              <li data-kind="daily">
                <a class="card card-link today-card" href={eventDetailHref(onThisDay.event.slug, Astro.url, locale)}>
                  <span class="card-kind"><Icon name="archive" /><span>{t(locale, "home.onThisDay")}</span><time datetime={onThisDay.event.start_date}>{onThisDay.event.start_date.replaceAll("-", ".")}</time></span>
                  <strong>{onThisDay.event.display_title ?? onThisDay.event.title}</strong>
                </a>
              </li>
            );
            if (entry.kind === "songs") return (
              <li data-kind="daily">
                <section class="card top-songs-panel" aria-labelledby="home-top-songs-title">
                  <div class="top-songs-head">
                    <h3 id="home-top-songs-title" class="card-kind"><Icon name="audio-lines" /><span>{t(locale, "music.mostPerformed")}</span></h3>
                    <a class="top-songs-more" href="/music/songs">{t(locale, "music.nav.songs")} <Icon name="chevron-right" size=".75rem" /></a>
                  </div>
                  <ol class="top-songs-list" data-youtube-list>
                    {topSongs.map((song, index) => {
                      const phases = songPhasesFromMask(song.phase_mask);
                      const phaseLabel = phases.length > 1
                        ? t(locale, "music.phaseJoint", { phases: phases.join("·") })
                        : phases.length === 1 ? t(locale, "music.phaseLabel", { phase: phases[0] }) : "";
                      const subMeta = [phaseLabel, song.first_release_date?.slice(0, 4) ?? ""].filter(Boolean).join(" · ");
                      const songHref = `/music/songs/${encodeURIComponent(song.slug)}`;
                      const youtube = youtubeLinks(songPreviews.get(song.id));
                      const playLabel = t(locale, "music.youtubePlay", { title: song.title });
                      return (
                        <li class="top-song-item">
                          <a class:list={["top-song-row", { "is-podium": index < 3 }]} href={songHref}>
                            <span class="top-song-rank">{index + 1}</span>
                            <span class="top-song-cover"><ReleaseCover url={song.cover_url} alt="" /></span>
                            <span class="top-song-info"><strong translate="no">{song.title}</strong>{subMeta && <small>{subMeta}</small>}</span>
                            <span class="top-song-metric">
                              <b>{t(locale, "music.showsShort", { count: song.show_count })}</b>
                              <i aria-hidden="true"><span style={`--share: ${Math.max(8, Math.round((song.show_count / maxTopSongShows) * 100))}%`}></span></i>
                            </span>
                          </a>
                          {youtube && <a class="cover-play" href={youtube.page} target="_blank" rel="noreferrer"
                            data-track-youtube={youtube.embed} data-track-title={song.title} data-track-song={songHref}
                            aria-label={playLabel} title={playLabel}><span><Icon name="play-fill" /></span></a>}
                        </li>
                      );
                    })}
                  </ol>
                </section>
              </li>
            );
            return (
              <li data-kind="daily" class="feed-pair">
                <a class="card card-link explore-card" href="/quiz">
                  <span class="card-kind"><Icon name="list-stars" /><span>{t(locale, "quiz.todayLabel")}</span></span>
                  <strong>{t(locale, "quiz.title")}</strong>
                  <span class="card-sub">{t(locale, "quiz.description")}</span>
                </a>
                <a class="card card-link explore-card" href="/journey">
                  <span class="card-kind"><Icon name="globe-americas" /><span>{t(locale, "nav.journey")}</span></span>
                  <strong translate="no">{t(locale, "journey.title")}</strong>
                  <span class="card-sub">{t(locale, "journey.description")}</span>
                </a>
              </li>
            );
          })}
        </ol>
        <div class="feed-actions">
          <a class="button secondary" href="/calendar"><Icon name="calendar3" />{t(locale, "home.allCalendar")}</a>
          <a class="button secondary" href={webcalUrl} title={t(locale, "home.subscriptionTitle", { url: subscriptionUrl.href })}><Icon name="calendar-plus" />{t(locale, "home.subscribe")}</a>
        </div>
      </section>

      <Comments locale={locale} thread="site" title={t(locale, "community.discussionTitle")} />
    </div>

    <div class="home-rail">
      {recentSetlists.length > 0 && (
        <section class="rail-list panel" aria-labelledby="home-setlists-title">
          <div class="rail-head">
            <h2 id="home-setlists-title"><Icon name="list-music" />{t(locale, "home.latestSetlists")}</h2>
            <a class="rail-link" href="/music/lives">{t(locale, "home.allSetlists")} <Icon name="chevron-right" size=".75rem" /></a>
          </div>
          <ol class="rail-rows">
            {recentSetlists.map((setlist) => (
              <li>
                <a class="rail-row" href={`/music/lives/${encodeURIComponent(setlist.id)}`}>
                  <span class="rail-date"><strong>{setlist.start_date.slice(5).replace("-", ".")}</strong><small>{setlist.start_date.slice(0, 4)}</small></span>
                  <span class="rail-main">
                    <b>{setlistDisplayTitle(setlist)}</b>
                    <small>{[t(locale, "music.songsCount", { count: setlist.entry_count }), setlist.venue].filter(Boolean).join(" · ")}</small>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}

      {recentReleases.length > 0 && (
        <section class="rail-list panel" aria-labelledby="home-releases-title">
          <div class="rail-head">
            <h2 id="home-releases-title"><Icon name="music-note-beamed" />{t(locale, "music.releaseNewest")}</h2>
            <a class="rail-link" href="/music/releases">{t(locale, "music.nav.releases")} <Icon name="chevron-right" size=".75rem" /></a>
          </div>
          <ol class="rail-rows">
            {recentReleases.map((release) => {
              // The release's playable tracks, queued in track order.
              const queue = (releasePreviews.get(release.id) ?? []).flatMap((track) => {
                const youtube = youtubeLinks(track.youtube_video_id);
                return youtube ? [{ ...youtube, title: track.display_title, href: `/music/songs/${encodeURIComponent(track.song_slug)}#music-preview` }] : [];
              });
              const playLabel = t(locale, "music.youtubePlay", { title: release.title });
              return (
              <li class="rail-item">
                <a class="rail-row" href={`/music/releases/${encodeURIComponent(release.slug)}`}>
                  <span class="rail-cover"><ReleaseCover url={release.cover_url} alt="" /></span>
                  <span class="rail-main">
                    <b translate="no">{release.title}</b>
                    <small>{[releaseTypeLabel(release.release_type, locale), formatMusicDate(release.release_date, locale)].filter(Boolean).join(" · ")}</small>
                  </span>
                </a>
                {queue[0] && <a class="cover-play" href={queue[0].page} target="_blank" rel="noreferrer"
                  data-youtube-queue={JSON.stringify(queue.map(({ embed, title, href }) => ({ embed, title, href })))}
                  aria-label={playLabel} title={playLabel}><span><Icon name="play-fill" /></span></a>}
              </li>
              );
            })}
          </ol>
        </section>
      )}

      <nav class="library panel" aria-label={t(locale, "music.nav.label")}>
        <a href="/music/lives"><strong>{libraryStats.setlist_count}</strong><span>{t(locale, "music.nav.lives")}</span></a>
        <a href="/music/songs"><strong>{libraryStats.song_count}</strong><span>{t(locale, "music.nav.songs")}</span></a>
        <a href="/music/releases"><strong>{libraryStats.release_count}</strong><span>{t(locale, "music.nav.releases")}</span></a>
      </nav>

      <div class="about">
        <p class="about-lyric" lang="en" translate="no">This desire is bound in the melody.</p>
        <p>
          {subtitleBefore}<a class="about-source" href={SOURCE_URL} target="_blank" rel="external noopener noreferrer">{t(locale, "home.openSource")}</a>{subtitleAfter}
        </p>
        {showSyncNote && lastSyncDate && <p>{t(locale, "home.syncNote", { date: formatMusicDate(lastSyncDate, locale) })}</p>}
        <button class="motion-toggle" type="button" data-home-motion aria-label={t(locale, "home.motionLabel")} aria-pressed="false" data-pause-label={t(locale, "home.pauseMotion")} data-resume-label={t(locale, "home.resumeMotion")}>
          <Icon name="pause-fill" /><span>{t(locale, "home.pauseMotion")}</span>
        </button>
      </div>
    </div>
  </div>
</SiteLayout>

<script>
  // The motion toggle only governs the background crossfade.
  let cleanupHome: (() => void) | undefined;
  const setupHome = () => {
    cleanupHome?.();
    const motionToggle = document.querySelector<HTMLButtonElement>("[data-home-motion]");
    if (!motionToggle) return;
    const controller = new AbortController();
    const { signal } = controller;

    // The feed filter only hides cards that are already on the page, so it needs no request.
    const feedList = document.querySelector<HTMLElement>("[data-feed]");
    const filterButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-feed-filter]")];
    for (const button of filterButtons) {
      button.addEventListener("click", () => {
        if (feedList) feedList.dataset.filter = button.dataset.feedFilter ?? "all";
        for (const other of filterButtons) other.setAttribute("aria-pressed", String(other === button));
      }, { signal });
    }
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const updateMotionToggle = () => {
      const paused = document.documentElement.dataset.homeMotionPaused === "true";
      motionToggle.setAttribute("aria-pressed", String(paused));
      motionToggle.querySelector("span")!.textContent = (paused ? motionToggle.dataset.resumeLabel : motionToggle.dataset.pauseLabel) ?? "";
      motionToggle.hidden = reducedMotion.matches;
    };
    motionToggle.addEventListener("click", () => {
      document.documentElement.dataset.homeMotionPaused = String(document.documentElement.dataset.homeMotionPaused !== "true");
      updateMotionToggle();
      document.dispatchEvent(new Event("home-motion-change"));
    }, { signal });
    updateMotionToggle();
    reducedMotion.addEventListener("change", updateMotionToggle, { signal });
    cleanupHome = () => controller.abort();
  };
  document.addEventListener("astro:before-swap", () => cleanupHome?.());
  document.addEventListener("astro:page-load", setupHome);
  setupHome();
</script>

<style>
  /* A pinned next event, then one stream of upcoming events; setlists, releases and the library sit in a side rail. */
  .home-stage { display: grid; grid-template-columns: minmax(0, 1fr) 20.5rem; gap: 1.25rem; align-items: start; }
  .home-h1 { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .home-main { display: grid; gap: 1.25rem; min-width: 0; }
  .home-pinned { display: grid; gap: .75rem; min-width: 0; }
  .home-pinned :global(.tour-live) { margin-top: 0; }
  .home-rail { position: sticky; top: 1rem; display: grid; gap: .75rem; min-width: 0; }
  .home-main :global(.comments) { margin-top: 1.25rem; }

  /* Signal Card (Coming Up Next) */
  .signal { position: relative; padding: 1.2rem 1.35rem; display: flex; flex-direction: column; justify-content: flex-start; min-width: 0; overflow: hidden; border-color: rgba(var(--accent-rgb), .34); background: linear-gradient(145deg, rgba(16, 31, 52, .88), rgba(9, 19, 34, .84)); }
  .signal::before { content: ""; position: absolute; inset: 0 -45% -18%; background: repeating-radial-gradient(circle at 50% 100%, transparent 0 calc(6% - 1px), rgba(var(--accent-rgb),.13) 6% calc(6% + 1px)); transform: rotate(-8deg); pointer-events: none; }
  .panel-top { position: relative; display: flex; justify-content: space-between; align-items: center; gap: .65rem; margin-bottom: .65rem; flex-shrink: 0; color: var(--muted); font: 700 .68rem/1 ui-monospace; text-transform: uppercase; letter-spacing: .12em; }
  .panel-top span { margin-right: auto; }
  .panel-top i { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 18px var(--accent); }
  .signal-countdown { color: var(--accent); font-weight: 700; letter-spacing: .06em; white-space: nowrap; }
  .signal-head { position: relative; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem .75rem; }
  .signal-head > strong, .no-signal strong { color: var(--accent); font-size: clamp(2.6rem, 4.8vw, 3.6rem); line-height: .95; letter-spacing: -.07em; position: relative; font-variant-numeric: tabular-nums; }
  .signal-meta { display: flex; flex-wrap: wrap; gap: .35rem; justify-content: flex-end; }
  .signal-meta .tag.update { color: var(--accent); border-color: rgba(var(--accent-rgb), .5); background: rgba(var(--accent-rgb), .1); }
  .signal h2 { font-size: 1.12rem; line-height: 1.4; overflow-wrap: anywhere; margin: .65rem 0 .6rem; position: relative; }
  .signal-footer { display: flex; align-items: center; gap: .65rem; margin-top: auto; padding-top: .65rem; border-top: 1px solid var(--line); }
  .signal-details { flex: 1; min-width: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .75rem; }
  .signal p { margin: 0; color: var(--muted); position: relative; font-size: .8rem; line-height: 1.45; overflow-wrap: anywhere; }
  .signal .signal-venue { color: #c8d9e7; }
  .signal a { flex: 0 0 auto; color: var(--muted); opacity: .55; margin: 0; padding: 0; font-size: .85rem; text-decoration: none; display: inline-flex; align-items: center; gap: .35rem; }
  .signal:hover a, .signal:focus-within a { color: var(--accent); opacity: 1; }
  .signal:has(a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .signal a:focus-visible { outline: none; }
  .signal a::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }


  /* Feed */
  .feed-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; margin-bottom: .75rem; }
  .feed-bar h2 { display: flex; align-items: center; gap: .45rem; margin: 0; font-size: 1.05rem; }
  .feed-bar h2 > :global(.icon) { color: var(--accent); }
  .feed-filter { display: flex; gap: .35rem; isolation: isolate; }
  /* The pill is drawn inside a 44px-tall button, so the touch target stays full height. */
