---
import { eventDetailHref } from "../lib/event-navigation";
import { dateInTimeZone, eventUpdateWindowStart, getLastOfficialSyncAt, getMusicLibraryStats, getOnThisDay, getSongSpotlight, listEventUpdates, listSetlists, searchEvents, type EventUpdateKind } from "@frip-fan/core";
import EventCard from "../components/EventCard.astro";
import CommunityDiscussion from "../components/CommunityDiscussion.astro";
import Icon from "../components/Icon.astro";
import SongSpotlight from "../components/SongSpotlight.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getEnv } from "../lib/env";
import { displayEventStatus, statusLabel } from "../lib/format";
import { getLocale, t } from "../lib/i18n";
import {
  formatMusicDate,
  setlistCompletenessLabel,
  setlistDisplayTitle,
  setlistEventTypeLabel,
} from "../lib/music";

const env = getEnv();
const locale = getLocale(Astro.request);
const db = env.DB;
const today = dateInTimeZone();
const [upcoming, recentSetlists, spotlight, libraryStats, lastSyncAt, onThisDay] = await Promise.all([
  searchEvents(db, { date_from: today, statuses: ["scheduled", "cancelled", "postponed"], limit: 4 }, true),
  listSetlists(db, { order: "desc", limit: 3 }),
  // The date is the seed, so the spotlight holds for the whole day and for every visitor and language.
  getSongSpotlight(db, today),
  getMusicLibraryStats(db),
  getLastOfficialSyncAt(db),
  // The pill above the headline leads with what happened on this calendar day.
  getOnThisDay(db, today),
]);
// Claim the daily sync only while it is actually running: the line disappears once the last
// completed run falls out of the window, rather than promising something that stopped.
const SYNC_NOTE_DAYS = 7;
const lastSyncDate = lastSyncAt ? dateInTimeZone(new Date(lastSyncAt)) : null;
const showSyncNote = Boolean(lastSyncDate && Date.parse(today) - Date.parse(lastSyncDate) <= SYNC_NOTE_DAYS * 86_400_000);
const siteUrl = env.SITE_URL || Astro.url.origin;
const SOURCE_URL = "https://github.com/frip-fans/fripsi.de";
// Split rather than interpolate markup, so the sentence stays one translatable string.
const [subtitleBefore, subtitleAfter] = t(locale, "home.heroSubtitle").split("{link}");
const subscriptionUrl = new URL("/calendar.ics", siteUrl);
const webcalUrl = subscriptionUrl.href.replace(/^https?:/, "webcal:");
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "fripSi.de Fan Site",
  url: new URL("/", siteUrl).href,
  inLanguage: locale,
  description: t(locale, "site.description"),
  about: { "@type": "MusicGroup", name: "fripSide" },
};
const next = upcoming[0];
const moreEvents = upcoming.slice(1);
// What actually changed recently, read from the audit log: events.updated_at also moves for bulk
// archive imports, which would announce a 2005 show as freshly updated.
const eventUpdates = await listEventUpdates(db, upcoming.map((event) => event.id), eventUpdateWindowStart(today));
const updateLabels: Record<EventUpdateKind, Parameters<typeof t>[1]> = {
  new: "home.updateNew",
  status: "home.updateStatus",
  time: "home.updateTime",
  venue: "home.updateVenue",
  details: "home.updateDetails",
};
const updateLabel = (eventId: string) => {
  const update = eventUpdates.get(eventId);
  return update ? t(locale, updateLabels[update.kind]) : null;
};
const daysUntilNext = next ? Math.max(0, Math.round((Date.parse(next.start_date) - Date.parse(today)) / 86_400_000)) : 0;
const nextStatus = next ? displayEventStatus(next, today) : "scheduled";
const nextCountdown = !next
  ? ""
  : nextStatus !== "scheduled"
    ? statusLabel(locale, nextStatus)
    : daysUntilNext === 0
    ? t(locale, "home.countdownToday")
    : daysUntilNext === 1
      ? t(locale, "home.countdownTomorrow")
      : t(locale, "home.countdownDays", { count: daysUntilNext });
---
<SiteLayout structuredData={structuredData}>
  <section class="hero" data-page-entry>
    <div class="hero-copy">
      {onThisDay && (
        <a class="today-pill" href={eventDetailHref(onThisDay.event.slug, Astro.url, locale)}>
          <Icon name="archive" size=".8rem" />
          <span class="today-pill-label">{t(locale, "home.onThisDay")}</span>
          <time datetime={onThisDay.event.start_date}>{onThisDay.event.start_date.replaceAll("-", ".")}</time>
          <span class="today-pill-event"><span>{onThisDay.event.display_title ?? onThisDay.event.title}</span></span>
          <Icon name="chevron-right" size=".7rem" />
        </a>
      )}
      <h1 class="hero-title" lang="en" translate="no">
        <span class="title-lead">This desire</span>
        <span class="title-solid">is bound in the melody.</span>
      </h1>
      <p class="hero-subtitle">
        {subtitleBefore}<a class="hero-source" href={SOURCE_URL} target="_blank" rel="external noopener noreferrer">{t(locale, "home.openSource")}</a>{subtitleAfter}
      </p>
    </div>

    <aside class="signal panel">
      <div class="panel-top"><span>{t(locale, "home.next")}</span>{next && <b class="signal-countdown">{nextCountdown}</b>}<i></i></div>
      {next ? (
        <>
          <strong>{next.start_date.slice(5).replace("-", ".")}</strong>
          <h2>{next.display_title ?? next.title}</h2>
          {updateLabel(next.id) && <p class="signal-update"><span class="tag update">{updateLabel(next.id)}</span></p>}
          <div class="signal-footer">
            <p>{next.location_label || t(locale, "common.locationPending")}</p>
            <a href={eventDetailHref(next.slug, Astro.url, locale)} aria-label={t(locale, "common.view", { title: next.title })}><Icon name="chevron-right" size=".85rem" /></a>
          </div>
        </>
      ) : (
        <div class="no-signal"><strong>—</strong><h2>{t(locale, "home.waiting")}</h2><p>{t(locale, "home.noUpcoming")}</p></div>
      )}
    </aside>

    <div class="hero-actions">
      <div class="actions">
        <a class="button" href="/calendar"><Icon name="calendar3" />{t(locale, "nav.calendar")}</a>
        <a class="button secondary setlist-button" href="/music/lives"><Icon name="music-note-list" />{t(locale, "nav.music")}</a>
        <a class="button secondary subscribe-action" href={webcalUrl} title={t(locale, "home.subscriptionTitle", { url: subscriptionUrl.href })}><Icon name="calendar-plus" /><span class="label-full">{t(locale, "home.subscribe")}</span><span class="label-short">{t(locale, "calendar.subscribeShort")}</span></a>
      </div>
      <button class="motion-toggle" type="button" data-home-motion aria-label={t(locale, "home.motionLabel")} aria-pressed="false" data-pause-label={t(locale, "home.pauseMotion")} data-resume-label={t(locale, "home.resumeMotion")}>
        <Icon name="pause-fill" /><span>{t(locale, "home.pauseMotion")}</span>
      </button>
    </div>
  </section>

  {moreEvents.length > 0 && (
    <>
      <div class="section-heading latest-events-heading">
        <h2><Icon name="tickets" />{t(locale, "home.moreEvents")}</h2>
        <a class="section-link all-calendar" href="/calendar">{t(locale, "home.allCalendar")} <Icon name="chevron-right" size=".75rem" /></a>
      </div>
      <section class:list={["event-list", "event-grid", `count-${moreEvents.length}`]}>
        {moreEvents.map((event) => <EventCard event={event} timeInHeader updateLabel={updateLabel(event.id)} />)}
      </section>
    </>
  )}

  {showSyncNote && lastSyncDate && (
    <p class="sync-note">{t(locale, "home.syncNote", { date: formatMusicDate(lastSyncDate, locale) })}</p>
  )}

  <section class="recent-setlists" aria-labelledby="music-library-title">
    <div class="section-heading">
      <h2 id="music-library-title"><Icon name="list-music" />{t(locale, "home.musicLibrary")}</h2>
      <a class="section-link recent-setlists-all" href="/music/lives">{t(locale, "home.allSetlists")} <Icon name="chevron-right" size=".75rem" /></a>
    </div>
    {spotlight && <SongSpotlight spotlight={spotlight} locale={locale} archiveShows={libraryStats.setlist_count} />}
    <h3 class="subsection-title">{t(locale, "home.latestSetlists")}</h3>
    {recentSetlists.length > 0 ? (
      <div class="recent-setlist-grid">
        {recentSetlists.map((setlist) => (
          <a class="recent-setlist-card" href={`/music/lives/${encodeURIComponent(setlist.id)}`}>
            <div class="recent-setlist-top">
              <time datetime={setlist.start_date}>{formatMusicDate(setlist.start_date, locale)}</time>
              {setlist.event_classification && (
                <span class:list={[
                  "recent-setlist-type",
                  {
                    "is-solo": setlist.event_classification === "专场",
                    "is-festival": setlist.event_classification === "拼盘",
                  },
                ]}>{setlistEventTypeLabel(setlist.event_classification, locale)}</span>
              )}
            </div>
            <h3>{setlistDisplayTitle(setlist)}</h3>
            <p>{[setlist.venue, setlist.region].filter(Boolean).join(" · ") || t(locale, "common.locationPending")}</p>
            <div class="recent-setlist-meta">
              <span>{t(locale, "music.songsCount", { count: setlist.entry_count })}</span>
              <span>{setlistCompletenessLabel(setlist.completeness, locale)}</span>
              <Icon name="chevron-right" size=".85rem" />
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty panel">{t(locale, "home.noSetlists")}</div>
    )}
  </section>

  <a class="journey-teaser panel" href="/journey">
    <span class="journey-teaser-text">
      <span class="journey-teaser-label"><Icon name="globe-americas" />{t(locale, "journey.title")}</span>
      <span class="journey-teaser-description">{t(locale, "journey.description")}</span>
    </span>
    <span class="journey-teaser-cta">{t(locale, "home.journeyCta")} <Icon name="chevron-right" size=".75rem" /></span>
  </a>

  <CommunityDiscussion locale={locale} />

</SiteLayout>

<script>
  // The toggle now only governs the background crossfade; the hero text no longer animates.
  let cleanupHome: (() => void) | undefined;
  const setupHome = () => {
    cleanupHome?.();
    const motionToggle = document.querySelector<HTMLButtonElement>("[data-home-motion]");
    if (!motionToggle) return;
    const controller = new AbortController();
    const { signal } = controller;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const updateMotionToggle = () => {
      const paused = document.documentElement.dataset.homeMotionPaused === "true";
      motionToggle.setAttribute("aria-pressed", String(paused));
      motionToggle.querySelector("span")!.textContent = (paused ? motionToggle.dataset.resumeLabel : motionToggle.dataset.pauseLabel) ?? "";
      motionToggle.hidden = reducedMotion.matches;
    };
    motionToggle.addEventListener("click", () => {
      document.documentElement.dataset.homeMotionPaused = String(document.documentElement.dataset.homeMotionPaused !== "true");
      updateMotionToggle();
      document.dispatchEvent(new Event("home-motion-change"));
    }, { signal });
    updateMotionToggle();
    reducedMotion.addEventListener("change", updateMotionToggle, { signal });
    cleanupHome = () => controller.abort();
  };
  document.addEventListener("astro:before-swap", () => cleanupHome?.());
  document.addEventListener("astro:page-load", setupHome);
  setupHome();
</script>

<style>
  .hero { display: grid; grid-template-columns: 1.25fr .75fr; align-items: start; gap: 0 clamp(1.5rem, 5vw, 4rem); padding: 2rem 0 .5rem; }
  .hero-copy { grid-column: 1; grid-row: 1; min-width: 0; }
  /* One shade for the whole left column — headline, subtitle and buttons alike — so no edge of
     it cuts across the copy while the backdrop rotates to the busier photo. */
  .hero { position: relative; isolation: isolate; }
  .hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -2.5rem auto -2rem -6rem;
    width: min(64rem, 82%);
    pointer-events: none;
    background: radial-gradient(ellipse 70% 62% at 40% 50%, rgba(7,16,28,.92) 0%, rgba(7,16,28,.78) 42%, rgba(7,16,28,.34) 70%, transparent 100%);
    /* The radial alone still meets the viewport edge as a hard line; this fades that edge out. */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 16%);
    mask-image: linear-gradient(to right, transparent 0, #000 16%);
  }
  .signal { grid-column: 2; grid-row: 1 / span 2; }
  .hero-actions { grid-column: 1; grid-row: 2; align-self: start; margin-top: 1.6rem; }
  /* Today's archive entry rides above the headline: real content, but never the main event. */
  .today-pill { display: inline-flex; align-items: center; gap: .45rem; max-width: 100%; margin-bottom: 1.1rem; padding: .4rem .8rem; color: var(--muted); border: 1px solid rgba(159, 180, 211, .22); border-radius: 999px; background: rgba(7, 16, 28, .72); font-size: .78rem; text-decoration: none; backdrop-filter: blur(10px); transition: border-color .18s, color .18s; }
  .today-pill:hover { color: var(--text); border-color: rgba(var(--accent-rgb), .55); }
  .today-pill :global(.icon) { flex: 0 0 auto; color: var(--accent); }
  .today-pill-label { flex: 0 0 auto; font-weight: 650; }
  .today-pill time { flex: 0 0 auto; color: var(--text); font-variant-numeric: tabular-nums; }
  /* Collapsed the pill is just label and date; hovering widens it and scrolls the event name
     past the window. No title attribute, so no native tooltip covers the headline, and the full
     name stays in the DOM for screen readers. min(0px, …) keeps a short name still. */
  .today-pill-event { --pill-window: 17rem; max-width: 0; margin-left: -.45rem; overflow: hidden; white-space: nowrap; transition: max-width .32s ease, margin-left .32s ease; }
  .today-pill-event > span { display: inline-block; }
  .today-pill:hover .today-pill-event, .today-pill:focus-visible .today-pill-event { max-width: var(--pill-window); margin-left: 0; mask-image: linear-gradient(to right, #000 88%, transparent); }
  .today-pill:hover .today-pill-event > span, .today-pill:focus-visible .today-pill-event > span {
    animation: pill-marquee 5s linear .8s infinite alternate;
  }
  @keyframes pill-marquee { to { transform: translateX(min(0px, calc(var(--pill-window) - 100%))); } }
  @media (prefers-reduced-motion: reduce) {
    .today-pill-event { transition: none; }
    .today-pill:hover .today-pill-event > span, .today-pill:focus-visible .today-pill-event > span { animation: none; }
  }
  .hero-title { display: grid; width: fit-content; max-width: 100%; align-content: start; gap: .14em; margin: 0; font-size: clamp(2rem, 4.2vw, 3.4rem); line-height: 1.06; letter-spacing: -.045em; }
  .title-lead, .title-solid { display: block; }
  .title-lead { color: var(--text); }
  .title-solid { color: var(--text); font-size: .72em; line-height: 1.08; letter-spacing: -.045em; }
  @supports (-webkit-text-stroke: 1px currentColor) {
    .title-solid { color: transparent; -webkit-text-stroke: 1.5px var(--text); }
  }
  .hero-subtitle { max-width: 32rem; margin: 1rem 0 0; color: #c8d9e7; font-size: 1rem; line-height: 1.7; }
  .hero-source { color: inherit; text-decoration: underline; text-decoration-color: rgba(var(--accent-rgb), .6); text-underline-offset: 3px; }
  .hero-source:hover { color: var(--accent); }
  .motion-toggle { min-height: 36px; padding: .35rem 0; color: var(--muted); background: transparent; font-size: .78rem; font-weight: 500; }
  .motion-toggle:hover { color: var(--text); transform: none; }
  .motion-toggle[hidden] { display: none; }
  .motion-toggle[aria-pressed="true"] { color: var(--accent); }
  .hero .actions .button { min-height: 50px; padding: .78rem 1.15rem; border-radius: 12px; font-size: .92rem; }
  .hero .actions .button.secondary { background: rgba(7,16,28,.76); border-color: rgba(200,220,237,.22); box-shadow: 0 10px 28px rgba(0,0,0,.18); backdrop-filter: blur(16px); }
  .hero .actions .button.secondary.setlist-button { border-color: rgba(var(--accent-rgb), .68); box-shadow: 0 10px 28px rgba(0,0,0,.18), inset 0 0 0 1px rgba(var(--accent-rgb), .08); }
  .setlist-button :global(.icon) { color: var(--accent); }
  .hero .actions .button.secondary.setlist-button:hover { background: rgba(var(--accent-rgb), .09); border-color: var(--accent); box-shadow: 0 10px 32px rgba(0,0,0,.22), 0 0 22px rgba(var(--accent-rgb), .1); }
  .signal { position: relative; min-height: 340px; padding: 1.6rem; display: flex; flex-direction: column; justify-content: flex-start; min-width: 0; overflow: hidden; }
  .panel-top { position: relative; display: flex; justify-content: space-between; align-items: center; gap: .65rem; margin-bottom: 1.25rem; flex-shrink: 0; color: var(--muted); font: 700 .68rem/1 ui-monospace; text-transform: uppercase; letter-spacing: .12em; }
  .panel-top span { margin-right: auto; }
  .hero + .section-heading { margin-top: 2rem; }
  /* Section headings sit above cards that carry their own titles, so they stay quieter than h2. */
  .latest-events-heading h2, .recent-setlists .section-heading h2 { display: flex; align-items: center; gap: .5rem; font-size: clamp(1.15rem, 1.7vw, 1.4rem); }
  .sync-note { margin: 1.1rem 0 0; color: var(--muted); font-size: .75rem; line-height: 1.6; }
  .subsection-title { margin: 2.25rem 0 1rem; color: #d3dce8; font-size: 1rem; font-weight: 650; letter-spacing: -.01em; }
  .latest-events-heading h2 > :global(.icon), .recent-setlists .section-heading h2 > :global(.icon) { color: var(--accent); font-size: .9em; }
  .latest-events-heading, .recent-setlists .section-heading { align-items: center; }
  .section-link { display: inline-flex; align-items: center; justify-content: flex-end; gap: .3rem; min-height: 44px; padding: .5rem .125rem; border-radius: 6px; color: var(--muted); font-size: .8125rem; font-weight: 400; text-decoration: none; touch-action: manipulation; }
  .section-link:hover, .section-link:focus-visible { color: var(--accent); }
  .event-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; align-items: stretch; }
  .event-grid.count-1 { grid-template-columns: minmax(0, 1fr); }
  .event-grid.count-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* Three cards side by side need the footer line on one level, whatever the title wraps to. */
  .event-grid :global(.event-card) { height: 100%; grid-template-rows: auto 1fr auto; }
  .journey-teaser { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem 1.5rem; margin-top: 4.5rem; padding: 1.35rem 1.5rem; color: inherit; text-decoration: none; transition: border-color .18s, transform .18s, background .18s; }
  .journey-teaser:hover { transform: translateY(-2px); border-color: rgba(var(--accent-rgb), .42); }
  .journey-teaser-text { display: grid; gap: .3rem; min-width: 0; }
  .journey-teaser-label { display: inline-flex; align-items: center; gap: .5rem; font-size: 1.0625rem; font-weight: 650; }
  .journey-teaser-label :global(.icon) { color: var(--accent); }
  .journey-teaser-description { color: var(--muted); font-size: .8125rem; line-height: 1.6; }
  .journey-teaser-cta { display: inline-flex; align-items: center; gap: .3rem; flex: 0 0 auto; color: var(--accent); font-size: .8125rem; }
  .recent-setlists { margin-top: 4.5rem; }
  .recent-setlists .section-heading { margin-top: 0; }
  .recent-setlist-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; }
  .recent-setlist-card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: .7rem;
    min-width: 0;
    min-height: 13.5rem;
    padding: 1.15rem;
    color: inherit;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(10, 22, 39, .76);
    text-decoration: none;
    backdrop-filter: blur(18px);
    transition: border-color .18s, transform .18s, background .18s;
  }
  .recent-setlist-card:hover { transform: translateY(-2px); border-color: rgba(var(--accent-rgb), .42); background: rgba(14, 29, 49, .88); }
  .recent-setlist-top { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .recent-setlist-top time { color: var(--accent); font-size: .73rem; font-weight: 720; }
  .recent-setlist-type { display: inline-flex; align-items: center; gap: .35rem; padding: .27rem .5rem; color: var(--muted); border: 1px solid rgba(159, 180, 211, .17); border-radius: 999px; font-size: .75rem; line-height: 1; }
  .recent-setlist-type:is(.is-solo, .is-festival)::before { content: ""; width: .42rem; height: .42rem; border: 1px solid var(--accent); border-radius: 50%; box-sizing: border-box; }
  .recent-setlist-type.is-solo::before { background: var(--accent); box-shadow: 0 0 8px rgba(var(--accent-rgb), .34); }
  .recent-setlist-card h3 { margin: 0; font-size: 1rem; line-height: 1.42; }
  .recent-setlist-card > p { margin: 0; color: var(--muted); font-size: .8125rem; line-height: 1.55; }
  .recent-setlist-meta { display: flex; align-items: center; gap: .65rem; padding-top: .75rem; color: var(--muted); border-top: 1px solid rgba(159, 180, 211, .12); font-size: .8125rem; }
  .recent-setlist-meta :global(.icon) { margin-left: auto; color: var(--accent); }
  /* Rings are spaced in percent and centred below the card, so the arcs sweep the whole panel
     at any height instead of stopping part way down a tall one. */
  .signal::before { content: ""; position: absolute; inset: 0 -45% -18%; background: repeating-radial-gradient(circle at 50% 100%, transparent 0 calc(6% - 1px), rgba(var(--accent-rgb),.13) 6% calc(6% + 1px)); transform: rotate(-8deg); }
  .signal-countdown { color: var(--accent); font-weight: 700; letter-spacing: .06em; white-space: nowrap; }
  .label-short { display: none; }
  .panel-top i { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 18px var(--accent); }
  .signal > strong, .no-signal strong { color: var(--accent); font-size: clamp(3.7rem, 8vw, 6rem); line-height: 1; letter-spacing: -.08em; position: relative; }
  .signal h2 { font-size: 1.25rem; line-height: 1.45; overflow-wrap: anywhere; margin: 1rem 0 .4rem; position: relative; }
  .signal-update { position: relative; margin: .1rem 0 0; }
  .signal-update .tag.update { color: var(--accent); border-color: rgba(var(--accent-rgb), .5); background: rgba(var(--accent-rgb), .1); }
  .signal-footer { display: flex; align-items: center; gap: .65rem; margin-top: auto; padding-top: .75rem; border-top: 1px solid var(--line); }
  .signal p { flex: 1; min-width: 0; margin: 0; color: var(--muted); position: relative; overflow-wrap: anywhere; }
  .signal a { flex: 0 0 auto; color: var(--muted); opacity: .55; margin: 0; padding: 0; font-size: .85rem; text-decoration: none; }
  .signal:hover a, .signal:focus-within a { color: var(--accent); opacity: 1; }
  .signal:has(a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .signal a:focus-visible { outline: none; }
  .signal a::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .signal a { display: inline-flex; align-items: center; gap: .35rem; }
  @media (min-width: 801px) and (max-width: 1040px) {
    .event-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 800px) {
    /* One column, in source order: headline, next show, then the ways in. */
