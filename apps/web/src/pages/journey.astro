---
import "leaflet/dist/leaflet.css";
import Icon from "../components/Icon.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getEnv } from "../lib/env";
import { getLocale, t } from "../lib/i18n";

const locale = getLocale(Astro.request);
const tileUrl = getEnv().MAP_TILE_URL ?? "https://tile.openstreetmap.org/{z}/{x}/{y}.png";
---
<SiteLayout title={t(locale, "journey.title")} description={t(locale, "journey.description")}>
  <article
    class="journey-shell"
    data-live-journey
    data-locale={locale}
    data-tile-url={tileUrl}
    data-play-label={t(locale, "journey.play")}
    data-pause-label={t(locale, "journey.pause")}
    data-exact-label={t(locale, "journey.exact")}
    data-approximate-label={t(locale, "journey.approximate")}
    data-error-label={t(locale, "journey.error")}
  >
    <header class="journey-head">
      <div>
        <p class="eyebrow">{t(locale, "journey.eyebrow")}</p>
        <h1>{t(locale, "journey.title")}</h1>
        <p class="lede">{t(locale, "journey.description")}</p>
      </div>
      <dl class="journey-stats" aria-label="Journey summary">
        <div><dt>{t(locale, "journey.events")}</dt><dd data-summary-field="events">—</dd></div>
        <div><dt>{t(locale, "journey.venues")}</dt><dd data-summary-field="venues">—</dd></div>
        <div><dt>{t(locale, "journey.countries")}</dt><dd data-summary-field="countries">—</dd></div>
      </dl>
    </header>

    <section class="journey-stage panel">
      <div class="journey-map-wrap">
        <div class="journey-map" data-journey-map role="application" aria-label={t(locale, "journey.mapLabel")}></div>
        <div class="journey-current" aria-live="polite">
          <div class="journey-current-top">
            <time data-current-date>—</time>
            <span data-current-precision data-precision="area">{t(locale, "journey.approximate")}</span>
          </div>
          <a data-current-title href="/archive">—</a>
          <p data-current-venue>—</p>
        </div>
        <div class="journey-map-legend">
          <span><i class="legend-exact"></i>{t(locale, "journey.exact")}</span>
          <span><i class="legend-approximate"></i>{t(locale, "journey.approximate")}</span>
        </div>
      </div>

      <div class="journey-controls">
        <div class="journey-actions">
          <button type="button" data-journey-play aria-pressed="false" disabled><Icon name="globe" /><span>{t(locale, "journey.play")}</span></button>
          <label>{t(locale, "journey.filter")}
            <select data-journey-filter>
              <option value="all">{t(locale, "journey.all")}</option>
              <option value="solo">{t(locale, "journey.solo")}</option>
              <option value="festival">{t(locale, "journey.festival")}</option>
            </select>
          </label>
          <label>{t(locale, "journey.speed")}
            <select data-journey-speed>
              <option value="1400">0.5×</option>
              <option value="850" selected>1×</option>
              <option value="430">2×</option>
            </select>
          </label>
        </div>
        <div class="journey-timeline">
          <div><span data-timeline-start>—</span><output data-journey-progress>—</output><span data-timeline-end>—</span></div>
          <input data-journey-range type="range" min="0" max="0" value="0" disabled aria-label={t(locale, "journey.title")} />
        </div>
      </div>
      <p class="journey-empty" data-journey-empty hidden>{t(locale, "journey.empty")}</p>
    </section>
    <p class="journey-note">{t(locale, "journey.attribution")} <a href="https://www.openstreetmap.org/fixthemap" target="_blank" rel="external noopener noreferrer">Report a map issue</a></p>
  </article>
</SiteLayout>

<script src="../scripts/live-journey.ts"></script>

<style>
  .journey-shell { width: min(1500px, calc(100% - 2rem)); margin: 0 auto; padding: clamp(2rem, 5vw, 4.5rem) 0; }
  .journey-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: end; margin-bottom: 1.5rem; }
  .journey-head h1 { margin: .25rem 0 .65rem; font-size: clamp(2.5rem, 7vw, 6.5rem); line-height: .9; letter-spacing: -.055em; }
  .journey-head .lede { max-width: 720px; color: var(--muted); font-size: clamp(1rem, 1.6vw, 1.25rem); }
  .journey-stats { display: grid; grid-template-columns: repeat(3, minmax(94px, 1fr)); gap: .6rem; margin: 0; }
  .journey-stats div { padding: .9rem 1rem; border: 1px solid var(--line); border-radius: 14px; background: rgba(7,16,28,.72); }
  .journey-stats dt { color: var(--muted); font-size: .7rem; text-transform: uppercase; letter-spacing: .1em; }
  .journey-stats dd { margin: .25rem 0 0; font: 700 1.55rem/1 ui-monospace, monospace; }
  .journey-stage { padding: 0; overflow: hidden; border-radius: 24px; background: #091522; }
  .journey-map-wrap { position: relative; min-height: min(68vh, 760px); }
  .journey-map { position: absolute; inset: 0; min-height: 520px; background: #07101c; }
  .journey-current { position: absolute; z-index: 500; left: 1.1rem; top: 1.1rem; width: min(390px, calc(100% - 2.2rem)); padding: 1rem 1.1rem; border: 1px solid rgba(255,255,255,.16); border-radius: 15px; background: rgba(7,16,28,.88); backdrop-filter: blur(14px); box-shadow: 0 18px 45px rgba(0,0,0,.28); }
  .journey-current-top { display: flex; justify-content: space-between; gap: 1rem; align-items: center; margin-bottom: .55rem; }
  .journey-current time { color: var(--accent); font: 700 .78rem/1 ui-monospace, monospace; letter-spacing: .06em; }
  .journey-current [data-current-precision] { color: #d8e7f2; font-size: .66rem; padding: .25rem .45rem; border: 1px solid rgba(216,231,242,.25); border-radius: 999px; }
  .journey-current [data-current-precision][data-precision="venue"] { color: #ffd4b9; border-color: rgba(234,129,66,.45); }
  .journey-current a { display: block; color: var(--text); font-weight: 700; text-decoration: none; line-height: 1.3; }
  .journey-current a:hover { color: #ffd4b9; }
  .journey-current p { margin: .45rem 0 0; color: var(--muted); font-size: .82rem; }
  .journey-map-legend { position: absolute; z-index: 500; right: 1rem; bottom: 1rem; display: grid; gap: .35rem; padding: .65rem .8rem; border-radius: 11px; background: rgba(7,16,28,.82); color: #d8e7f2; font-size: .68rem; }
  .journey-map-legend span { display: flex; align-items: center; gap: .45rem; }
  .journey-map-legend i { width: 9px; height: 9px; border-radius: 50%; }
  .legend-exact { background: var(--accent); border: 1px solid #ffd4b9; }
  .legend-approximate { background: #07101c; border: 2px dashed #91a9bd; }
  .journey-controls { position: relative; z-index: 600; display: grid; grid-template-columns: auto minmax(240px, 1fr); gap: 1.25rem; align-items: end; padding: 1rem 1.2rem 1.2rem; border-top: 1px solid var(--line); background: rgba(7,16,28,.96); }
  .journey-actions { display: flex; gap: .65rem; align-items: end; }
  .journey-actions button { min-height: 43px; white-space: nowrap; }
  .journey-actions button[data-playing="true"] { background: #d96c2d; }
  .journey-actions label { display: grid; gap: .3rem; color: var(--muted); font-size: .67rem; text-transform: uppercase; letter-spacing: .08em; }
  .journey-actions select { min-width: 130px; padding: .58rem 2rem .58rem .7rem; }
  .journey-timeline > div { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; color: var(--muted); font: .72rem/1 ui-monospace, monospace; }
  .journey-timeline > div span:last-child { text-align: right; }
  .journey-timeline output { color: #e8f5ff; }
  .journey-timeline input { width: 100%; margin-top: .6rem; accent-color: var(--accent); cursor: pointer; }
  .journey-empty { margin: 0; padding: 2rem; text-align: center; color: var(--muted); }
  .journey-note { margin: .8rem .3rem 0; color: var(--muted); font-size: .72rem; }
  .journey-note a { color: inherit; }
  :global(.journey-map .leaflet-tile-pane) { filter: brightness(.55) saturate(.55) hue-rotate(165deg) contrast(1.08); }
  :global(.journey-map .leaflet-control-attribution) { background: rgba(7,16,28,.78); color: #b9cbd8; }
  :global(.journey-map .leaflet-control-attribution a) { color: #ffd4b9; }
  :global(.journey-map .leaflet-bar a) { color: #e8f5ff; background: rgba(7,16,28,.9); border-bottom-color: var(--line); }
  :global(.journey-map .leaflet-popup-content-wrapper), :global(.journey-map .leaflet-popup-tip) { color: #e8f5ff; background: #0d1b2d; }
  :global(.journey-map .leaflet-popup-content a) { color: #ffad79; }
  :global(.journey-active-marker) { border: 0; background: transparent; }
  :global(.journey-active-marker span) { display: grid; place-items: center; width: 34px; height: 34px; color: #fff3e9; font-size: 22px; border-radius: 50%; background: rgba(234,129,66,.82); box-shadow: 0 0 0 6px rgba(234,129,66,.22), 0 0 28px rgba(234,129,66,.8); animation: journey-pulse 1.5s ease-in-out infinite; }
  @keyframes journey-pulse { 50% { transform: scale(1.12); box-shadow: 0 0 0 11px rgba(234,129,66,.08), 0 0 36px rgba(234,129,66,.9); } }
  @media (max-width: 900px) {
    .journey-head { grid-template-columns: 1fr; }
    .journey-stats { width: 100%; }
    .journey-controls { grid-template-columns: 1fr; }
    .journey-actions { display: grid; grid-template-columns: 1fr 1fr; }
    .journey-actions button { grid-column: 1 / -1; }
  }
  @media (max-width: 620px) {
    .journey-shell { width: min(100% - 1rem, 1500px); padding-top: 1.5rem; }
    .journey-head h1 { font-size: clamp(2.6rem, 16vw, 4.5rem); }
    .journey-map-wrap { min-height: 64vh; }
    .journey-map { min-height: 460px; }
    .journey-current { left: .6rem; top: .6rem; width: calc(100% - 1.2rem); }
    .journey-map-legend { right: .6rem; bottom: .6rem; }
    .journey-controls { padding: .85rem; }
    .journey-stats div { padding: .75rem; }
  }
  @media (prefers-reduced-motion: reduce) { :global(.journey-active-marker span) { animation: none; } }
</style>
