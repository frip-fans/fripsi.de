---
import { getSetlistById } from "@frip-fan/core";
import Icon from "../../../components/Icon.astro";
import MusicBackLink from "../../../components/MusicBackLink.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../lib/env";
import {
  formatMusicDate,
  setlistCompletenessLabel,
  setlistConfidenceLabel,
  setlistDisplayTitle,
  setlistEventTypeLabel,
  setlistSectionLabel,
  distinctReleaseTitles,
  shouldShowPerformedVersion,
} from "../../../lib/music";
import { getLocale, t } from "../../../lib/i18n";
import "../../../styles/music.css";

const locale = getLocale(Astro.request);
const setlist = await getSetlistById(getEnv().DB, Astro.params.id!);
if (!setlist) return Astro.redirect("/404", 302);
type SetlistEntry = (typeof setlist.entries)[number];
interface EntryGroup {
  section: SetlistEntry["section"];
  medleyGroup: string | null;
  entries: SetlistEntry[];
}
const entryGroups: EntryGroup[] = [];
for (const entry of setlist.entries) {
  const previous = entryGroups.at(-1);
  if (entry.medley_group && previous?.medleyGroup === entry.medley_group && previous.section === entry.section) {
    previous.entries.push(entry);
  } else {
    entryGroups.push({ section: entry.section, medleyGroup: entry.medley_group, entries: [entry] });
  }
}
const displayTitle = setlistDisplayTitle(setlist);
const showPerformanceLabel = setlist.performance_label !== "本公演" && !displayTitle.includes(setlist.performance_label);
const versionNote = (entry: SetlistEntry) => {
  if (entry.performed_version_title) {
    return shouldShowPerformedVersion(entry.display_title, entry.performed_version_title)
      ? t(locale, "music.version", { title: entry.performed_version_title })
      : null;
  }
  return entry.song_version_count > 1 ? t(locale, "music.versionPending") : null;
};
let previousSection = "";
---
<SiteLayout title={t(locale, "music.setlistPageTitle", { title: displayTitle })} description={t(locale, "music.setlistDescription", { title: setlist.event_title, count: setlist.entry_count })}>
  <div class="music-page" data-music-detail>
    <MusicBackLink href="/music/lives" storageKey="music:list:lives" label={t(locale, "music.backLives")} />
    <header class="music-detail-head" data-page-entry>
      <p class="music-detail-date">
        <time datetime={setlist.start_date}>{formatMusicDate(setlist.start_date, locale)}</time>
        <span class:list={["music-event-type", {
          "is-solo": setlist.event_classification === "专场",
          "is-festival": setlist.event_classification === "拼盘",
        }]}>{setlistEventTypeLabel(setlist.event_classification, locale)}</span>
        {showPerformanceLabel && <span>{setlist.performance_label}</span>}
      </p>
      <h1>{displayTitle}</h1>
      <div class="music-detail-meta">
        <span class="tag">{setlistCompletenessLabel(setlist.completeness, locale)}</span>
        <span class="tag">{setlistConfidenceLabel(setlist.confidence, locale)}</span>
        <span class="tag">{t(locale, "music.recordsCount", { count: setlist.entry_count })}</span>
      </div>
    </header>

    <section class="music-section setlist-overview" data-page-entry>
      <dl class="panel setlist-facts">
        <div><dt>{t(locale, "music.event")}</dt><dd><a href={`/events/${encodeURIComponent(setlist.event_slug)}`}>{setlist.event_title} <Icon name="arrow-up-right" /></a></dd></div>
        <div><dt>{t(locale, "music.location")}</dt><dd>{[setlist.venue, setlist.region].filter(Boolean).join(" · ") || t(locale, "common.locationPending")}</dd></div>
      </dl>
    </section>

    <section class="music-section" aria-labelledby="setlist-heading">
      <div class="music-section-head"><h2 id="setlist-heading">{t(locale, "music.order")}</h2></div>
      {setlist.entries.length ? (
        <div class="setlist-entries">
          {entryGroups.map((group) => {
            const beginsSection = group.section !== previousSection;
            previousSection = group.section;
            const entry = group.entries[0];
            return (
              <>
                {beginsSection && <p class="setlist-section">{setlistSectionLabel(group.section, locale)}</p>}
                {group.medleyGroup ? (
                  <article class="setlist-medley">
                    <header class="setlist-medley-head">
                      <span>{t(locale, "music.medleyLabel", { group: group.medleyGroup })}</span>
                      <small>{t(locale, "music.medleyCount", { count: group.entries.length })}</small>
                    </header>
                    <div class="setlist-medley-tracks">
                      {group.entries.map((medleyEntry) => (
                        <div class="setlist-entry setlist-entry-child">
                          <b>{String(medleyEntry.position).padStart(2, "0")}</b>
                          <div class="setlist-entry-main">
                            <a href={`/music/songs/${encodeURIComponent(medleyEntry.song_slug)}`} translate="no">{medleyEntry.display_title}</a>
                            {versionNote(medleyEntry) && <small>{versionNote(medleyEntry)}</small>}
                            {medleyEntry.notes && <small class="setlist-entry-note">{medleyEntry.notes}</small>}
                          </div>
                          {distinctReleaseTitles(medleyEntry.display_title, medleyEntry.release_titles) && (
                            <span class="setlist-entry-release"><span>{medleyEntry.release_titles}</span></span>
                          )}
                        </div>
                      ))}
                    </div>
                  </article>
                ) : (
                  <article class="setlist-entry">
                    <b>{String(entry.position).padStart(2, "0")}</b>
                    <div class="setlist-entry-main">
                      <a href={`/music/songs/${encodeURIComponent(entry.song_slug)}`} translate="no">{entry.display_title}</a>
                      {versionNote(entry) && <small>{versionNote(entry)}</small>}
                      {entry.notes && <small class="setlist-entry-note">{entry.notes}</small>}
                    </div>
                    {distinctReleaseTitles(entry.display_title, entry.release_titles) && (
                      <span class="setlist-entry-release"><span>{entry.release_titles}</span></span>
                    )}
                  </article>
                )}
              </>
            );
          })}
        </div>
      ) : <div class="music-empty panel">{t(locale, "music.emptySetlist")}</div>}
    </section>

    {(setlist.notes || setlist.sources.length > 0) && (
      <section class="music-section panel">
        {setlist.notes && <p class="muted">{setlist.notes}</p>}
        {setlist.sources.length > 0 && (
          <div class="music-source-list">
            {setlist.sources.map((source, index) => <a href={source.url} target="_blank" rel="noreferrer">{source.label || t(locale, "music.setlistSource", { index: index + 1 })} <Icon name="box-arrow-up-right" /></a>)}
          </div>
        )}
      </section>
    )}
  </div>
</SiteLayout>

<style>
  .setlist-overview { margin-top: 1.5rem; }
  .setlist-overview + .music-section { margin-top: 2rem; }
  .setlist-facts { display: grid; grid-template-columns: 1.25fr 1fr; gap: 1rem; margin: 0; }
  .setlist-facts div { display: grid; min-width: 0; align-content: start; gap: .4rem; }
  .setlist-facts dd { margin: 0; font-weight: 650; line-height: 1.5; overflow-wrap: anywhere; }
  .setlist-facts dt { color: var(--muted); font-size: .75rem; line-height: 1; letter-spacing: .04em; }
  .setlist-facts a { color: var(--text); text-decoration: none; font-weight: 700; }
  .setlist-facts a:hover { color: var(--accent); }
  @media (max-width: 700px) {
    .setlist-facts { grid-template-columns: 1fr; gap: .85rem; }
    .setlist-overview { margin-top: 1.25rem; }
  }
</style>
