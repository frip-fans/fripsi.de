---
import { getAdjacentSetlists, getEventTourContext, getSetlistById, getSetlistHighlights } from "@frip-fan/core";
import Icon from "../../../components/Icon.astro";
import MusicBackLink from "../../../components/MusicBackLink.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../lib/env";
import {
  formatGapYears,
  formatMusicDate,
  setlistCompletenessLabel,
  setlistConfidenceLabel,
  setlistDisplayTitle,
  setlistEventTypeLabel,
  setlistSectionLabel,
  distinctReleaseTitles,
  shouldShowPerformedVersion,
} from "../../../lib/music";
import { getLocale, t } from "../../../lib/i18n";
import "../../../styles/music.css";

const locale = getLocale(Astro.request);
const db = getEnv().DB;
const [setlist, archiveHighlights] = await Promise.all([getSetlistById(db, Astro.params.id!), getSetlistHighlights(db)]);
if (!setlist) return Astro.redirect("/404", 302);
const [adjacent, tour] = await Promise.all([getAdjacentSetlists(db, setlist), getEventTourContext(db, setlist.event_id)]);
const place = [setlist.venue, setlist.region].filter(Boolean).join(" · ") || t(locale, "common.locationPending");
const highlight = archiveHighlights.get(setlist.id);
const debutSongs = new Set(highlight?.debuts.map(item => item.song_id));
const returnGaps = new Map(highlight?.returns.map(item => [item.song_id, item.gap_days]));
type SetlistEntry = (typeof setlist.entries)[number];
interface EntryGroup {
  section: SetlistEntry["section"];
  medleyGroup: string | null;
  entries: SetlistEntry[];
}
const entryGroups: EntryGroup[] = [];
for (const entry of setlist.entries) {
  const previous = entryGroups.at(-1);
  if (entry.medley_group && previous?.medleyGroup === entry.medley_group && previous.section === entry.section) {
    previous.entries.push(entry);
  } else {
    entryGroups.push({ section: entry.section, medleyGroup: entry.medley_group, entries: [entry] });
  }
}
const displayTitle = setlistDisplayTitle(setlist);
const showPerformanceLabel = setlist.performance_label !== "本公演" && !displayTitle.includes(setlist.performance_label);
const versionNote = (entry: SetlistEntry) => {
  if (entry.performed_version_title) {
    return shouldShowPerformedVersion(entry.display_title, entry.performed_version_title)
      ? t(locale, "music.version", { title: entry.performed_version_title })
      : null;
  }
  return entry.song_version_count > 1 ? t(locale, "music.versionPending") : null;
};
let previousSection = "";
---
<SiteLayout title={t(locale, "music.setlistPageTitle", { title: displayTitle })} description={t(locale, "music.setlistDescription", { title: setlist.event_title, count: setlist.entry_count })}>
  <div class="music-page" data-music-detail>
    <MusicBackLink href="/music/lives" storageKey="music:list:lives" label={t(locale, "music.backLives")} />
    <header class="music-detail-head" data-page-entry>
      <p class="music-detail-date">
        <time datetime={setlist.start_date}>{formatMusicDate(setlist.start_date, locale)}</time>
        <span class:list={["music-event-type", {
          "is-solo": setlist.event_classification === "专场",
          "is-festival": setlist.event_classification === "拼盘",
        }]}>{setlistEventTypeLabel(setlist.event_classification, locale)}</span>
        {showPerformanceLabel && <span>{setlist.performance_label}</span>}
      </p>
      <h1>{displayTitle}</h1>
      {setlist.event_title !== displayTitle && <p class="setlist-official">{setlist.event_title}</p>}
      {/* Event facts live on the event page; one line here keeps the page about the songs. */}
      <p class="setlist-where">
        <span>{place}</span>
        <a href={`/events/${encodeURIComponent(setlist.event_slug)}`}>{t(locale, "music.eventDetails")} <Icon name="arrow-up-right" /></a>
        {tour && <a href={`/music/tours/${encodeURIComponent(tour.slug)}`}><Icon name="map" /><span translate="no">{tour.name}</span> · {t(locale, "music.tourStopOf", { number: tour.stop_number, count: tour.stop_count })}</a>}
      </p>
      <div class="music-detail-meta">
        <span class="tag">{setlistCompletenessLabel(setlist.completeness, locale)}</span>
        <span class="tag">{setlistConfidenceLabel(setlist.confidence, locale)}</span>
        <span class="tag">{t(locale, "music.recordsCount", { count: setlist.entry_count })}</span>
      </div>
    </header>

    <section class="music-section setlist-order" aria-labelledby="setlist-heading">
      <div class="music-section-head"><h2 id="setlist-heading">{t(locale, "music.order")}</h2></div>
      {setlist.entries.length ? (
        <div class="setlist-entries">
          {entryGroups.map((group) => {
            const beginsSection = group.section !== previousSection;
            previousSection = group.section;
            const entry = group.entries[0];
            return (
              <>
                {beginsSection && <p class="setlist-section">{setlistSectionLabel(group.section, locale)}</p>}
                {group.medleyGroup ? (
                  <article class="setlist-medley">
                    <header class="setlist-medley-head">
                      <span>{t(locale, "music.medleyLabel", { group: group.medleyGroup })}</span>
                      <small>{t(locale, "music.medleyCount", { count: group.entries.length })}</small>
                    </header>
                    <div class="setlist-medley-tracks">
                      {group.entries.map((medleyEntry) => (
                        <div class="setlist-entry setlist-entry-child">
                          <b>{String(medleyEntry.position).padStart(2, "0")}</b>
                          <div class="setlist-entry-main">
                            <a href={`/music/songs/${encodeURIComponent(medleyEntry.song_slug)}`} translate="no">{medleyEntry.display_title}</a>
                            {debutSongs.has(medleyEntry.song_id) && <span class="setlist-badge is-debut">{t(locale, "music.debutBadge")}</span>}
                            {returnGaps.has(medleyEntry.song_id) && <span class="setlist-badge is-return">{t(locale, "music.highlightGap", { years: formatGapYears(returnGaps.get(medleyEntry.song_id)!, locale) })}</span>}
                            {versionNote(medleyEntry) && <small>{versionNote(medleyEntry)}</small>}
                            {medleyEntry.notes && <small class="setlist-entry-note">{medleyEntry.notes}</small>}
                          </div>
                          {distinctReleaseTitles(medleyEntry.display_title, medleyEntry.release_titles) && (
                            <span class="setlist-entry-release"><span>{medleyEntry.release_titles}</span></span>
                          )}
                        </div>
                      ))}
                    </div>
                  </article>
                ) : (
                  <article class="setlist-entry">
                    <b>{String(entry.position).padStart(2, "0")}</b>
                    <div class="setlist-entry-main">
                      <a href={`/music/songs/${encodeURIComponent(entry.song_slug)}`} translate="no">{entry.display_title}</a>
                            {debutSongs.has(entry.song_id) && <span class="setlist-badge is-debut">{t(locale, "music.debutBadge")}</span>}
                            {returnGaps.has(entry.song_id) && <span class="setlist-badge is-return">{t(locale, "music.highlightGap", { years: formatGapYears(returnGaps.get(entry.song_id)!, locale) })}</span>}
                      {versionNote(entry) && <small>{versionNote(entry)}</small>}
                      {entry.notes && <small class="setlist-entry-note">{entry.notes}</small>}
                    </div>
                    {distinctReleaseTitles(entry.display_title, entry.release_titles) && (
                      <span class="setlist-entry-release"><span>{entry.release_titles}</span></span>
                    )}
                  </article>
                )}
              </>
            );
          })}
        </div>
      ) : <div class="music-empty panel">{t(locale, "music.emptySetlist")}</div>}
    </section>

    {(setlist.notes || setlist.sources.length > 0) && (
      <section class="music-section panel">
        {setlist.notes && <p class="muted">{setlist.notes}</p>}
        {setlist.sources.length > 0 && (
          <div class="music-source-list">
            {setlist.sources.map((source, index) => <a href={source.url} target="_blank" rel="noreferrer">{source.label || t(locale, "music.setlistSource", { index: index + 1 })} <Icon name="box-arrow-up-right" /></a>)}
          </div>
        )}
      </section>
    )}

    {(adjacent.previous || adjacent.next) && (
      <nav class="music-section setlist-pager" aria-label={t(locale, "music.adjacentLives")}>
        {[["previous", adjacent.previous], ["next", adjacent.next]].map(([direction, item]) => {
          const target = item as typeof adjacent.previous;
          return target ? (
            <a class:list={["setlist-pager-link", `is-${direction}`]} href={`/music/lives/${encodeURIComponent(target.id)}`} rel={direction === "previous" ? "prev" : "next"}>
              <span class="setlist-pager-dir">{direction === "previous" && <Icon name="chevron-left" />}{t(locale, direction === "previous" ? "music.previousLive" : "music.nextLive")}{direction === "next" && <Icon name="chevron-right" />}</span>
              <time datetime={target.start_date}>{formatMusicDate(target.start_date, locale)}</time>
              <strong>{setlistDisplayTitle(target)}</strong>
            </a>
          ) : <span aria-hidden="true"></span>;
        })}
      </nav>
    )}
  </div>
</SiteLayout>

<style>
  .setlist-official { margin: .35rem 0 0; color: var(--muted); font-size: .85rem; line-height: 1.55; overflow-wrap: anywhere; }
  .setlist-where { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem 1rem; margin: .75rem 0 0; color: var(--muted); font-size: .9rem; line-height: 1.5; }
  .setlist-where span { overflow-wrap: anywhere; }
  .setlist-where a { display: inline-flex; align-items: center; gap: .3rem; min-height: 44px; color: var(--text); font-weight: 650; text-decoration: none; }
  .setlist-where a:hover { color: var(--accent); }
  .setlist-order { margin-top: 2rem; }
  .setlist-entry-main :global(.setlist-badge) { justify-self: start; padding: .2rem .5rem; border: 1px solid; border-radius: 999px; font-size: .75rem; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .setlist-entry-main :global(.setlist-badge.is-debut) { color: #08111d; background: var(--accent); border-color: var(--accent); }
  .setlist-entry-main :global(.setlist-badge.is-return) { color: var(--accent); border-color: rgba(var(--accent-rgb), .45); background: rgba(var(--accent-rgb), .1); }
  .setlist-pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem; margin-top: 2.5rem; }
  .setlist-pager-link { display: grid; align-content: start; gap: .3rem; min-width: 0; padding: .9rem 1rem; color: inherit; border: 1px solid var(--line); border-radius: 14px; background: var(--music-panel); text-decoration: none; transition: border-color .15s, background-color .15s; }
  .setlist-pager-link.is-next { text-align: right; }
  .setlist-pager-link:hover { border-color: rgba(var(--accent-rgb), .38); background: rgba(14, 29, 49, .88); }
  .setlist-pager-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .setlist-pager-dir { display: inline-flex; align-items: center; gap: .25rem; color: var(--muted); font-size: .75rem; font-weight: 650; }
  .setlist-pager-link.is-next .setlist-pager-dir { justify-content: flex-end; }
  .setlist-pager-link time { color: var(--accent); font-size: .8125rem; font-weight: 650; font-variant-numeric: tabular-nums; }
  .setlist-pager-link strong { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: .9rem; line-height: 1.45; overflow-wrap: anywhere; }
  @media (max-width: 560px) {
    .setlist-pager { grid-template-columns: 1fr; gap: .6rem; }
    .setlist-pager-link.is-next { text-align: left; }
    .setlist-pager-link.is-next .setlist-pager-dir { justify-content: flex-start; }
    .setlist-pager > span { display: none; }
  }
</style>
