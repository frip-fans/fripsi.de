---
import { countPublicSetlistsSince, getSetlistHighlights, getSongBySlug, listSetlistYears } from "@frip-fan/core";
import Icon from "../../../components/Icon.astro";
import MusicBackLink from "../../../components/MusicBackLink.astro";
import MusicListen from "../../../components/MusicListen.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../lib/env";
import { formatGapYears, formatMusicDate, setlistDisplayTitle, versionRelationLabel } from "../../../lib/music";
import { getLocale, t } from "../../../lib/i18n";
import { appearanceSource, pickPlayableAppearance, type ListenSource } from "../../../lib/music-listen";
import { clampPage, HISTORY_PAGE_SIZE, pageTokens } from "../../../lib/page-tokens";
import "../../../styles/music.css";

const locale = getLocale(Astro.request);
const db = getEnv().DB;
const [song, archive, yearTotals] = await Promise.all([getSongBySlug(db, Astro.params.slug!), getSetlistHighlights(db), listSetlistYears(db)]);
if (!song) return Astro.redirect("/404", 302);

// One row per setlist, newest first; a song repeated inside one show (medley reprise) counts once.
const seenSetlists = new Set<string>();
const performances = song.performances.filter((item) => !seenSetlists.has(item.setlist_id) && Boolean(seenSetlists.add(item.setlist_id)));
const first = performances.at(-1);
const last = performances[0];
const since = song.first_release_date ?? first?.start_date ?? null;
const showsSince = since ? await countPublicSetlistsSince(db, since) : 0;
const rate = showsSince ? Math.round((performances.length / showsSince) * 100) : null;

// Yearly chart: grey = public setlists that year, orange = setlists with this song.
const totals = new Map(yearTotals.map((item) => [Number(item.year), item.count]));
const sungByYear = new Map<number, number>();
for (const item of performances) {
  const year = Number(item.start_date.slice(0, 4));
  sungByYear.set(year, (sungByYear.get(year) ?? 0) + 1);
}
const archiveYears = [...totals.keys()];
const archiveStart = Math.min(...archiveYears);
const startYear = Math.max(archiveStart, Number((since ?? "").slice(0, 4)) || archiveStart);
const endYear = Math.max(...archiveYears, ...sungByYear.keys());
const chartYears = performances.length && Number.isFinite(startYear) ? Array.from({ length: endYear - startYear + 1 }, (_, index) => startYear + index) : [];
const maxTotal = Math.max(1, ...chartYears.map((year) => totals.get(year) ?? 0));
// A few years read better as horizontal rows than as a mostly empty column chart.
const compactChart = chartYears.length <= 4;
// Label every fifth year; the first and last years only when they are not crowded by a fifth-year label.
const fifthYears = chartYears.filter((year) => year % 5 === 0);
const anchorYear = (year: number) => year % 5 === 0
  || ((year === chartYears[0] || year === chartYears.at(-1)) && fifthYears.every((mark) => Math.abs(mark - year) >= 3));

// Highlights come from the same archive walk as setlist cards.
const debutSetlists = new Set<string>();
const returnGaps = new Map<string, number>();
for (const [setlistId, item] of archive) {
  if (item.debuts.some((debut) => debut.song_id === song.id)) debutSetlists.add(setlistId);
  const back = item.returns.find((entry) => entry.song_id === song.id);
  if (back) returnGaps.set(setlistId, back.gap_days);
}

// Versions: vocal versions get cards; instrumentals fold into the version they accompany.
const instrumentalParent = new Map<string, string>();
const parentRelation = new Map<string, { type: Parameters<typeof versionRelationLabel>[0]; parentId: string }>();
for (const relation of song.relations) {
  if (relation.relation_type === "instrumental_of") instrumentalParent.set(relation.child_version_id, relation.parent_version_id);
  else if (!parentRelation.has(relation.child_version_id)) parentRelation.set(relation.child_version_id, { type: relation.relation_type, parentId: relation.parent_version_id });
}
const versionName = (versionId: string) => {
  const version = song.versions.find((item) => item.id === versionId);
  if (!version) return "";
  return !version.version_label || version.version_label.trim().toLowerCase() === "original" ? t(locale, "music.originalVersion") : version.version_label;
};
// Editions of one release (e.g. a shop-exclusive pressing) differ only by a trailing parenthetical.
const baseReleaseTitle = (title: string) => title.replace(/\s*[（(][^（）()]*[）)]\s*$/u, "").trim() || title;
const releaseChips = (versionIds: string[]) => {
  const groups = new Map<string, { title: string; slug: string; editions: Set<string> }>();
  for (const appearance of song.releases.filter((item) => versionIds.includes(item.version_id))) {
    const key = baseReleaseTitle(appearance.release_title);
    const group = groups.get(key) ?? { title: key, slug: appearance.release_slug, editions: new Set<string>() };
    group.editions.add(appearance.release_id);
    groups.set(key, group);
  }
  return [...groups.values()];
};
const vocalVersions = song.versions.filter((version) => !instrumentalParent.has(version.id));
const instrumentalsOf = (versionId: string) => song.versions.filter((version) => instrumentalParent.get(version.id) === versionId);
// Which version was sung only matters when the song has more than one vocal version.
const showPerformedVersion = vocalVersions.length > 1;
const isOriginalVersion = (versionId: string) => {
  const label = song.versions.find((item) => item.id === versionId)?.version_label;
  return !label || label.trim().toLowerCase() === "original";
};
// Listen: one playable recording per vocal version, original first.
const listenSources: ListenSource[] = [...vocalVersions]
  .sort((a, b) => Number(!isOriginalVersion(a.id)) - Number(!isOriginalVersion(b.id)))
  .flatMap((version) => {
    const appearance = pickPlayableAppearance(song.releases.filter((item) => item.version_id === version.id));
    if (!appearance) return [];
    const year = version.release_date?.slice(0, 4);
    const name = versionName(version.id);
    return [appearanceSource(version.id, year && !name.includes(year) ? `${name} · ${year}` : name, appearance,
      `${baseReleaseTitle(appearance.release_title)} · Track ${appearance.disc_number > 1 ? `${appearance.disc_number}-` : ""}${appearance.track_number}`)];
  });
// Version filter: each performance maps to the vocal version sung (instrumentals count as their parent) or "unknown".
const UNKNOWN_VERSION = "unknown";
const performedKey = (item: (typeof performances)[number]) => {
  const id = item.performed_version_id;
  if (!id) return UNKNOWN_VERSION;
  return instrumentalParent.get(id) ?? id;
};
const keyCounts = new Map<string, number>();
for (const item of performances) keyCounts.set(performedKey(item), (keyCounts.get(performedKey(item)) ?? 0) + 1);
const knownKeys = vocalVersions.map((version) => version.id).filter((id) => keyCounts.has(id));
// Original first, then the most performed versions; colours follow this order.
knownKeys.sort((a, b) => Number(!isOriginalVersion(a)) - Number(!isOriginalVersion(b)) || (keyCounts.get(b) ?? 0) - (keyCounts.get(a) ?? 0));
const versionKeys = [...knownKeys, ...(keyCounts.has(UNKNOWN_VERSION) ? [UNKNOWN_VERSION] : [])];
const showVersionFilter = showPerformedVersion && versionKeys.length >= 2;
const versionColor = (key: string) => key === UNKNOWN_VERSION ? "var(--song-unknown)" : `var(--song-v${(knownKeys.indexOf(key) % 3) + 1})`;
const versionLabel = (key: string) => key === UNKNOWN_VERSION ? t(locale, "music.versionNotRecorded") : versionName(key);
const versionsByYear = new Map<number, Map<string, number>>();
for (const item of performances) {
  const year = Number(item.start_date.slice(0, 4));
  const counts = versionsByYear.get(year) ?? new Map<string, number>();
  counts.set(performedKey(item), (counts.get(performedKey(item)) ?? 0) + 1);
  versionsByYear.set(year, counts);
}
// Stacked bar segments per year: shares of the year's performances by version (a single accent fill otherwise).
const yearSegments = new Map<number, Array<{ key: string; share: number; color: string }>>();
for (const [year, counts] of versionsByYear) {
  if (!showVersionFilter) { yearSegments.set(year, [{ key: "", share: 100, color: "var(--accent)" }]); continue; }
  const keys = versionKeys.filter((key) => counts.has(key));
  const weight = keys.reduce((sum, key) => sum + (counts.get(key) ?? 0), 0) || 1;
  yearSegments.set(year, keys.map((key) => ({ key, share: ((counts.get(key) ?? 0) / weight) * 100, color: versionColor(key) })));
}
const searchText = (item: (typeof performances)[number]) => `${item.setlist_title ?? ""} ${item.event_title} ${item.performance_label} ${item.venue ?? ""} ${item.region ?? ""}`.toLocaleLowerCase();

// The server applies the URL filter and page too, so a shared link renders the right rows without JS.
const requestedYear = Astro.url.searchParams.get("year") ?? "";
const filterYear = chartYears.some((year) => String(year) === requestedYear && (totals.get(year) ?? 0) > 0) ? requestedYear : "";
const filterQuery = (Astro.url.searchParams.get("q") ?? "").slice(0, 100).trim();
const requestedVersion = Astro.url.searchParams.get("version") ?? "";
const filterVersion = showVersionFilter && versionKeys.includes(requestedVersion) ? requestedVersion : "";
const needle = filterQuery.toLocaleLowerCase();
const matchingIds = new Set(performances.filter((item) => (!filterYear || item.start_date.startsWith(filterYear)) && (!filterVersion || performedKey(item) === filterVersion) && (!needle || searchText(item).includes(needle))).map((item) => item.setlist_id));
const historyPages = Math.max(1, Math.ceil(matchingIds.size / HISTORY_PAGE_SIZE));
const historyPage = clampPage(Number(Astro.url.searchParams.get("page") ?? "1"), historyPages);
const visibleIds = new Set([...matchingIds].slice((historyPage - 1) * HISTORY_PAGE_SIZE, historyPage * HISTORY_PAGE_SIZE));
const pageHref = (page: number) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  if (page <= 1) params.delete("page"); else params.set("page", String(page));
  const query = params.toString();
  return `${Astro.url.pathname}${query ? `?${query}` : ""}#performances-heading`;
};
const historyScope = [filterVersion ? versionLabel(filterVersion) : "", filterYear ? t(locale, "music.historyYear", { year: filterYear }) : "", filterQuery ? `“${filterQuery}”` : ""].filter(Boolean).join(" · ");

const showTitle = (item: { setlist_title?: string | null; event_title: string; performance_label: string }) => setlistDisplayTitle({ title: item.setlist_title ?? null, event_title: item.event_title, performance_label: item.performance_label });
---
<SiteLayout title={song.title} description={t(locale, "music.songDescription", { title: song.title })}>
  <div class="music-page" data-music-detail data-song-detail>
    <MusicBackLink href="/music/songs" storageKey="music:list:songs" label={t(locale, "music.backSongs")} />
    <header class="music-detail-head" data-page-entry>
      <p class="eyebrow" translate="no">{song.original_artist}</p>
      <h1 translate="no">{song.title}</h1>
      {song.aliases.length > 0 && <div class="music-detail-meta">{song.aliases.map((alias) => <span class="tag">{t(locale, "music.alias", { alias })}</span>)}</div>}
    </header>

    {first && last && (
      <dl class="song-stats" data-page-entry>
        <div class="song-stat"><dt>{t(locale, "music.statShows")}</dt><dd><strong>{performances.length}</strong><span>{t(locale, "music.statShowsHint")}</span></dd></div>
        <div class="song-stat"><dt>{t(locale, "music.statFirst")}</dt><dd><strong>{formatMusicDate(first.start_date, locale)}</strong><a href={`/music/lives/${encodeURIComponent(first.setlist_id)}`}>{showTitle(first)}</a></dd></div>
        <div class="song-stat"><dt>{t(locale, "music.statLast")}</dt><dd><strong>{formatMusicDate(last.start_date, locale)}</strong><a href={`/music/lives/${encodeURIComponent(last.setlist_id)}`}>{showTitle(last)}</a></dd></div>
        {rate !== null && <div class="song-stat"><dt>{t(locale, "music.statRate")}</dt><dd><strong>{rate}%</strong><span>{t(locale, "music.statRateHint", { total: showsSince, count: performances.length })}</span></dd></div>}
      </dl>
    )}

    <MusicListen sources={listenSources} autoload />

    {chartYears.length > 0 && (
      <section class="music-section song-yearly" aria-labelledby="yearly-heading">
        <h2 id="yearly-heading">{t(locale, "music.yearlyHeading")}</h2>
        <div class:list={["song-yearly-card", { "is-compact": compactChart }]}>
          <div class="song-legend">
            <span class="is-total">{t(locale, "music.legendShows")}</span>
            {showVersionFilter ? (
              <div class="song-version-filter" role="group" aria-label={t(locale, "music.versionFilter")}>
                {versionKeys.map((key) => (
                  <button type="button" class:list={["song-version-chip", { "is-unknown": key === UNKNOWN_VERSION }]} style={`--chip: ${versionColor(key)}`} aria-pressed={key === filterVersion ? "true" : "false"} data-version-chip={key} data-version-label={versionLabel(key)}>
                    <span class="song-version-swatch" aria-hidden="true"></span><span translate={key === UNKNOWN_VERSION ? undefined : "no"}>{versionLabel(key)}</span><small>{keyCounts.get(key)}</small>
                  </button>
                ))}
              </div>
            ) : <span class="is-sung">{t(locale, "music.legendSung")}</span>}
            <span class="song-legend-hint" data-js-only hidden>{t(locale, showVersionFilter ? "music.legendHint" : "music.legendHintYear")}</span>
          </div>
          <div class="song-chart" style={`--years: ${chartYears.length}`} data-year-chart data-version-selected={filterVersion || undefined}>
            {chartYears.map((year) => {
              const total = totals.get(year) ?? 0;
              const sung = sungByYear.get(year) ?? 0;
              const label = total ? t(locale, "music.yearBar", { year, total, count: sung }) : t(locale, "music.yearNoShows", { year });
              return (
                <button type="button" class:list={["song-bar", { "is-gap": !total }]} style={`--total: ${(total / maxTotal) * 100}%; --sung: ${(sung / maxTotal) * 100}%; --total-ratio: ${total / maxTotal}; --sung-ratio: ${sung / maxTotal}`} aria-pressed="false" aria-label={label} title={label} disabled={!total} data-year-bar={year} data-total={total} data-sung={sung} data-version-counts={JSON.stringify(Object.fromEntries(versionsByYear.get(year) ?? []))}>
                  <span class="song-bar-year" aria-hidden="true">{year}</span>
                  <span class="song-bar-total"></span>
                  {sung > 0 && (
                    <span class="song-bar-sung">
                      {(yearSegments.get(year) ?? []).map((segment) => <span class:list={["song-bar-segment", { "is-unknown": segment.key === UNKNOWN_VERSION, "is-on": Boolean(filterVersion) && segment.key === filterVersion }]} style={`--share: ${segment.share}%; --segment: ${segment.color}`} data-segment={segment.key}></span>)}
                    </span>
                  )}
                  {total > 0 && <span class="song-bar-label" aria-hidden="true"><b data-bar-sung>{filterVersion ? (versionsByYear.get(year)?.get(filterVersion) ?? 0) : sung}</b>/{total}</span>}
                </button>
              );
            })}
          </div>
          <div class="song-axis" style={`--years: ${chartYears.length}`} aria-hidden="true" hidden={compactChart}>
            {chartYears.map((year) => <span class:list={{ "is-anchor": anchorYear(year) }} data-year-label={year}>{year}</span>)}
          </div>
        </div>
      </section>
    )}

    <section class="music-section song-history" aria-labelledby="performances-heading">
      <div class="song-history-head">
        <h2 id="performances-heading">{t(locale, "music.liveHistory")}</h2>
        <span class="song-history-count" aria-live="polite" data-history-count data-template-all={t(locale, "music.historyAll", { count: "{count}" })} data-template-filtered={t(locale, "music.historyFiltered", { scope: "{scope}", count: "{count}" })} data-template-year={t(locale, "music.historyYear", { year: "{year}" })}>{historyScope ? t(locale, "music.historyFiltered", { scope: historyScope, count: matchingIds.size }) : t(locale, "music.historyAll", { count: performances.length })}</span>
        <button type="button" class="song-show-all" data-history-show-all hidden={!historyScope}>{t(locale, "music.showAll")}</button>
      </div>
      {performances.length > 0 ? (
        <>
          <label class="music-search song-history-search" data-js-only hidden>
            <span class="visually-hidden">{t(locale, "music.searchPerformancesLabel")}</span>
            <Icon name="search" />
            <input type="search" placeholder={t(locale, "music.searchPerformances")} value={filterQuery} autocomplete="off" enterkeyhint="search" maxlength="100" data-history-search />
          </label>
          <ol class="song-performances">
            {performances.map((item) => {
              const gap = returnGaps.get(item.setlist_id);
              const version = showPerformedVersion && item.performed_version_id && !instrumentalParent.has(item.performed_version_id) ? item.performed_version_id : null;
              return (
                <li class:list={{ "is-solo": item.event_classification === "专场" }} hidden={!visibleIds.has(item.setlist_id)} data-performance data-year={item.start_date.slice(0, 4)} data-version={performedKey(item)} data-search={searchText(item)}>
                  <time datetime={item.start_date}>{formatMusicDate(item.start_date, locale)}</time>
                  <a href={`/music/lives/${encodeURIComponent(item.setlist_id)}`}>{showTitle(item)}</a>
                  {debutSetlists.has(item.setlist_id) && <span class="setlist-badge is-debut">{t(locale, "music.debutBadge")}</span>}
                  {gap !== undefined && <span class="setlist-badge is-return">{t(locale, "music.highlightGap", { years: formatGapYears(gap, locale) })}</span>}
                  {version && (isOriginalVersion(version) && !showVersionFilter
                    ? <span class="song-performed-version is-original">{t(locale, "music.originalVersion")}</span>
                    : <span class="song-performed-version" style={showVersionFilter ? `--chip: ${versionColor(performedKey(item))}` : undefined} translate="no">{versionLabel(performedKey(item))}</span>)}
                </li>
              );
            })}
            <li class="song-performances-empty" data-history-empty hidden={matchingIds.size > 0}>{t(locale, "music.noMatchingPerformances")}</li>
          </ol>
          <nav class="song-pager" aria-label={t(locale, "pagination.label")} data-history-pager data-label-previous={t(locale, "pagination.previous")} data-label-next={t(locale, "pagination.next")} hidden={historyPages <= 1}>
            {historyPage > 1 ? <a class="song-pager-step" href={pageHref(historyPage - 1)} rel="prev" data-page={historyPage - 1} aria-label={t(locale, "pagination.previous")}>‹</a> : <span class="song-pager-step is-disabled" aria-hidden="true">‹</span>}
            {pageTokens(historyPage, historyPages).map((token) => typeof token === "number"
              ? <a class="song-pager-number" href={pageHref(token)} data-page={token} aria-current={token === historyPage ? "page" : undefined}>{token}</a>
              : <span class="song-pager-gap" aria-hidden="true">…</span>)}
            <span class="song-pager-status" aria-hidden="true">{historyPage} / {historyPages}</span>
            {historyPage < historyPages ? <a class="song-pager-step" href={pageHref(historyPage + 1)} rel="next" data-page={historyPage + 1} aria-label={t(locale, "pagination.next")}>›</a> : <span class="song-pager-step is-disabled" aria-hidden="true">›</span>}
          </nav>
        </>
      ) : <div class="music-empty panel">{t(locale, "music.noSongPerformances")}</div>}
    </section>

    <section class="music-section" aria-labelledby="versions-heading">
      <h2 id="versions-heading" class="song-section-title">{t(locale, "music.versionsAndReleases")}</h2>
      {vocalVersions.length ? (
        <div class="song-versions">
          {vocalVersions.map((version) => {
            const relation = parentRelation.get(version.id);
            const instrumentals = instrumentalsOf(version.id);
            const chips = releaseChips([version.id]);
            const instrumentalChips = releaseChips(instrumentals.map((item) => item.id));
            return (
              <article class="song-version">
                <p class="song-version-top"><span>{versionName(version.id)}</span><time datetime={version.release_date ?? undefined}>{formatMusicDate(version.release_date, locale)}</time></p>
                <h3 translate="no">{version.title}</h3>
                <p class="song-version-relation">{relation ? `${versionRelationLabel(relation.type, locale)} ${versionName(relation.parentId)}` : t(locale, "music.firstRelease")}</p>
                {chips.length > 0 && (
                  <ul class="song-release-chips">
                    {chips.map((chip) => <li><a href={`/music/releases/${encodeURIComponent(chip.slug)}`} title={chip.title} translate="no">{chip.title}</a>{chip.editions.size > 1 && <small>{t(locale, "music.releaseEditions", { count: chip.editions.size })}</small>}</li>)}
                  </ul>
                )}
                {instrumentals.length > 0 && <p class="song-version-instrumental">{t(locale, "music.withInstrumental")}{instrumentalChips.length > 0 && <> · <span translate="no">{instrumentalChips.map((chip) => chip.title).join(" / ")}</span></>}</p>}
              </article>
            );
          })}
        </div>
      ) : <div class="music-empty panel">{t(locale, "music.noVersions")}</div>}
    </section>

    {(song.notes || song.sources.length > 0) && (
      <section class="music-section panel">
        {song.notes && <p class="muted">{song.notes}</p>}
        {song.sources.length > 0 && <div class="music-source-list">{song.sources.map((source, index) => <a href={source.url} target="_blank" rel="noreferrer">{source.label || t(locale, "music.songSource", { index: index + 1 })} <Icon name="box-arrow-up-right" /></a>)}</div>}
      </section>
    )}
  </div>
</SiteLayout>

<script>
  import { setupSongDetail } from "../../../lib/song-detail-client";
  setupSongDetail();
  document.addEventListener("astro:page-load", () => setupSongDetail());
</script>

<style>
  .song-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; margin: 1.75rem 0 0; }
  .song-stat { min-width: 0; padding: .9rem 1rem; border: 1px solid var(--line); border-radius: 14px; background: var(--music-panel); }
  .song-stat dt { color: var(--muted); font-size: .75rem; font-weight: 650; }
  .song-stat dd { display: grid; gap: .3rem; margin: .4rem 0 0; min-width: 0; }
  .song-stat strong { font-size: 1.5rem; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .song-stat span, .song-stat a { overflow: hidden; color: var(--muted); font-size: .75rem; text-overflow: ellipsis; white-space: nowrap; }
  .song-stat a { color: var(--text); text-decoration: underline; text-decoration-color: rgba(159, 180, 211, .35); text-underline-offset: 3px; }
  .song-stat a:hover { color: var(--accent); }
  .song-stat a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .song-yearly, .song-history { margin-top: 2.5rem; }
  .song-yearly h2, .song-section-title { margin: 0 0 .9rem; }
  .song-yearly-card { padding: 1rem 1.1rem .9rem; border: 1px solid var(--line); border-radius: 16px; background: var(--music-panel); }
  .song-legend { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; margin: 0 0 .6rem; color: var(--muted); font-size: .75rem; }
  .song-version-filter { display: flex; flex-wrap: wrap; gap: .4rem; }
  .song-version-chip { display: inline-flex; align-items: center; gap: .45rem; min-height: 36px; padding: .25rem .8rem; color: var(--text); background: rgba(5, 13, 23, .55); border: 1px solid var(--line); border-radius: 999px; font-size: .78rem; font-weight: 650; touch-action: manipulation; }
  .song-version-chip small { color: var(--muted); font-weight: 650; font-variant-numeric: tabular-nums; }
  .song-version-swatch { width: .65rem; height: .65rem; border-radius: 3px; background: var(--chip); }
  .song-version-chip.is-unknown .song-version-swatch { background: repeating-linear-gradient(135deg, rgba(159, 180, 211, .7) 0 2px, rgba(159, 180, 211, .2) 2px 4px); }
  .song-version-chip[aria-pressed="true"] { border-color: var(--chip); background: rgba(255, 255, 255, .07); box-shadow: inset 0 0 0 1px var(--chip); }
  .song-version-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) { .song-version-chip:hover { border-color: var(--chip); } }
  .song-legend .is-total::before, .song-legend .is-sung::before { content: ""; display: inline-block; width: .75rem; height: .6rem; margin-right: .4rem; border-radius: 2px; }
