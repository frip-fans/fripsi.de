---
import { changesSincePreviousStop, getSetlistById, getPublicTourPage, listSongYouTubePreviews, type TourCell, type TourMatrixColumn } from "@frip-fan/core";
import Icon from "../../../components/Icon.astro";
import MusicBackLink from "../../../components/MusicBackLink.astro";
import SpoilerGuard from "../../../components/SpoilerGuard.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../lib/env";
import { getLocale, t } from "../../../lib/i18n";
import { formatMusicDate } from "../../../lib/music";
import { youtubeLinks } from "../../../lib/music-listen";
import "../../../styles/music.css";

const locale = getLocale(Astro.request);
const tour = await getPublicTourPage(getEnv().DB, Astro.params.slug!);
if (!tour || !tour.matrix.columns.length) return Astro.redirect("/404", 302);
const { matrix } = tour;
const openingId = matrix.columns[0]?.setlist_id;
const [openingSetlist, youtubePreviews] = await Promise.all([
  openingId ? getSetlistById(getEnv().DB, openingId) : null,
  listSongYouTubePreviews(getEnv().DB, matrix.rows.map((row) => row.song_id)),
]);
const previousStop = Astro.url.searchParams.get("basis") !== "core";
const basisHref = (basis: string) => {
  const url = new URL(Astro.url);
  url.searchParams.set("basis", basis);
  return url.pathname + url.search;
};

const range = !tour.first_date ? t(locale, "common.datePending")
  : tour.first_date === tour.last_date ? formatMusicDate(tour.first_date, locale)
    : `${formatMusicDate(tour.first_date, locale)} – ${formatMusicDate(tour.last_date, locale)}`;
const shortDate = new Intl.DateTimeFormat(locale, { month: "numeric", day: "numeric", timeZone: "UTC" });
const columnDate = (column: TourMatrixColumn) => shortDate.format(new Date(`${column.start_date}T00:00:00Z`));
// "本公演" and festival slots ("fripSide出演枠") say nothing a column header needs; day / night labels do.
const showLabel = (column: TourMatrixColumn) => column.performance_label && !/^本公演$|出演枠/.test(column.performance_label) ? column.performance_label : null;
const columnHref = (column: TourMatrixColumn) => column.setlist_id ? `/music/lives/${encodeURIComponent(column.setlist_id)}?lang=${locale}` : `/events/${encodeURIComponent(column.event_slug)}`;
const isEncore = (cell: TourCell) => cell.state === "sung" && (cell.section === "encore" || cell.section === "double_encore");
// Heat colour by place in the set: warm near the opener, violet near the end (same ramp as the legend).
const HEAT_STOPS = [[247, 178, 103], [234, 129, 66], [214, 102, 130], [139, 120, 242]];
const heatColor = (position: number, length: number) => {
  const x = Math.min(Math.max(length > 1 ? (position - 1) / (length - 1) : 0, 0), 1) * (HEAT_STOPS.length - 1);
  const i = Math.min(Math.floor(x), HEAT_STOPS.length - 2);
  return `rgb(${HEAT_STOPS[i].map((v, k) => Math.round(v + (HEAT_STOPS[i + 1][k] - v) * (x - i))).join(", ")})`;
};
const changesByColumn = new Map(matrix.changes.map((change) => [change.column_index, change]));
---
<SiteLayout title={t(locale, "music.tourPageTitle", { name: tour.name })} description={t(locale, "music.tourDescription", { name: tour.name, count: matrix.stop_count })}>
  <div class="music-page tour-page">
    <MusicBackLink href="/music/tours" storageKey="music:list:tours" label={t(locale, "music.backTours")} />
    <header class="music-detail-head" data-page-entry>
      <p class="music-detail-date">{range}</p>
      <h1 translate="no">{tour.name}</h1>
      <SpoilerGuard tour={tour.slug} until={tour.last_date} quiet>
      {matrix.stats ? (
        <div class="tour-stats">
          <dl>
            <div class="is-fixed"><dt>{t(locale, "music.tourStatFixed")}</dt><dd>{matrix.stats.fixed}</dd></div>
            <div class="is-rotating"><dt>{t(locale, "music.tourStatRotating")}</dt><dd>{matrix.stats.rotating}</dd></div>
            <div class="is-once"><dt>{t(locale, "music.tourStatOnce")}</dt><dd>{matrix.stats.once}</dd></div>
          </dl>
        </div>
      ) : matrix.setlist_count > 0 && <p class="tour-stats-note">{t(locale, "music.tourStatsUnavailable")}</p>}
      </SpoilerGuard>
    </header>

    {matrix.rows.length > 0 ? (
      <section class="music-section tour-views" data-tour-views data-view={Astro.url.searchParams.has("basis") ? "changes" : "matrix"} aria-label={t(locale, "music.tourViewLabel")}>
      <SpoilerGuard tour={tour.slug} until={tour.last_date}>
        <Fragment slot="summary">
        <div class="view-actions">
            <div class="tour-view-switch" role="group" aria-label={t(locale, "music.tourViewLabel")}>
              <button type="button" data-tour-view-button="matrix"><Icon name="list-stars" />{t(locale, "music.tourViewMatrix")}</button>
              <button type="button" data-tour-view-button="changes"><Icon name="arrow-down-up" />{t(locale, "music.tourViewChanges")}</button>
            </div>
          <button class="legend-toggle secondary" aria-expanded="false" aria-controls="tour-legend">{t(locale, "music.tourLegend")}<Icon name="chevron-down" /></button>
        </div>
        </Fragment>

        <div class="tour-panel tour-matrix-panel">
          <ul class="tour-legend" id="tour-legend" hidden>
            <li><span class="tour-key is-rotating" aria-hidden="true"></span>{t(locale, "music.tourRotatingBadge")}</li>
            <li class="tour-ramp"><span>{t(locale, "music.tourLegendOpener")}</span><i aria-hidden="true"></i><span>{t(locale, "music.tourLegendCloser")}</span></li>
            <li><span class="tour-key is-encore">E</span>{t(locale, "music.tourLegendEncore")}</li>
            <li><span class="tour-key is-absent">·</span>{t(locale, "music.tourLegendAbsent")}</li>
            <li><span class="tour-key is-unknown">?</span>{t(locale, "music.tourLegendUnknown")}</li>
            <li><span class="tour-key is-missing"></span>{t(locale, "music.tourMissingSetlist")}</li>
          </ul>
          <div class="tour-matrix-frame" data-matrix-frame>
          <div class="tour-matrix-scroll" tabindex="0" role="region" aria-label={t(locale, "music.tourViewMatrix")} data-matrix-scroll>
            <table class="tour-matrix">
              <thead>
                <tr>
                  <th scope="col" class="tour-song-col">{t(locale, "music.tourSong")}</th>
                  {matrix.columns.map((column) => (
                    <th scope="col" class:list={["tour-show-col", { "is-missing": !column.setlist_id && !column.upcoming, "is-upcoming": column.upcoming, "is-partial": column.setlist_id && column.completeness !== "complete" }]}>
                      <a href={columnHref(column)}>
                        <span class="tour-show-number">{column.stop_number}</span>
                        <span class="tour-show-stop">{column.stop_label.replace(/公演$/, "")}</span>
                        <time datetime={column.start_date}>{columnDate(column)}</time>
                        {showLabel(column) && <span class="tour-show-label">{showLabel(column)}</span>}
                        {column.upcoming ? <span class="tour-show-flag">{t(locale, "music.tourUpcoming")}</span>
                          : !column.setlist_id ? <span class="tour-show-flag">{t(locale, "music.tourMissingSetlist")}</span>
                          : column.completeness !== "complete" && <span class="tour-show-flag">{t(locale, "music.tourPartialSetlist")}</span>}
                      </a>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {matrix.rows.map((row) => {
                  const songHref = `/music/songs/${encodeURIComponent(row.song_slug)}`;
                  const youtube = youtubeLinks(youtubePreviews.get(row.song_id));
                  const playLabel = t(locale, "music.youtubePlay", { title: row.song_title });
                  return (
                    <tr class:list={[row.kind && `is-${row.kind}`]}>
                      <th scope="row" class="tour-song-col">
                        <span class="tour-song-cell">
                          <a href={songHref} translate="no" title={row.song_title}>{row.song_title}</a>
                          <span class="tour-song-meta">
                            {(row.kind === "rotating" || row.kind === "once") && <span class:list={["tour-badge", `is-${row.kind}`]}>{t(locale, row.kind === "once" ? "music.tourOnceBadge" : "music.tourRotatingBadge")}</span>}
                            <span class:list={["tour-freq-slot", { "has-preview": youtube }]}>
                              <small class="tour-freq">{row.sung_count}/{matrix.setlist_count}</small>
                              {youtube && <a class="tour-freq-play" href={youtube.page} target="_blank" rel="noreferrer"
                                data-track-youtube={youtube.embed} data-track-title={row.song_title} data-track-song={songHref}
                                aria-label={playLabel} title={playLabel}><Icon name="play-fill" /></a>}
                            </span>
                          </span>
                        </span>
                      </th>
                      {row.cells.map((cell, index) => cell.state === "sung" ? (
                        <td class:list={["is-sung", { "is-encore": isEncore(cell) }]} style={`--heat: ${heatColor(cell.position, matrix.columns[index].entry_count)}`}>{isEncore(cell) && <span class="tour-encore">E</span>}{cell.position}</td>
                      ) : cell.state === "absent" ? (
                        <td class="is-absent"><span aria-hidden="true">·</span><span class="visually-hidden">{t(locale, "music.tourLegendAbsent")}</span></td>
                      ) : cell.state === "unknown" ? (
                        <td class="is-unknown"><span aria-hidden="true">?</span><span class="visually-hidden">{t(locale, "music.tourLegendUnknown")}</span></td>
                      ) : cell.state === "upcoming" ? (
                        <td class="is-upcoming"><span class="visually-hidden">{t(locale, "music.tourUpcoming")}</span></td>
                      ) : (
                        <td class="is-missing"><span class="visually-hidden">{t(locale, "music.tourMissingSetlist")}</span></td>
                      ))}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          {/* Desktop arrows for wide tours; each rail spans the table so its button can stick to mid-screen while the page scrolls. */}
          <div class="tour-scroll-rail is-left" aria-hidden="true"><button type="button" tabindex="-1" data-matrix-step="-1" title={t(locale, "music.tourScrollLeft")}><Icon name="chevron-left" /></button></div>
          <div class="tour-scroll-rail is-right" aria-hidden="true"><button type="button" tabindex="-1" data-matrix-step="1" title={t(locale, "music.tourScrollRight")}><Icon name="chevron-right" /></button></div>
          </div>
        </div>

        <div class="tour-panel tour-changes-panel">
          <nav class="compare-basis" aria-label={t(locale, "music.compareBasis")}>
            <span>{t(locale, "music.compareBasis")}</span>
            <a href={basisHref("previous")} aria-current={previousStop ? "true" : undefined}>{t(locale, "music.previousStop")}</a>
            <a href={basisHref("core")} aria-current={!previousStop ? "true" : undefined}>{t(locale, "music.tourBaseline")}</a>
          </nav>
          {!previousStop && <section class="tour-baseline" aria-labelledby="tour-baseline-heading">
            <h2 id="tour-baseline-heading">{t(locale, "music.tourBaseline")}</h2>
            {matrix.baseline.length ? (
              <>
                <p>{t(locale, "music.tourBaselineHint")}</p>
                <ol>
                  {matrix.baseline.map((song) => <li><a href={`/music/songs/${encodeURIComponent(song.song_slug)}`} translate="no">{song.song_title}</a></li>)}
                </ol>
              </>
            ) : <p>{t(locale, matrix.complete_count ? "music.noCoreSongs" : "music.tourBaselineEmpty")}</p>}
          </section>}
          <ol class="tour-stop-list">
            {matrix.columns.map((column, index) => {
              const { reference, change } = previousStop
                ? changesSincePreviousStop(matrix, index)
                : { reference: undefined, change: changesByColumn.get(index) };
              const incomplete = column.completeness !== "complete" || reference?.completeness !== "complete";
              const note = previousStop
                ? !reference ? "music.firstStop" : !reference.setlist_id ? "music.noReference" : incomplete ? "music.partialComparison" : "music.sameSongs"
                : "music.tourNoChanges";
              const partial = column.setlist_id && column.completeness !== "complete";
              return (
                <li class:list={["tour-stop", { "is-missing": !column.setlist_id && !column.upcoming, "is-upcoming": column.upcoming }]}>
                  <a class="tour-stop-head" href={columnHref(column)}>
                    <span class="tour-show-number">{column.stop_number}</span>
                    <span class="tour-stop-title">
                      <strong>{column.stop_label}{showLabel(column) && <span> · {showLabel(column)}</span>}</strong>
                      <time datetime={column.start_date}>{formatMusicDate(column.start_date, locale)}</time>
                    </span>
                    <Icon name="chevron-right" />
                  </a>
                  {column.upcoming ? <p class="tour-stop-note">{t(locale, "music.tourUpcoming")}</p>
                    : !column.setlist_id ? <p class="tour-stop-note">{t(locale, "music.tourMissingSetlist")}</p>
                    : index === 0 && openingSetlist ? (
                      <div class="tour-stop-changes">
                        <details class="change-group opening-setlist" open>
                          <summary>{t(locale, "music.openingSetlist")} <b>{openingSetlist.entries.length}</b><Icon name="chevron-down" /></summary>
                          {partial && <p class="tour-stop-note">{t(locale, "music.tourPartialSetlist")}</p>}
                          {openingSetlist.entries.length ? <ul>{openingSetlist.entries.map(entry => (
                            <li><span class="change-position" style={`--heat: ${heatColor(entry.position, openingSetlist.entries.length)}`}>{entry.position}</span>
                              <a href={`/music/songs/${encodeURIComponent(entry.song_slug)}`} translate="no">{entry.display_title}</a></li>
                          ))}</ul> : <p>{t(locale, "music.emptySetlist")}</p>}
                        </details>
                      </div>
                    ) : previousStop && !reference?.setlist_id ? <p class="tour-stop-note">{t(locale,note)}</p>
                    : !previousStop && !matrix.baseline.length ? <p class="tour-stop-note">{t(locale,matrix.complete_count ? "music.noCoreSongs" : "music.tourBaselineEmpty")}</p>
                    : change && (change.added.length || change.dropped.length) ? (
                      <div class="tour-stop-changes">
                        {change.added.length > 0 && (
                          <details class="change-group is-added" open>
                            <summary>{t(locale, "music.tourAdded")} <b>{change.added.length}</b><Icon name="chevron-down" /></summary>
                            <ul>{change.added.map((song) => <li><span class="change-position" style={`--heat: ${heatColor(song.position, column.entry_count)}`}>{song.position}</span><a href={`/music/songs/${encodeURIComponent(song.song_slug)}`} translate="no">{song.song_title}</a></li>)}</ul>
                          </details>
                        )}
                        {change.dropped.length > 0 && (
                          <details class="change-group is-dropped" open>
                            <summary>{t(locale, "music.tourDropped")} <b>{change.dropped.length}</b><Icon name="chevron-down" /></summary>
                            <ul>{change.dropped.map((song) => <li><a href={`/music/songs/${encodeURIComponent(song.song_slug)}`} translate="no">{song.song_title}</a></li>)}</ul>
                          </details>
                        )}
                        {(previousStop ? incomplete : partial) && <p class="tour-stop-note">{t(locale, previousStop ? "music.partialComparison" : "music.tourPartialNote")}</p>}
                      </div>
                    ) : <p class="tour-stop-note">{partial ? t(locale, previousStop ? "music.partialComparison" : "music.tourPartialNote") : t(locale, note)}</p>}
                </li>
              );
            })}
          </ol>
        </div>
      {/* Behind the cover the tour is still browsable stop by stop, without a single song title. */}
      <ol class="tour-stop-list" slot="safe">
        {matrix.columns.map((column) => (
          <li class:list={["tour-stop", { "is-upcoming": column.upcoming }]}>
            <a class="tour-stop-head" href={columnHref(column)}>
              <span class="tour-show-number">{column.stop_number}</span>
              <span class="tour-stop-title">
                <strong>{column.stop_label}{showLabel(column) && <span> · {showLabel(column)}</span>}</strong>
                <time datetime={column.start_date}>{formatMusicDate(column.start_date, locale)}</time>
              </span>
              <small class="tour-stop-state">{t(locale,column.upcoming ? "music.tourUpcoming" : column.setlist_id ? "spoiler.title" : "music.tourMissingSetlist")}</small><Icon name="chevron-right" />
            </a>
          </li>
        ))}
      </ol>
      </SpoilerGuard>
      </section>
    ) : (
      <section class="music-section">
        <ol class="tour-stop-list">
          {matrix.columns.map((column) => (
            <li class:list={["tour-stop", column.upcoming ? "is-upcoming" : "is-missing"]}>
              <a class="tour-stop-head" href={columnHref(column)}>
                <span class="tour-show-number">{column.stop_number}</span>
                <span class="tour-stop-title"><strong>{column.stop_label}</strong><time datetime={column.start_date}>{formatMusicDate(column.start_date, locale)}</time></span>
                <Icon name="chevron-right" />
              </a>
              <p class="tour-stop-note">{t(locale, column.upcoming ? "music.tourUpcoming" : "music.tourMissingSetlist")}</p>
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</SiteLayout>

<script>
  const VIEW_KEY = "frip_fan_tour_view";

  function setupTourViews() {
    for (const root of document.querySelectorAll<HTMLElement>("[data-tour-views]")) {
      if (root.dataset.ready) continue;
      root.dataset.ready = "true";
      const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-tour-view-button]")];
      const toggle = root.querySelector<HTMLButtonElement>(".legend-toggle");
      const legend = root.querySelector<HTMLElement>(".tour-legend");
      toggle?.addEventListener("click", () => {
        if (!legend) return;
        legend.hidden = !legend.hidden;
        toggle.setAttribute("aria-expanded", String(!legend.hidden));
      });
      if (!buttons.length) continue;
      try {
        const saved = new URL(location.href).searchParams.has("basis") ? "changes" : localStorage.getItem(VIEW_KEY);
        if (saved === "matrix" || saved === "changes") root.dataset.view = saved;
      } catch { /* Storage is optional; the layout picks a view by width. */ }
      const sync = () => {
        const view = root.dataset.view;
        for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset.tourViewButton === view));
      };
      for (const button of buttons) {
        button.addEventListener("click", () => {
          root.dataset.view = button.dataset.tourViewButton!;
          try { localStorage.setItem(VIEW_KEY, root.dataset.view); } catch { /* Storage is optional. */ }
          sync();
        });
      }
      sync();
    }
  }

  /** Left / right buttons for a matrix wider than its box: hidden when it fits, disabled at either end. */
  function setupMatrixScroll() {
    for (const frame of document.querySelectorAll<HTMLElement>("[data-matrix-frame]")) {
      if (frame.dataset.ready) continue;
      frame.dataset.ready = "true";
      const scroller = frame.querySelector<HTMLElement>("[data-matrix-scroll]")!;
      const buttons = [...frame.querySelectorAll<HTMLButtonElement>("[data-matrix-step]")];
      const sync = () => {
        const max = scroller.scrollWidth - scroller.clientWidth;
        frame.toggleAttribute("data-overflowing", max > 1);
        for (const button of buttons) {
          const step = Number(button.dataset.matrixStep);
          button.disabled = step < 0 ? scroller.scrollLeft <= 1 : scroller.scrollLeft >= max - 1;
        }
      };
      for (const button of buttons) {
        button.addEventListener("click", () => {
          // Page by the visible show columns (the sticky song column stays put).
          const songColumn = scroller.querySelector<HTMLElement>(".tour-song-col")?.offsetWidth ?? 0;
          const distance = Math.max(120, (scroller.clientWidth - songColumn) * .8);
          scroller.scrollBy({ left: Number(button.dataset.matrixStep) * distance, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        });
      }
      scroller.addEventListener("scroll", sync, { passive: true });
      new ResizeObserver(sync).observe(scroller);
      sync();
    }
  }

  setupTourViews();
  setupMatrixScroll();
  document.addEventListener("astro:page-load", () => { setupTourViews(); setupMatrixScroll(); });
</script>

<style>
  .tour-stop-state { margin-inline-start: auto; color: var(--muted); font-size: .78rem; }
  .tour-page :global(.spoiler-cover) .tour-stop-list { gap: 0; border: 1px solid var(--line); overflow: hidden; border-radius: 12px; }
  .tour-page :global(.spoiler-cover) .tour-stop { border-radius: 0; }
  .tour-stats dl { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem 1.1rem; margin: 0; }
  .tour-stats dl div { display: inline-flex; align-items: baseline; gap: .38rem; }
  .tour-stats dt, .tour-stats-note { margin: 0; color: var(--muted); font-size: .82rem; }
  .tour-stats dd { margin: 0; font-size: 1rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .tour-views { margin-top: 1.45rem; }
  .tour-views :global(.spoiler-tools), .tour-views > .view-actions {
    display: flex; align-items: center; flex-wrap: wrap; gap: .2rem .75rem;
    margin: 0; padding: .25rem .65rem; border: 1px solid var(--line);
    border-radius: 14px 14px 0 0; background: #101727;
  }
  .view-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .35rem; }
  .tour-view-switch { display: inline-flex; }
  .tour-view-switch button, .legend-toggle {
    min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
    border: 0; border-radius: 0; padding: .45rem .7rem; background: transparent;
    color: var(--muted); font: inherit; font-size: .84rem; font-weight: 600; white-space: nowrap;
  }
  .tour-view-switch button, .compare-basis a { border-radius: 0; border-bottom: 2px solid transparent; }
  .tour-view-switch button[aria-pressed="true"], .compare-basis a[aria-current="true"] {
    color: var(--accent); background: transparent; border-bottom-color: var(--accent);
  }
  .legend-toggle[aria-expanded="true"] { color: var(--accent); }
  .legend-toggle[aria-expanded="true"] :global(.icon) { transform: rotate(180deg); }
  .tour-view-switch button:hover, .legend-toggle:hover { color: var(--text); }
  .tour-view-switch button:focus-visible, .legend-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  [data-view="changes"] .legend-toggle, .tour-legend[hidden] { display: none; }
  .tour-views .tour-legend { margin: 0; padding: .75rem 1rem; background: #111929; }
  .tour-views .tour-matrix-scroll { border-top: 0; border-radius: 0 0 14px 14px; }
  .tour-views :global(.spoiler-tools .spoiler-bar) { margin-inline-start: auto; background: transparent; border: 0; padding: 0; }
  .tour-views :global(.spoiler-tools .view-mark) { width: 21px; height: 21px; border-radius: 5px; }
  .tour-views :global(.spoiler-tools .spoiler-bar span) { gap: .45rem; font-size: .8rem; color: var(--muted); }
  .tour-views :global(.spoiler-tools .spoiler-bar button) { margin: 0; }
  @media (max-width: 620px) {
    .tour-views :global(.spoiler-tools) { padding-inline: .3rem; gap: 0; justify-content: space-between; }
    .tour-views :global(.spoiler-tools .spoiler-bar span) { display: none; }
    .tour-view-switch button, .legend-toggle, .tour-views :global(.spoiler-tools .spoiler-bar button) { padding-inline: .45rem; font-size: .78rem; }
  }
  [data-view="matrix"] .tour-changes-panel, [data-view="changes"] .tour-matrix-panel { display: none; }

  .tour-legend { display: flex; flex-wrap: wrap; gap: .4rem 1rem; margin: 0 0 .8rem; padding: 0; list-style: none; color: var(--muted); font-size: .78rem; }
  .tour-legend li { display: inline-flex; align-items: center; gap: .4rem; }
  .tour-key { display: inline-grid; place-items: center; width: 1.6rem; height: 1.35rem; border-radius: 6px; font-size: .72rem; font-weight: 750; }

  /* Positioned so the visually hidden cell labels are clipped by the scroller instead of widening the page. */
  .tour-matrix-scroll { position: relative; max-width: 100%; overflow-x: auto; overscroll-behavior-x: contain; border: 1px solid var(--line); border-radius: 14px; background: var(--music-panel); }
