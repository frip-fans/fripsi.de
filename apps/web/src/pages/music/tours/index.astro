---
import { dateInTimeZone, listPublicTourStops, listTours } from "@frip-fan/core";
import MusicListState from "../../../components/MusicListState.astro";
import MusicNav from "../../../components/MusicNav.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getEnv } from "../../../lib/env";
import { getLocale, t } from "../../../lib/i18n";
import { formatMusicDate } from "../../../lib/music";
import "../../../styles/music.css";

const locale = getLocale(Astro.request);
const today = dateInTimeZone();
const [allTours, stopsByTour] = await Promise.all([listTours(getEnv().DB, { publicOnly: true }), listPublicTourStops(getEnv().DB, today)]);
const tours = allTours.filter((tour) => tour.stop_count > 0).map((tour) => {
  const stops = stopsByTour.get(tour.id) ?? [];
  // A tour is in progress once it has started and still has a stop today or later.
  const next = stops[0]?.state !== "upcoming" ? stops.find((stop) => stop.state !== "done") : undefined;
  const done = stops.filter((stop) => stop.state === "done").length;
  return { ...tour, stops, next, done };
});
const range = (first: string | null, last: string | null) => !first ? t(locale, "common.datePending")
  : first === last ? formatMusicDate(first, locale) : `${formatMusicDate(first, locale)} – ${formatMusicDate(last, locale)}`;
---
<SiteLayout title={t(locale, "music.nav.tours")}>
  <div class="music-page">
    <MusicListState storageKey="music:list:tours" detailPrefix="/music/tours/" />
    <MusicNav />
    <section class="music-section music-list-section" aria-labelledby="tours-heading">
      <h1 id="tours-heading" class="visually-hidden">{t(locale, "music.nav.tours")}</h1>
      {tours.length ? (
        <div class="music-grid tour-grid" data-page-entry>
          {tours.map((tour) => (
            <a class:list={["music-card", "tour-card", { "is-live": tour.next }]} href={`/music/tours/${encodeURIComponent(tour.slug)}`}>
              <p class="tour-card-date">
                <span>{range(tour.first_date, tour.last_date)}</span>
                {tour.next && (
                  <span class="tour-card-status">
                    {t(locale, tour.next.state === "today" ? "home.tourToday" : tour.next.stop_label ? "music.nextStop" : "home.tourLive")}
                    {tour.next.stop_label && <> · <span translate="no">{tour.next.stop_label.replace(/公演$/, "")}</span></>}
                  </span>
                )}
              </p>
              <h2 translate="no">{tour.name}</h2>
              <div
                class="tour-card-track"
                role={tour.next ? "img" : undefined}
                aria-label={tour.next ? t(locale, "home.tourProgress", { done: tour.done, count: tour.stops.length }) : undefined}
                aria-hidden={tour.next ? undefined : "true"}
              >
                {tour.stops.map((stop) => (
                  <span class:list={["tour-card-dot", {
                    "is-upcoming": stop.state === "upcoming",
                    "is-next": stop === tour.next,
                  }]}></span>
                ))}
              </div>
              <p class="music-card-meta">
                <span>{t(locale, "music.tourStops", { count: tour.stop_count })}</span>
                <span aria-hidden="true">·</span>
                <span>{t(locale, "music.tourSetlistStops", { count: tour.setlist_stop_count })}</span>
              </p>
            </a>
          ))}
        </div>
      ) : <div class="music-empty panel">{t(locale, "music.toursEmpty")}</div>}
    </section>
  </div>
</SiteLayout>

<style>
  .tour-card {
    grid-row: span 4;
    grid-template-rows: subgrid;
  }

  .tour-card.is-live { border-color: rgba(var(--accent-rgb), .3); }
  .tour-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .tour-card-date {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    justify-content: space-between;
    gap: .2rem .75rem;
    color: var(--muted);
    font-size: .8125rem;
    font-variant-numeric: tabular-nums;
  }
  .tour-card-status { color: var(--text); font-weight: 650; overflow-wrap: anywhere; }
  .tour-card h2 { font-size: 1.05rem; }

  .tour-card-track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 1rem;
  }
  .tour-card-track:has(.tour-card-dot + .tour-card-dot)::before {
    content: "";
    position: absolute;
    inset-inline: .25rem;
    height: 1px;
    background: rgba(159, 180, 211, .26);
  }
  .tour-card-dot {
    position: relative;
    width: .5rem;
    height: .5rem;
    border: 1px solid #65738e;
    border-radius: 50%;
    background: #65738e;
  }
  .tour-card-dot:only-child { margin-inline: auto; }
  .tour-card-dot.is-upcoming { background: #192134; }
  .tour-card-dot.is-next {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), .2);
  }

  @media (max-width: 560px) {
    .tour-grid { grid-template-columns: 1fr; }
  }
</style>
