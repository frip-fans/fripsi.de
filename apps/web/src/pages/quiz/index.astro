---
import { getOrCreatePuzzle, getPlayerProgress, getPuzzleStats, type QuizQuestion } from "@frip-fan/core";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getEnv } from "../../lib/env";
import { getLocale, t } from "../../lib/i18n";
import { puzzleDate, readPlayerId } from "../../lib/quiz-player";
import "../../styles/quiz.css";

const locale = getLocale(Astro.request);
const date = puzzleDate();
const db = getEnv().DB;

const puzzle = await getOrCreatePuzzle(db, date);
const playerId = readPlayerId(Astro.request.headers.get("cookie") ?? "");
const total = puzzle.questions.length;
const progress = playerId
  ? await getPlayerProgress(db, date, playerId, total)
  : { choices: Array.from({ length: total }, () => null), score: 0, answered: 0 };
const stats = await getPuzzleStats(db, date);

function prompt(question: QuizQuestion): string {
  if (question.type === "more_performed") return t(locale, "quiz.questionMorePerformed");
  const values = { date: question.event.date, event: question.event.title };
  return question.type === "performed"
    ? t(locale, "quiz.questionPerformed", { ...values, song: question.song.title })
    : t(locale, "quiz.questionEncore", values);
}

function options(question: QuizQuestion): string[] {
  return question.type === "performed"
    ? [t(locale, "quiz.yes"), t(locale, "quiz.no")]
    : question.options.map((option) => option.title);
}

/**
 * The payload carries the answer only for questions this browser already committed to,
 * so the page cannot be read ahead for today's solutions.
 */
const payload = {
  date,
  total,
  score: progress.score,
  questions: puzzle.questions.map((question, index) => {
    const choice = progress.choices[index];
    const base = {
      prompt: prompt(question),
      options: options(question),
      eventHref: question.type === "more_performed" ? null : `/events/${encodeURIComponent(question.event.slug)}`,
      songTitles: question.type === "more_performed" ? question.options.map((option) => option.title) : null,
    };
    if (choice === null) return base;
    return {
      ...base,
      choice,
      answer: question.answer,
      counts: question.type === "more_performed" ? question.counts : null,
      stats: stats.get(index) ?? { answered: 0, correct: 0 },
    };
  }),
};
---

<SiteLayout title={t(locale, "quiz.title")} description={t(locale, "quiz.description")}>
  <article class="quiz-page">
    <header class="quiz-intro">
      <p class="quiz-eyebrow">{t(locale, "quiz.todayLabel")} · {date}</p>
      <h1>{t(locale, "quiz.title")}</h1>
      <p>{t(locale, "quiz.description")}</p>
      <p class="quiz-data-note">{t(locale, "quiz.dataNote")}</p>
    </header>

    {total === 0 ? (
      <p class="quiz-empty">{t(locale, "quiz.empty")}</p>
    ) : (
      <section
        class="quiz-stage"
        data-quiz
        data-labels={JSON.stringify({
          progress: t(locale, "quiz.progress"),
          correct: t(locale, "quiz.correct"),
          wrong: t(locale, "quiz.wrong"),
          globalRate: t(locale, "quiz.globalRate"),
          firstAnswer: t(locale, "quiz.firstAnswer"),
          countsHint: t(locale, "quiz.countsHint"),
          next: t(locale, "quiz.next"),
          finishTitle: t(locale, "quiz.finishTitle"),
          share: t(locale, "quiz.share"),
          shared: t(locale, "quiz.shared"),
          comeBack: t(locale, "quiz.comeBack"),
          viewShow: t(locale, "quiz.viewShow"),
          done: t(locale, "quiz.done"),
          failed: t(locale, "quiz.failed"),
          title: t(locale, "quiz.title"),
        })}
      >
        <p class="quiz-progress" data-quiz-progress aria-live="polite"></p>
        <div class="quiz-card">
          <h2 class="quiz-prompt" data-quiz-prompt></h2>
          <div class="quiz-options" data-quiz-options role="group"></div>
          <div class="quiz-feedback" data-quiz-feedback role="status" aria-live="polite" hidden></div>
          <div class="quiz-actions">
            <a class="quiz-show-link" data-quiz-show-link href="#" hidden></a>
            <button class="quiz-next" type="button" data-quiz-next hidden></button>
          </div>
        </div>
        <section class="quiz-finish" data-quiz-finish hidden>
          <h2 data-quiz-finish-title></h2>
          <p class="quiz-score" data-quiz-score></p>
          <p class="quiz-marks" data-quiz-marks></p>
          <p class="quiz-comeback" data-quiz-comeback></p>
          <button class="quiz-share" type="button" data-quiz-share></button>
        </section>
        <script is:inline type="application/json" data-quiz-payload set:html={JSON.stringify(payload)}></script>
      </section>
    )}
  </article>
</SiteLayout>

<script>
  import { setupQuiz } from "../../lib/quiz-client";
  setupQuiz();
  document.addEventListener("astro:page-load", () => setupQuiz());
</script>
