---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getLocale, t } from "../../lib/i18n";
import { ASSET_BASE, getPosterPath } from "../../scripts/yaginuma-intensity-calibrator/video-renderer";
import "../../scripts/yaginuma-intensity-calibrator/styles.css";

const locale = getLocale(Astro.request);
const posterSrc = getPosterPath(0, ASSET_BASE);
---
<SiteLayout title={t(locale, "yaginuma.title")} description={t(locale, "yaginuma.description")}>
  <div id="yaginuma-app" data-asset-base={ASSET_BASE}>
    <img class="ssr-poster" src={posterSrc} alt="" aria-hidden="true" width="550" height="550" />
  </div>
</SiteLayout>

<style is:global>
  body:has(#yaginuma-app) .background-rotator,
  body:has(#yaginuma-app) .ambient {
    display: none;
  }

  body:has(#yaginuma-app) main {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    min-height: 0;
  }
</style>

<script>
  import { mountApp } from "../../scripts/yaginuma-intensity-calibrator/app";
  import { ASSET_BASE, createVideoRenderer } from "../../scripts/yaginuma-intensity-calibrator/video-renderer";

  function boot(): void {
    const root = document.querySelector<HTMLElement>("#yaginuma-app");
    if (!root || root.dataset.booted === "true") return;
    root.dataset.booted = "true";

    const assetBase = root.dataset.assetBase || ASSET_BASE;
    const existingPoster = root.querySelector<HTMLImageElement>(":scope > .ssr-poster") ?? undefined;
    const poster = existingPoster ?? document.createElement("img");
    if (!existingPoster) {
      poster.className = "ssr-poster";
      poster.alt = "";
      poster.setAttribute("aria-hidden", "true");
    }

    let renderScore = (_score: number): void => undefined;
    const controller = mountApp(root, (score) => renderScore(score), poster);
    const renderer = createVideoRenderer(controller.canvas, assetBase);
    renderScore = (score) => renderer.render(score);

    void (async () => {
      try {
        const initialScore = controller.score;
        await renderer.drawPoster(poster, initialScore);
        poster.remove();
        controller.setFirstFrameReady();
        renderer.render(initialScore);
        await renderer.loadVideo();
        controller.setReady();
      } catch {
        controller.setError("连续画面加载失败，请刷新重试");
      }
    })();
  }

  boot();
  document.addEventListener("astro:page-load", boot);
</script>
