{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "frip-fan-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frip-fan-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://fripsi.de",
    "MAP_TILE_URL": "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "name": "frip-fan-web",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "fripsi.de",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "frip-fan-prod",
          "database_id": "f35ee3c1-3f65-44ed-988b-e6cbf2c187f6",
          "migrations_dir": "../../migrations"
        }
      ],
      "vars": {
        "SITE_URL": "https://fripsi.de",
        "MAP_TILE_URL": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        "ACCESS_TEAM_DOMAIN": "rklee.cloudflareaccess.com",
        "ACCESS_AUD": "38ea414c004a9c76d1835d12a76f9cd76e1ca4b0ae7a1fca7743921f2ecaaf40"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "frip-fan-media-prod"
        }
      ]
    },
    "staging": {
      "name": "frip-fan-web-staging",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "frip-fan-staging",
          "database_id": "32c5a88c-bbd1-4bda-9814-b8cce16fc7c4",
          "migrations_dir": "../../migrations"
        }
      ],
      "vars": {
        "SITE_URL": "https://frip-fan-web-staging.rklee.workers.dev",
        "MAP_TILE_URL": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        "APP_ENV": "staging",
        "ACCESS_TEAM_DOMAIN": "rklee.cloudflareaccess.com",
        "ADMIN_PUBLISHERS": "rickylee1999@gmail.com",
        "DEV_AUTH_BYPASS": "false",
        "ACCESS_AUD": "099052d15ac06bb98dc1e666a4ff5174c3aeb10ad3601384fa0da3a725d76b08"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "frip-fan-media-staging"
        }
      ]
    }
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "frip-fan-media-dev"
    }
  ]
}
