[Unit]
Description=fripsi.de Node application and MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frip-app
Group=fripside
WorkingDirectory=/opt/fripside/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=FRIP_DATA_DIR=/var/lib/fripside
Environment=FRIP_DB_PATH=/var/lib/fripside/site.sqlite
Environment=FRIP_MEDIA_DIR=/var/lib/fripside/media
EnvironmentFile=/etc/fripside/web.env
ExecStart=/usr/local/bin/fripside-start-web
Restart=on-failure
RestartSec=3
UMask=0077
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fripside
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=512M
TasksMax=128
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
