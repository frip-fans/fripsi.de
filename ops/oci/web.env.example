MCP_ENDPOINT_URL=https://mcp-staging.fripsi.de/mcp
CHAT_ENABLED=false
# OPENAI_API_KEY is configured on the host only.
# Optional: Cloudflare Turnstile for the comment form. Both keys are required to turn it on.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY is configured on the host only.
# Optional: dedicated key for hashing comment sources; defaults to AUTOMATION_SIGNING_SECRET.
# COMMENT_SOURCE_SECRET is configured on the host only.
