APP_ENV=staging
SITE_URL=https://staging.fripsi.de
ACCESS_TEAM_DOMAIN=rklee.cloudflareaccess.com
ACCESS_AUD=REPLACE_WITH_HOSTNAME_ACCESS_APP_AUD
ADMIN_PUBLISHERS=rickylee1999@gmail.com
DEV_AUTH_BYPASS=false
MCP_RESOURCE_URL=https://mcp-staging.fripsi.de
MCP_AUTHORIZATION_SERVER=https://rklee.cloudflareaccess.com
MCP_AUDIENCE=REPLACE_WITH_MCP_ACCESS_AUD
AUTOMATION_AUDIENCE=https://mcp-staging.fripsi.de/mcp
