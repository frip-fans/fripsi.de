{
  "name": "frip-fan",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @frip-fan/web",
    "dev:mcp": "npm run dev --workspace @frip-fan/mcp",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @frip-fan/web",
    "build:mcp": "npm run build --workspace @frip-fan/mcp",
    "typecheck": "npm run typecheck:workspaces && npm run typecheck:scripts",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run && npm run test:release-covers",
    "test:watch": "vitest",
    "visual:check": "node scripts/visual-check.mjs",
    "deploy:web": "npm run deploy --workspace @frip-fan/web",
    "deploy:mcp": "npm run deploy --workspace @frip-fan/mcp",
    "db:migrate:local": "XDG_CONFIG_HOME=.cache/xdg wrangler d1 migrations apply frip-fan-dev --local --config apps/web/wrangler.jsonc",
    "db:seed:local": "XDG_CONFIG_HOME=.cache/xdg wrangler d1 execute frip-fan-dev --local --config apps/web/wrangler.jsonc --file scripts/seed.sql",
    "import:notion": "tsx scripts/import-notion-export.ts",
    "import:sql": "tsx scripts/build-import-sql.ts",
    "import:music": "tsx scripts/import-music-library.ts",
    "scrape:discography": "node scripts/scrape-official-discography.mjs",
    "build:complete-discography": "node scripts/build-complete-discography-import.mjs",
    "build:phase3-albums": "node scripts/build-phase3-album-import.mjs",
    "build:liberation-setlists": "node scripts/build-liberation-protocol-setlists.mjs",
    "build:anisama-setlists": "node scripts/build-anisama-setlists.mjs",
    "build:asia-festival-setlists": "node scripts/build-asia-festival-setlists.mjs",
    "build:dawn-final-setlist": "node scripts/build-dawn-of-resonance-final-setlist.mjs",
    "geocode:journey": "node scripts/geocode-live-journey.mjs",
    "scrape:phase3-setlists": "node scripts/scrape-livefans-fripside-setlists.mjs",
    "build:phase3-setlists": "node scripts/build-phase3-livefans-setlists.mjs",
    "scrape:phase2-archive": "node scripts/scrape-livefans-phase2-archive.mjs",
    "scrape:phase2-early-archive": "node scripts/scrape-livefans-phase2-archive.mjs 2014-01-01 2018-12-31 data/research/livefans-fripside-phase2-early-archive.json",
    "build:phase2-archive": "node scripts/build-phase2-archive-import.mjs",
    "build:phase2-early-archive": "node scripts/build-phase2-archive-import.mjs --early",
    "build:web:staging": "npm run build:staging --workspace @frip-fan/web",
    "deploy:web:staging": "npm run deploy:staging --workspace @frip-fan/web",
    "test:release-covers": "node --test scripts/release-cover-import.test.mjs",
    "scrape:release-covers": "node scripts/scrape-release-covers.mjs",
    "build:release-covers": "node scripts/build-release-cover-import.mjs",
    "import:release-covers:r2": "tsx scripts/import-release-covers-r2.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260718.1",
    "@types/node": "^24.13.3",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.128.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.0.12"
    },
    "fast-uri": "3.1.6",
    "sharp": "0.35.0"
  },
  "engines": {
    "node": ">=24"
  }
}
